#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# wmb: the one entry point, used the same way locally and in CI.
#
#   ./wmb toolchain <id> [--archive]     assemble toolchain <id> at /opt/wmb/toolchains/<id>
#   ./wmb build <flavour> <version>      compile, package, smoke, regress, manifest, check,
#                                        archive -> out/
#   ./wmb quick <flavour> <version>      a quick test build: reuses the last source tree
#                                        and compiles only what changed; no debug
#                                        symbols, and only the changed modules' tests;
#                                        then the OpenGL tests (WMB_HOST_GL=0 skips)
#   ./wmb host quick|build <flavour> <version>
#                                        quick or build on this Mac, run in the user's
#                                        GUI session (build/host.sh)
#   ./wmb regress --tree <release dir>   run the regression tests on an unpacked release
#   ./wmb hostgl <build .tar.xz>         run the OpenGL tests on this Mac (vm.sh does this
#                                        after a build, as VMs have no accelerated OpenGL)
#   ./wmb vm <command...>                run any of the above in a fresh Tart VM
#                                        from the toolchain's pinned image (quick:
#                                        in a VM kept for quick builds)
#
# `build` runs on this Mac, using whatever macOS and Xcode it has; the
# manifest records them. `vm` is how releases are made: the pinned image
# gives the same macOS and Xcode every time.

set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"

cmd="${1:-}"; shift || true
case "$cmd" in
    toolchain)
        exec "$ROOT/build/toolchain.sh" "$@" ;;
    build)
        [[ $# -eq 2 ]] || { echo "usage: wmb build <flavour> <version>" >&2; exit 2; }
        "$ROOT/build/compile.sh" "$@"
        "$ROOT/build/package.sh" "$@"
        "$ROOT/build/smoke.sh" "$@"
        "$ROOT/build/regress.sh" "$@"
        "$ROOT/build/manifest.sh" "$@"
        "$ROOT/build/check.sh" "$@"
        "$ROOT/build/archive.sh" "$@" ;;
    quick)
        [[ $# -eq 2 ]] || { echo "usage: wmb quick <flavour> <version>" >&2; exit 2; }
        WMB_QUICK="${WMB_QUICK:-$(date -u +%Y%m%dT%H%M%S)}"
        export WMB_QUICK
        "$ROOT/build/compile.sh" "$@"
        "$ROOT/build/package.sh" "$@"
        "$ROOT/build/smoke.sh" "$@"
        "$ROOT/build/manifest.sh" "$@"
        "$ROOT/build/check.sh" "$@"
        "$ROOT/build/archive.sh" "$@"
        # On a Mac (not in a build VM, where vm.sh runs them afterwards on
        # the host), the OpenGL tests run straight away. WMB_HOST_GL=0 skips.
        if [[ ${WMB_LANE:-} != tart && ${WMB_HOST_GL:-1} == 1 ]]; then
            "$ROOT/build/hostgl.sh" "${WMB_OUT_DIR:-$ROOT/out}/wine-$( [[ $1 == wine ]] || echo "$1-")$2-quick$WMB_QUICK-macos-x86_64.tar.xz"
        fi ;;
    host)
        exec "$ROOT/build/host.sh" "$@" ;;
    compile|package|smoke|regress|manifest|check|archive|hostgl)
        exec "$ROOT/build/$cmd.sh" "$@" ;;
    vm)
        exec "$ROOT/build/vm.sh" "$@" ;;
    *)
        sed -n '4,20p' "$0" | sed 's/^# \{0,1\}//' >&2
        exit 2 ;;
esac
