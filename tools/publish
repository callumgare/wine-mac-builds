#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# tools/publish <build ID>     e.g. tools/publish wine-11.21-build1-macos-x86_64
#
# Publishes a build's draft release. The build workflow can't point a draft
# at the commit it built (GITHUB_TOKEN may not tag a commit whose workflow
# files differ from main's), so this does, with your own login: it reads
# the commit from the build's build-info.json, checks the draft's files
# against its SHA256SUMS, sets the target and publishes. Once published,
# a release is permanent (plan.md, "Never-delete enforcement").
#
# Uses the gh CLI's login; GH_TOKEN can choose an account.

set -euo pipefail
die() { echo "publish: $*" >&2; exit 1; }
[[ $# -eq 1 ]] || die "usage: tools/publish <build ID>"
TAG="$1"
REPO="${GH_REPO:-callumgare/wine-mac-builds}"

[[ "$(gh release view "$TAG" -R "$REPO" --json isDraft --jq .isDraft)" == true ]] ||
    die "$TAG isn't a draft (already published?)"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
gh release download "$TAG" -R "$REPO" -D "$TMP" -p "$TAG.build-info.json" -p "$TAG.SHA256SUMS"
COMMIT="$(/usr/bin/python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["recipe"]["commit"])' "$TMP/$TAG.build-info.json")"
[[ "$COMMIT" =~ ^[0-9a-f]{40}$ ]] || die "no recipe commit in $TAG.build-info.json"
gh api "repos/$REPO/commits/$COMMIT" --jq .sha >/dev/null || die "commit $COMMIT isn't in $REPO"

# Every asset's GitHub digest must match SHA256SUMS (the files people get).
gh release view "$TAG" -R "$REPO" --json assets --jq '.assets[] | "\(.digest // "") \(.name)"' > "$TMP/digests"
while read -r sha name; do
    [[ "$name" == "$TAG.SHA256SUMS" ]] && continue
    want="$(awk -v n="$name" '$2 == n || $2 == "*" n { print $1 }' "$TMP/$TAG.SHA256SUMS")"
    [[ -n "$want" ]] || die "$name isn't in SHA256SUMS"
    [[ "$sha" == "sha256:$want" ]] || die "$name: GitHub has $sha, SHA256SUMS says $want"
done < "$TMP/digests"

echo "Publishing $TAG at $COMMIT"
gh release edit "$TAG" -R "$REPO" --target "$COMMIT" --draft=false
gh release view "$TAG" -R "$REPO" --json tagName,isDraft,url --jq '"\(.tagName) draft=\(.isDraft) \(.url)"'
