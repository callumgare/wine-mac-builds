#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# tools/pin <flavour> <version> [--toolchain <id>]
#
# Adds a Wine version to a flavour:
#
# - Writes inputs/<base>/<version>.sh (the flavour's PATCH_BASE), unless
#   another flavour pinned it already: the exact files a build of that
#   version uses, each pinned by sha256. It downloads WineHQ's tarball and
#   its .sign, and checks the signature against the keys in keys/ (builds
#   then only need shasum, not GnuPG), and reads the Gecko and Mono versions
#   from dlls/appwiz.cpl/addons.c and pins their tarballs. Then every patch
#   copy is renamed so it covers exactly the versions it did
#   (tools/patch renumber-versions).
# - Adds the version to VERSIONS in flavours/<flavour>.sh.
# - Carries the flavour's patches over from its previous version: each copy
#   that applies to the new source without fuzz, in order, gets the version
#   added to its file name (tools/patch extend). The rest are listed, to
#   port by hand. Review the result before building.
#
# Needs gpg, curl and shasum.

set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
die() { echo "pin: $*" >&2; exit 1; }

[[ $# -ge 2 ]] || die "usage: tools/pin <flavour> <version> [--toolchain <id>]"
FLAVOUR="$1"; VERSION="$2"; shift 2
# Default: the newest published toolchain (one with its archive pinned).
TOOLCHAIN="$(grep -l '^TOOLCHAIN_ARCHIVE_SHA256="[0-9a-f]' "$ROOT"/toolchains/*.sh | sed 's|.*/||; s/\.sh$//' | sort | tail -1)"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --toolchain) TOOLCHAIN="$2"; shift 2 ;;
        *) die "unknown option $1" ;;
    esac
done
F="$ROOT/flavours/$FLAVOUR.sh"
[[ -f "$F" ]] || die "unknown flavour '$FLAVOUR' (no $F)"
BASE="$(WMB_ROOT="$ROOT" bash -c 'source "$1"; echo "$PATCH_BASE"' pin "$F")"
[[ -n "$BASE" ]] || die "$F sets no PATCH_BASE"
# shellcheck disable=SC2016
if WMB_ROOT="$ROOT" bash -c 'source "$1"; for v in "${VERSIONS[@]}"; do [[ $v == "$2" ]] && exit 0; done; exit 1' pin "$F" "$VERSION"; then
    die "$FLAVOUR already lists $VERSION"
fi
OUT="$ROOT/inputs/$BASE/$VERSION.sh"

TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT

if [[ -e "$OUT" ]]; then
    echo "pin: $OUT exists (pinned for another flavour); using it"
    # shellcheck source=/dev/null
    URL="$(source "$OUT"; echo "$WINE_URL")"; SHA="$(source "$OUT"; echo "$WINE_SHA256")"
    curl -fsSL -o "$TMP/src.tar.xz" "$URL"
    [[ "$(shasum -a 256 "$TMP/src.tar.xz" | cut -d' ' -f1)" == "$SHA" ]] || die "$URL doesn't match $OUT's sha256"
else
MAJOR="${VERSION%%.*}"
# A stable release, its release candidates and its point releases (10.0,
# 10.0-rc1, 10.0.1) live in their own folder; development releases in N.x.
case "$VERSION" in
    *.0|*.0-rc*|*.0.*) DIR="$MAJOR.0" ;;
    *) DIR="$MAJOR.x" ;;
esac
URL="https://dl.winehq.org/wine/source/$DIR/wine-$VERSION.tar.xz"
curl -fsSL -o "$TMP/src.tar.xz" "$URL"
curl -fsSL -o "$TMP/src.tar.xz.sign" "$URL.sign"

export GNUPGHOME="$TMP/gnupg"; mkdir -m 700 "$GNUPGHOME"
gpg --quiet --import "$ROOT"/keys/*.asc 2>/dev/null
STATUS="$(gpg --status-fd 1 --verify "$TMP/src.tar.xz.sign" "$TMP/src.tar.xz" 2>/dev/null || true)"
KEY="$(sed -n 's/^\[GNUPG:\] VALIDSIG \([0-9A-F]*\) .*/\1/p' <<<"$STATUS" | head -1)"
SIGTIME="$(sed -n 's/^\[GNUPG:\] VALIDSIG [0-9A-F]* [0-9-]* \([0-9]*\) .*/\1/p' <<<"$STATUS" | head -1)"
[[ -n "$KEY" ]] || die "signature check failed for $URL"
SHA="$(shasum -a 256 "$TMP/src.tar.xz" | cut -d' ' -f1)"

tar -xJf "$TMP/src.tar.xz" -C "$TMP" "wine-$VERSION/dlls/appwiz.cpl/addons.c"
ADDONS="$TMP/wine-$VERSION/dlls/appwiz.cpl/addons.c"
GECKO="$(sed -n 's/^#define GECKO_VERSION "\(.*\)"/\1/p' "$ADDONS")"
MONO="$(sed -n 's/^#define MONO_VERSION "\(.*\)"/\1/p' "$ADDONS")"

hash_url() { curl -fsSL "$1" | shasum -a 256 | cut -d' ' -f1; }
G86="https://dl.winehq.org/wine/wine-gecko/$GECKO/wine-gecko-$GECKO-x86.tar.xz"
G64="https://dl.winehq.org/wine/wine-gecko/$GECKO/wine-gecko-$GECKO-x86_64.tar.xz"
M86="https://dl.winehq.org/wine/wine-mono/$MONO/wine-mono-$MONO-x86.tar.xz"
GSRC="https://dl.winehq.org/wine/wine-gecko/$GECKO/wine-gecko-$GECKO-src.tar.xz"
MSRC="https://dl.winehq.org/wine/wine-mono/$MONO/wine-mono-$MONO-src.tar.xz"

mkdir -p "$(dirname "$OUT")"
cat > "$OUT" <<EOF
# shellcheck shell=bash disable=SC2034
# SPDX-License-Identifier: LGPL-2.1-or-later
# Pinned sources for Wine $VERSION (the $BASE base): every flavour built on
# it uses these. Written by tools/pin; review changes like code.

WINE_VERSION="$VERSION"
TOOLCHAIN="$TOOLCHAIN"

WINE_URL="$URL"
WINE_SHA256="$SHA"
# The tarball's .sign verified with this key when pinned ($(date -u +%Y-%m-%d)):
WINE_SIGNING_KEY="$KEY"
# Release date, used as SOURCE_DATE_EPOCH (signature creation time).
WINE_RELEASE_EPOCH=$SIGTIME

# Add-ons: the versions dlls/appwiz.cpl/addons.c names, as the tarballs
# Gcenx extracts into share/wine.
GECKO_VERSION="$GECKO"
GECKO_X86_URL="$G86"
GECKO_X86_SHA256="$(hash_url "$G86")"
GECKO_X86_64_URL="$G64"
GECKO_X86_64_SHA256="$(hash_url "$G64")"
MONO_VERSION="$MONO"
MONO_URL="$M86"
MONO_SHA256="$(hash_url "$M86")"
# Their source, for the -sources asset (Gecko is MPL-2.0; Mono includes
# LGPL parts).
GECKO_SRC_URL="$GSRC"
GECKO_SRC_SHA256="$(hash_url "$GSRC")"
MONO_SRC_URL="$MSRC"
MONO_SRC_SHA256="$(hash_url "$MSRC")"
EOF
echo "Wrote $OUT"
"$ROOT/tools/patch" renumber-versions "$BASE" "$VERSION"
fi

# Add the version to the flavour, in WineHQ's order.
/usr/bin/python3 -I - "$F" "$VERSION" "$ROOT/build" <<'PY'
import re, sys
f, v, build = sys.argv[1:]
sys.path.insert(0, build)
from patches import version_key
s = open(f).read()
m = re.search(r"^VERSIONS=\((.*)\)$", s, re.M)
vs = sorted(set(m.group(1).split()) | {v}, key=version_key)
open(f, "w").write(s[:m.start()] + "VERSIONS=(" + " ".join(vs) + ")" + s[m.end():])
PY
echo "Added $VERSION to $F"

mkdir -p "$TMP/src"
tar -xJf "$TMP/src.tar.xz" -C "$TMP/src"
"$ROOT/tools/patch" extend "$FLAVOUR" "$VERSION" "$TMP/src/wine-$VERSION"
