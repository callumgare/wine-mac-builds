#!/usr/bin/env python3
# SPDX-License-Identifier: LGPL-2.1-or-later
"""Work with patch sets' patches (patches/README.md).

    tools/patch new <set> <name> <version> [--base winehq]
        Make patches/<base>/<set>/<NNNN>-<name>/<name>@<version>.patch with
        the next free order number in the set's range and a header to fill
        in. Write the diff below the header's blank line.
    tools/patch split <name> <version> [--base winehq]
        Give <version> its own copy of the patch, so a fix can be changed on
        one version first (AGENTS.md, "Fixing a bug"). The new copy starts as
        a duplicate of the one that covered <version>.
    tools/patch renumber-versions <base> <new version>
        After inputs/<base>/<new version>.sh is written: rename every copy
        so it still covers exactly the versions it did. A run such as
        11.21-11.23 covers the pinned versions between its ends, so a newly
        pinned version inside it would otherwise be covered silently.
        tools/pin runs this.
    tools/patch extend <flavour> <version> <wine source dir>
        Carry the flavour's patches into a newly pinned version: in order,
        each patch the flavour applies at the nearer of its neighbours (the
        nearest listed versions either side, by pinned order; on a tie the
        previous one) gets <version> added to the first of its copies that
        applies without fuzz, nearest version first (git mv). A copy that needs fuzz isn't carried, and nor is one
        whose Needed until is <version> or earlier. Patches that don't apply
        are listed: port them by hand (AGENTS.md). Listed to check by hand:
        copies whose Needed until is a condition. Patches only the farther
        neighbour applies are listed, not carried: the nearer version
        usually dropped them on purpose.
        The source directory is changed: pass a scratch copy. tools/pin
        runs this.
    tools/patch rename <old name> <new name> [--base winehq]
        Rename a patch: its folder, every copy's file name, other patches'
        Expects before it, and regression tests' Guards. Names are frozen
        once a published build has applied the patch; before that, this is
        how a name is corrected.
    tools/patch refresh <flavour> <version> [<name> ...]
        Regenerate copies' diffs against the patches now applied before
        them, so they apply at fuzz 0: after an earlier patch is dropped or
        changed, or when the checker reports a copy that needs fuzz. Only
        the diff changes, not the header, and the patched tree stays the
        same. With no names, every copy the flavour applies at <version>
        that needs it. A copy covering several versions is refused: split
        it first. --fuzz N lets patch place hunks whose context changed
        more (check where they landed). Needs WineHQ's tarball for
        <version> in the download cache (WMB_CACHE_DIR, default .cache).
    tools/patch deps <flavour> <version> [<name> ...]
        Which earlier patches each patch needs: for each earlier patch Q
        touching the same files, does P still apply (fuzz 0) to those files
        with every earlier patch but Q? Prints "P needs Q (files)". Compare
        with each header's Expects before it, and declare what's missing
        (marking a name that's needed only as diff context "(context)").
        Same download cache as refresh.
    tools/patch check <flavour> <version>
        What CI runs for every flavour and pinned version: applies the
        flavour's copies in order at fuzz 0, as builds do, and fails on a
        copy that needs fuzz or doesn't apply; then runs deps and fails on
        a dependency the patch's Expects before it doesn't name. Same
        download cache as refresh.
"""

import pathlib
import shutil
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "build"))
import patches as P  # noqa: E402

SKELETON = """SPDX-License-Identifier: LGPL-2.1-or-later
Summary: TODO one line, what the patch does, no full stop
Category: TODO
Kind: TODO
Origin: wine-mac-builds
  Note: TODO, or replace with the source's Origin block; the other keys
    you may need (Seen on, Enable, No test...) are in patches/README.md
Upstream: no
Why: TODO what problem it fixes, and how
Programs: TODO the programs that led to it, each with what went wrong
Status: {version}: {date}: written; not yet in a build

"""


def opt(argv, name, default):
    if name in argv:
        i = argv.index(name)
        value = argv[i + 1]
        del argv[i:i + 2]
        return value
    return default


def git_mv(src, dst):
    if src == dst:
        return
    r = subprocess.run(["git", "-C", str(ROOT), "mv", str(src), str(dst)], capture_output=True)
    if r.returncode:  # not tracked yet
        src.rename(dst)


def find(base, name):
    for p in P.load(base):
        if p.name == name:
            return p
    sys.exit(f"no patch named {name} under patches/{base}/")


def cmd_new(argv):
    base = opt(argv, "--base", "winehq")
    set_name, name, version = argv
    if not P.DIR_RE.match(f"0000-{name}"):
        sys.exit(f"{name}: names are lower-case letters, digits, '.' and '-' (<module>-<what it does>)")
    info = P.set_info(base, set_name)
    if not info.get("range"):
        sys.exit(f"no set {set_name} under patches/{base}/ (or its README has no Range)")
    if version not in P.base_versions(base):
        sys.exit(f"{version} isn't pinned (inputs/{base}/{version}.sh)")
    existing = P.load(base)
    if any(p.name == name for p in existing):
        sys.exit(f"{name} already exists")
    lo, hi = info["range"]
    used = {int(p.number) for p in existing}
    free = [n for n in range(lo, hi + 1) if n not in used and n > max([u for u in used if lo <= u <= hi] or [lo - 1])]
    if not free:
        sys.exit(f"no free number left above the last one in {set_name}'s range {lo:04d}-{hi:04d}")
    d = P.PATCHES / base / set_name / f"{free[0]:04d}-{name}"
    d.mkdir()
    f = d / f"{name}@{version}.patch"
    import datetime
    f.write_text(SKELETON.format(version=version, date=datetime.date.today().isoformat()))
    print(f.relative_to(ROOT))


def cmd_split(argv):
    base = opt(argv, "--base", "winehq")
    name, version = argv
    p = find(base, name)
    pinned = P.base_versions(base)
    for c in p.copies:
        if c.versions and version in c.versions:
            rest = [v for v in c.versions if v != version]
            if not rest:
                sys.exit(f"{c.path.name} already covers only {version}")
            new = c.path.with_name(f"{name}@{version}.patch")
            shutil.copyfile(c.path, new)
            git_mv(c.path, c.path.with_name(f"{name}@{P.format_versions(rest, pinned)}.patch"))
            print(new.relative_to(ROOT))
            return
    sys.exit(f"no copy of {name} covers {version}")


def cmd_renumber_versions(argv):
    base, new_version = argv
    pinned = P.base_versions(base)
    if new_version not in pinned:
        sys.exit(f"inputs/{base}/{new_version}.sh doesn't exist yet")
    old_pinned = [v for v in pinned if v != new_version]
    for p in P.load(base):
        for c in p.copies:
            try:
                versions = P.parse_versions(c.versions_text, old_pinned)
            except ValueError as e:
                sys.exit(f"{c.file}: {e}")
            dst = c.path.with_name(f"{p.name}@{P.format_versions(versions, pinned)}.patch")
            if dst != c.path:
                git_mv(c.path, dst)
                print(f"{c.path.name} -> {dst.name} (coverage unchanged)")


def apply(copy, src, dry):
    args = ["patch", "-d", str(src), "-p1", "--forward", "--batch", "--fuzz=0", "-s"]
    if dry:
        args.append("--dry-run")
    with open(copy.path, "rb") as f:
        return subprocess.run(args, stdin=f, capture_output=True).returncode == 0


def cmd_extend(argv):
    flavour, version, src = argv
    src = pathlib.Path(src)
    fl = P.flavour(flavour)
    base, sets = fl["base"], fl["sets"]
    pinned = P.base_versions(base)
    key = P.version_key(version)
    earlier = [v for v in fl["versions"] if P.version_key(v) < key]
    later = [v for v in fl["versions"] if P.version_key(v) > key]
    if not earlier and not later:
        sys.exit(f"{flavour} has no other version to carry patches from")
    prev = max(earlier, key=P.version_key) if earlier else None
    nxt = min(later, key=P.version_key) if later else None
    import patch_header
    have = {c.patch.name: c for c in P.resolve(base, sets, version)}
    at_prev = {c.patch.name: c for c in P.resolve(base, sets, prev)} if prev else {}
    at_next = {c.patch.name: c for c in P.resolve(base, sets, nxt)} if nxt else {}
    # The nearer neighbour's patches are the ones to carry (on a tie, the
    # previous version's); the other's extras are listed, not carried: a
    # patch the nearer version doesn't take was usually dropped on purpose.
    def gap(v):
        return abs(pinned.index(v) - pinned.index(version))
    near_next = nxt is not None and (prev is None or gap(nxt) < gap(prev))
    near, near_v, far, far_v = ((at_next, nxt, at_prev, prev) if near_next else
                                (at_prev, prev, at_next, nxt))
    patches = {c.patch.name: c.patch for c in near.values()}
    extras = sorted(n for n in far if n not in near and n not in have)

    def distance(c):
        return min(abs(pinned.index(v) - pinned.index(version))
                   for v in c.versions)

    carried, missing, ended, conditions = [], [], [], []
    for p in sorted(patches.values(), key=lambda p: p.number):
        name = p.name
        use = have.get(name)
        if use is None:
            h = patch_header.parse(near[name].path)
            until = h.fields.get("Needed until")
            nu = patch_header.needed_until(h)
            if nu and key >= P.version_key(nu):
                ended.append(f"{name} (Needed until: {until})")
                continue
            if until and not nu:
                conditions.append(f"{name} (Needed until: {until})")
            # Nearest version first; on a tie, the previous version's copy.
            tries = sorted((c for c in p.copies if c.versions),
                           key=lambda c: (distance(c), c is not at_prev.get(name)))
            for c in tries:
                if apply(c, src, dry=True):
                    use = c
                    break
            if use is not None:
                dst = use.path.with_name(
                    f"{name}@{P.format_versions(use.versions + [version], pinned)}.patch")
                git_mv(use.path, dst)
                use.path = dst
                carried.append(name)
        if use is None:
            missing.append(name)
            continue
        if not apply(use, src, dry=False):
            sys.exit(f"{use.file} passed its dry run but didn't apply")
    print(f"{flavour} {version}: carried {len(carried)} patches from {near_v}; "
          f"{len(have)} already had a copy for {version}")
    if ended:
        print(f"Not carried (their Needed until is {version} or earlier):")
        for n in ended:
            print(f"  {n}")
    if missing:
        print("Not carried (doesn't apply without fuzz; port by hand, then tools/patch split "
              "or add a copy):")
        for n in missing:
            print(f"  {n}")
    if conditions:
        print(f"Needed until a condition: check that it still holds at {version}, and drop the "
              "copy from this version if not:")
        for n in conditions:
            print(f"  {n}")
    if extras:
        print(f"Not carried ({far_v} applies them but {near_v}, the nearer version, doesn't; "
              f"add a copy by hand if {version} needs one):")
        for n in extras:
            print(f"  {n}")


def cmd_rename(argv):
    import re
    base = opt(argv, "--base", "winehq")
    old, new = argv
    if not P.DIR_RE.match(f"0000-{new}"):
        sys.exit(f"{new}: names are lower-case letters, digits, '.' and '-'")
    if any(p.name == new for p in P.load(base)):
        sys.exit(f"{new} already exists")
    p = find(base, old)
    for c in p.copies:
        git_mv(c.path, c.path.with_name(c.path.name.replace(f"{old}@", f"{new}@", 1)))
    git_mv(p.path, p.path.with_name(f"{p.number}-{new}"))
    word = re.compile(r"(?<![a-z0-9.-])" + re.escape(old) + r"(?![a-z0-9-])")
    touched = []
    for f in list((P.PATCHES / base).rglob("*.patch")) + \
            [t for t in (ROOT / "tests" / "regress").glob("*") if t.suffix in (".c", ".sh")] + \
            [ROOT / "tests" / "regress" / "README.md"]:
        text = f.read_text()
        head, sep, body = text.partition("\n\n") if f.suffix == ".patch" else (text, "", "")
        new_head = word.sub(new, head)
        if new_head != head:
            f.write_text(new_head + sep + body)
            touched.append(str(f.relative_to(ROOT)))
    print(f"renamed {old} -> {new}; references updated in {len(touched)} files")
    for t in touched:
        print(f"  {t}")


def cmd_refresh(argv):
    import tempfile
    fuzz = opt(argv, "--fuzz", None)
    flavour, version, *names = argv
    fl = P.flavour(flavour)
    copies = P.resolve(fl["base"], fl["sets"], version)
    tarball = tarball_for(fl["base"], version)
    with tempfile.TemporaryDirectory() as tmp:
        tmp = pathlib.Path(tmp)
        subprocess.run(["tar", "-xf", str(tarball), "-C", str(tmp)], check=True)
        src = tmp / f"wine-{version}"
        refreshed = []
        for c in copies:
            wanted = not names or c.patch.name in names
            if apply(c, src, dry=True):
                apply(c, src, dry=False)
                continue
            if not wanted:
                # Not ours to refresh: apply it with patch's default fuzz, so
                # one stale copy doesn't stop another being refreshed.
                with open(c.path, "rb") as f:
                    r = subprocess.run(["patch", "-d", str(src), "-p1", "--forward", "--batch", "-s"],
                                       stdin=f, capture_output=True)
                if r.returncode:
                    sys.exit(f"{c.file} doesn't apply at {version}; refresh or port it first")
                for junk in list(src.rglob("*.orig")):
                    junk.unlink()
                continue
            if len(c.versions) > 1:
                sys.exit(f"{c.file} covers {', '.join(c.versions)}: refreshing it against "
                         f"{version} alone could break the others. Split it first "
                         f"(tools/patch split {c.patch.name} {version}), refresh, and merge "
                         f"copies that come out the same.")
            text = c.path.read_text()
            head, _, body = text.partition("\n\n")
            files = sorted({l.split(" b/", 1)[1] for l in body.splitlines() if l.startswith("diff --git ")})
            before = tmp / "before"
            shutil.rmtree(before, ignore_errors=True)
            for f in files:
                (before / f).parent.mkdir(parents=True, exist_ok=True)
                if (src / f).exists():
                    shutil.copy2(src / f, before / f)
            r = subprocess.run(["patch", "-d", str(src), "-p1", "--forward", "--batch", "-s"]
                               + ([f"--fuzz={fuzz}"] if fuzz else []),
                               input=body, text=True, capture_output=True)
            if r.returncode:
                sys.exit(f"{c.file} doesn't apply at {version} even with fuzz:\n{r.stdout}{r.stderr}"
                         "Port it by hand.")
            for junk in list(src.rglob("*.orig")):
                junk.unlink()
            diff = []
            for f in files:
                a = before / f if (before / f).exists() else pathlib.Path("/dev/null")
                b = src / f if (src / f).exists() else pathlib.Path("/dev/null")
                d = subprocess.run(["diff", "-u", "--label", f"a/{f}", "--label", f"b/{f}", str(a), str(b)],
                                   capture_output=True, text=True).stdout
                if d:
                    diff.append(f"diff --git a/{f} b/{f}\n{d}")
            c.path.write_text(head + "\n\n" + "".join(diff))
            refreshed.append(c.file)
    for f in refreshed:
        print(f"refreshed {f}")
    if not refreshed:
        print(f"every copy applies at fuzz 0 at {version}")


def tarball_for(base, version):
    import os
    inputs = (ROOT / "inputs" / base / f"{version}.sh").read_text()
    sha = next(l.split('"')[1] for l in inputs.splitlines() if l.startswith("WINE_SHA256="))
    cache = pathlib.Path(os.environ.get("WMB_CACHE_DIR", ROOT / ".cache"))
    tarball = next((cache / sha).glob("wine-*.tar.xz"), None) if (cache / sha).is_dir() else None
    if tarball is None:
        sys.exit(f"WineHQ's {version} tarball isn't in {cache}/{sha}/ (set WMB_CACHE_DIR)")
    return tarball


def find_deps(copies, src, tmp, names=()):
    """For each copy P (or those named) and each earlier copy Q touching the
    same files: does P still apply at fuzz 0 to those files with every
    earlier patch but Q? Yields (P name, Q name, shared files) when it
    doesn't. src is the unpatched source tree; tmp a scratch folder."""
    def split(path):
        body = path.read_text().split("\n\n", 1)[1]
        out, cur, buf = {}, None, []
        for line in body.split("\n"):
            if line.startswith("diff --git "):
                if cur:
                    out[cur] = out.get(cur, "") + "\n".join(buf) + "\n"
                cur, buf = line.split(" b/", 1)[1], [line]
            else:
                buf.append(line)
        if cur:
            out[cur] = out.get(cur, "") + "\n".join(buf) + "\n"
        return out

    def run_patch(d, text, *extra):
        return subprocess.run(["patch", "-d", str(d), "-p1", "-s", "--forward", "--batch"] + list(extra),
                              input=text, text=True, capture_output=True).returncode == 0

    diffs = [(c.patch.name, split(c.path)) for c in copies]
    for i, (pname, pd) in enumerate(diffs):
        if names and pname not in names:
            continue
        for j in range(i):
            qname, qd = diffs[j]
            shared = sorted(set(pd) & set(qd))
            if not shared:
                continue
            work = tmp / "w"
            shutil.rmtree(work, ignore_errors=True)
            for f in shared:
                (work / f).parent.mkdir(parents=True, exist_ok=True)
                if (src / f).exists():
                    shutil.copy(src / f, work / f)
            ok = True
            for k in range(i):
                if k == j:
                    continue
                for f in shared:
                    if f in diffs[k][1] and not run_patch(work, diffs[k][1][f]):
                        ok = None   # an earlier patch needs Q too; can't tell here
            if ok is None:
                continue
            if not all(run_patch(work, pd[f], "--fuzz=0", "--dry-run") for f in shared):
                yield pname, qname, shared


def cmd_deps(argv):
    import tempfile
    flavour, version, *names = argv
    fl = P.flavour(flavour)
    copies = P.resolve(fl["base"], fl["sets"], version)
    tarball = tarball_for(fl["base"], version)
    with tempfile.TemporaryDirectory() as tmp:
        tmp = pathlib.Path(tmp)
        subprocess.run(["tar", "-xf", str(tarball), "-C", str(tmp)], check=True)
        for pname, qname, shared in find_deps(copies, tmp / f"wine-{version}", tmp, names):
            print(f"{pname} needs {qname} ({', '.join(shared)})")


def cmd_check(argv):
    """What CI runs for each flavour and version: every copy applies at fuzz 0
    in order, and every dependency tools/patch deps finds is declared."""
    import tempfile
    import patch_header
    flavour, version = argv
    fl = P.flavour(flavour)
    copies = P.resolve(fl["base"], fl["sets"], version)
    tarball = tarball_for(fl["base"], version)
    problems = []
    with tempfile.TemporaryDirectory() as tmp:
        tmp = pathlib.Path(tmp)
        subprocess.run(["tar", "-xf", str(tarball), "-C", str(tmp)], check=True)
        pristine = tmp / f"wine-{version}"
        tree = tmp / "tree"
        shutil.copytree(pristine, tree, symlinks=True)
        for c in copies:
            if apply(c, tree, dry=False):
                continue
            with open(c.path, "rb") as f:
                r = subprocess.run(["patch", "-d", str(tree), "-p1", "--forward", "--batch", "-s"],
                                   stdin=f, capture_output=True)
            problems.append(f"{c.file}: " + ("needs fuzz at " if r.returncode == 0 else "doesn't apply to ")
                            + f"{version}; tools/patch refresh {flavour} {version} {c.patch.name}"
                            + ("" if r.returncode == 0 else " or port it"))
            if r.returncode:
                break
        shutil.rmtree(tree)
        declared = {}
        for c in copies:
            value = patch_header.parse(c.path).fields.get("Expects before it", "")
            declared[c.patch.name] = {n for n, _ in patch_header.parse_names(value)[0]} if value else set()
        by_name = {c.patch.name: c for c in copies}
        for pname, qname, shared in find_deps(copies, pristine, tmp):
            if qname not in declared[pname]:
                problems.append(f"{by_name[pname].file}: needs {qname} ({', '.join(shared)}) at {version}, "
                                "but Expects before it doesn't name it (add it, with (context) if it's "
                                "only the diff's context)")
    for line in problems:
        print(line, file=sys.stderr)
    print(f"{flavour} {version}: {len(copies)} copies, {len(problems)} problem(s)", file=sys.stderr)
    return 1 if problems else 0


def main(argv):
    cmds = {"new": cmd_new, "split": cmd_split, "renumber-versions": cmd_renumber_versions,
            "extend": cmd_extend, "rename": cmd_rename, "refresh": cmd_refresh,
            "deps": cmd_deps, "check": cmd_check}
    if not argv or argv[0] not in cmds:
        print(__doc__, file=sys.stderr)
        return 2
    try:
        return cmds[argv[0]](argv[1:]) or 0
    except ValueError as e:
        print(f"tools/patch {argv[0]}: {e} (usage below)\n\n{__doc__}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
