#!/usr/bin/env python3
# SPDX-License-Identifier: LGPL-2.1-or-later
"""Work with patch sets' patches (patches/README.md).

    tools/patch new <set> <name> <version> [--base winehq]
        Make patches/<base>/<set>/<NNNN>-<name>/<name>@<version>.patch with
        the next free order number in the set's range and a header to fill
        in. Write the diff below the header's blank line.
    tools/patch split <name> <version> [--base winehq]
        Give <version> its own copy of the patch, so a fix can be changed on
        one version first (AGENTS.md, "Fixing a bug"). The new copy starts as
        a duplicate of the one that covered <version>.
    tools/patch renumber-versions <base> <new version>
        After inputs/<base>/<new version>.sh is written: rename every copy
        so it still covers exactly the versions it did. A run such as
        11.21-11.23 covers the pinned versions between its ends, so a newly
        pinned version inside it would otherwise be covered silently.
        tools/pin runs this.
    tools/patch extend <flavour> <version> <wine source dir>
        Carry the flavour's patches into a newly pinned version: in order,
        each patch whose copy for the flavour's previous version applies to
        <version> without fuzz gets <version> added to that copy (git mv).
        Patches that don't apply are listed: port them by hand (AGENTS.md).
        The source directory is changed: pass a scratch copy. tools/pin
        runs this.
    tools/patch rename <old name> <new name> [--base winehq]
        Rename a patch: its folder, every copy's file name, other patches'
        Expects before it, and regression tests' Guards. Names are frozen
        once a published build has applied the patch; before that, this is
        how a name is corrected.
    tools/patch refresh <flavour> <version> [<name> ...]
        Regenerate copies' diffs against the patches now applied before
        them, so they apply at fuzz 0: after an earlier patch is dropped or
        changed, or when the checker reports a copy that needs fuzz. Only
        the diff changes, not the header, and the patched tree stays the
        same. With no names, every copy the flavour applies at <version>
        that needs it. Needs WineHQ's tarball for <version> in the
        download cache (WMB_CACHE_DIR, default .cache).
"""

import pathlib
import shutil
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "build"))
import patches as P  # noqa: E402

SKELETON = """SPDX-License-Identifier: LGPL-2.1-or-later
Summary: TODO one line, what the patch does, no full stop
Category: TODO
Kind: TODO
Origin: wine-mac-builds
From: TODO
Source: none published
Upstream: no
Why: TODO what problem it fixes, and how
Programs: TODO the programs that led to it, each with what went wrong
Status: {date}: written; not yet in a build.

"""


def opt(argv, name, default):
    if name in argv:
        i = argv.index(name)
        value = argv[i + 1]
        del argv[i:i + 2]
        return value
    return default


def git_mv(src, dst):
    if src == dst:
        return
    r = subprocess.run(["git", "-C", str(ROOT), "mv", str(src), str(dst)], capture_output=True)
    if r.returncode:  # not tracked yet
        src.rename(dst)


def find(base, name):
    for p in P.load(base):
        if p.name == name:
            return p
    sys.exit(f"no patch named {name} under patches/{base}/")


def cmd_new(argv):
    base = opt(argv, "--base", "winehq")
    set_name, name, version = argv
    if not P.DIR_RE.match(f"0000-{name}"):
        sys.exit(f"{name}: names are lower-case letters, digits, '.' and '-' (<module>-<what it does>)")
    info = P.set_info(base, set_name)
    if not info.get("range"):
        sys.exit(f"no set {set_name} under patches/{base}/ (or its README has no Range)")
    if version not in P.base_versions(base):
        sys.exit(f"{version} isn't pinned (inputs/{base}/{version}.sh)")
    existing = P.load(base)
    if any(p.name == name for p in existing):
        sys.exit(f"{name} already exists")
    lo, hi = info["range"]
    used = {int(p.number) for p in existing}
    free = [n for n in range(lo, hi + 1) if n not in used and n > max([u for u in used if lo <= u <= hi] or [lo - 1])]
    if not free:
        sys.exit(f"no free number left above the last one in {set_name}'s range {lo:04d}-{hi:04d}")
    d = P.PATCHES / base / set_name / f"{free[0]:04d}-{name}"
    d.mkdir()
    f = d / f"{name}@{version}.patch"
    import datetime
    f.write_text(SKELETON.format(date=datetime.date.today().isoformat()))
    print(f.relative_to(ROOT))


def cmd_split(argv):
    base = opt(argv, "--base", "winehq")
    name, version = argv
    p = find(base, name)
    pinned = P.base_versions(base)
    for c in p.copies:
        if c.versions and version in c.versions:
            rest = [v for v in c.versions if v != version]
            if not rest:
                sys.exit(f"{c.path.name} already covers only {version}")
            new = c.path.with_name(f"{name}@{version}.patch")
            shutil.copyfile(c.path, new)
            git_mv(c.path, c.path.with_name(f"{name}@{P.format_versions(rest, pinned)}.patch"))
            print(new.relative_to(ROOT))
            return
    sys.exit(f"no copy of {name} covers {version}")


def cmd_renumber_versions(argv):
    base, new_version = argv
    pinned = P.base_versions(base)
    if new_version not in pinned:
        sys.exit(f"inputs/{base}/{new_version}.sh doesn't exist yet")
    old_pinned = [v for v in pinned if v != new_version]
    for p in P.load(base):
        for c in p.copies:
            try:
                versions = P.parse_versions(c.versions_text, old_pinned)
            except ValueError as e:
                sys.exit(f"{c.file}: {e}")
            dst = c.path.with_name(f"{p.name}@{P.format_versions(versions, pinned)}.patch")
            if dst != c.path:
                git_mv(c.path, dst)
                print(f"{c.path.name} -> {dst.name} (coverage unchanged)")


def apply(copy, src, dry):
    args = ["patch", "-d", str(src), "-p1", "--forward", "--batch", "--fuzz=0", "-s"]
    if dry:
        args.append("--dry-run")
    with open(copy.path, "rb") as f:
        return subprocess.run(args, stdin=f, capture_output=True).returncode == 0


def cmd_extend(argv):
    flavour, version, src = argv
    src = pathlib.Path(src)
    fl = P.flavour(flavour)
    base, sets = fl["base"], fl["sets"]
    pinned = P.base_versions(base)
    earlier = [v for v in fl["versions"] if P.version_key(v) < P.version_key(version)]
    if not earlier:
        sys.exit(f"{flavour} has no version before {version} to carry patches from")
    prev = max(earlier, key=P.version_key)
    have = {c.patch.name: c for c in P.resolve(base, sets, version)}
    carried, missing = [], []
    for c in P.resolve(base, sets, prev):
        name = c.patch.name
        use = have.get(name)
        if use is None and apply(c, src, dry=True):
            use = c
            dst = c.path.with_name(
                f"{name}@{P.format_versions(c.versions + [version], pinned)}.patch")
            git_mv(c.path, dst)
            c.path = dst
            carried.append(name)
        if use is None:
            missing.append(name)
            continue
        if not apply(use, src, dry=False):
            sys.exit(f"{use.file} passed its dry run but didn't apply")
    print(f"{flavour} {version}: carried {len(carried)} patches from {prev}; "
          f"{len(have)} already had a copy for {version}")
    if missing:
        print("Not carried (doesn't apply without fuzz; port by hand, then tools/patch split "
              "or add a copy):")
        for n in missing:
            print(f"  {n}")


def cmd_rename(argv):
    import re
    base = opt(argv, "--base", "winehq")
    old, new = argv
    if not P.DIR_RE.match(f"0000-{new}"):
        sys.exit(f"{new}: names are lower-case letters, digits, '.' and '-'")
    if any(p.name == new for p in P.load(base)):
        sys.exit(f"{new} already exists")
    p = find(base, old)
    for c in p.copies:
        git_mv(c.path, c.path.with_name(c.path.name.replace(f"{old}@", f"{new}@", 1)))
    git_mv(p.path, p.path.with_name(f"{p.number}-{new}"))
    word = re.compile(r"(?<![a-z0-9.-])" + re.escape(old) + r"(?![a-z0-9-])")
    touched = []
    for f in list((P.PATCHES / base).rglob("*.patch")) + \
            [t for t in (ROOT / "tests" / "regress").glob("*") if t.suffix in (".c", ".sh")] + \
            [ROOT / "tests" / "regress" / "README.md"]:
        text = f.read_text()
        head, sep, body = text.partition("\n\n") if f.suffix == ".patch" else (text, "", "")
        new_head = word.sub(new, head)
        if new_head != head:
            f.write_text(new_head + sep + body)
            touched.append(str(f.relative_to(ROOT)))
    print(f"renamed {old} -> {new}; references updated in {len(touched)} files")
    for t in touched:
        print(f"  {t}")


def cmd_refresh(argv):
    import os
    import tempfile
    flavour, version, *names = argv
    fl = P.flavour(flavour)
    copies = P.resolve(fl["base"], fl["sets"], version)
    inputs = (ROOT / "inputs" / fl["base"] / f"{version}.sh").read_text()
    sha = next(l.split('"')[1] for l in inputs.splitlines() if l.startswith("WINE_SHA256="))
    cache = pathlib.Path(os.environ.get("WMB_CACHE_DIR", ROOT / ".cache"))
    tarball = next((cache / sha).glob("wine-*.tar.xz"), None) if (cache / sha).is_dir() else None
    if tarball is None:
        sys.exit(f"WineHQ's {version} tarball isn't in {cache}/{sha}/ (set WMB_CACHE_DIR)")
    with tempfile.TemporaryDirectory() as tmp:
        tmp = pathlib.Path(tmp)
        subprocess.run(["tar", "-xf", str(tarball), "-C", str(tmp)], check=True)
        src = tmp / f"wine-{version}"
        refreshed = []
        for c in copies:
            wanted = not names or c.patch.name in names
            if apply(c, src, dry=True):
                apply(c, src, dry=False)
                continue
            if not wanted:
                sys.exit(f"{c.file} doesn't apply at fuzz 0 at {version}; refresh it too "
                         f"(or name no patches to refresh all)")
            text = c.path.read_text()
            head, _, body = text.partition("\n\n")
            files = sorted({l.split(" b/", 1)[1] for l in body.splitlines() if l.startswith("diff --git ")})
            before = tmp / "before"
            shutil.rmtree(before, ignore_errors=True)
            for f in files:
                (before / f).parent.mkdir(parents=True, exist_ok=True)
                if (src / f).exists():
                    shutil.copy2(src / f, before / f)
            r = subprocess.run(["patch", "-d", str(src), "-p1", "--forward", "--batch", "-s"],
                               input=body, text=True, capture_output=True)
            if r.returncode:
                sys.exit(f"{c.file} doesn't apply at {version} even with fuzz:\n{r.stdout}{r.stderr}"
                         "Port it by hand.")
            for junk in list(src.rglob("*.orig")):
                junk.unlink()
            diff = []
            for f in files:
                a = before / f if (before / f).exists() else pathlib.Path("/dev/null")
                b = src / f if (src / f).exists() else pathlib.Path("/dev/null")
                d = subprocess.run(["diff", "-u", "--label", f"a/{f}", "--label", f"b/{f}", str(a), str(b)],
                                   capture_output=True, text=True).stdout
                if d:
                    diff.append(f"diff --git a/{f} b/{f}\n{d}")
            c.path.write_text(head + "\n\n" + "".join(diff))
            refreshed.append(c.file)
    for f in refreshed:
        print(f"refreshed {f}")
    if not refreshed:
        print(f"every copy applies at fuzz 0 at {version}")


def main(argv):
    cmds = {"new": cmd_new, "split": cmd_split, "renumber-versions": cmd_renumber_versions,
            "extend": cmd_extend, "rename": cmd_rename, "refresh": cmd_refresh}
    if not argv or argv[0] not in cmds:
        print(__doc__, file=sys.stderr)
        return 2
    try:
        cmds[argv[0]](argv[1:])
    except ValueError as e:
        print(f"tools/patch {argv[0]}: {e} (usage below)\n\n{__doc__}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
