From: CrossOver 25.1.1 CrossOver Hack #18896 (dlls/winemac.drv/window.c, cocoa_window.m)
Source: https://media.codeweavers.com/pub/crossover/source/crossover-sources-25.1.1.tar.gz (sources/wine/dlls/winemac.drv/window.c, cocoa_window.m)
Upstream: no
Why: When a Mac window gains focus, winemac used to send the window a
 simulated WM_MOUSEACTIVATE (a click on its menu) to ask whether it wants
 to be activated; CrossOver says this breaks Unity games. The hack makes
 it activate the window without asking, keeps queued WINDOW_GOT_FOCUS
 events when Wine itself focuses a window (makeFocused discarded them),
 and no longer skips windowGotFocus in windowDidBecomeKey when Wine caused
 the window to become key.
Evidence in 10.0_8: its macdrv_window_got_focus makes no
 NtUserGetAncestor or NtUserMessageCall call (125 vs 142 instructions,
 function comparison 2026-11-15). The cocoa_window.m parts were not checked
 separately; they ship together in CX.
Status: not yet built (2026-11-15).
Applies to: wine 10.0 (macfixes, after 0046)

diff --git a/dlls/winemac.drv/cocoa_window.m b/dlls/winemac.drv/cocoa_window.m
index ce8b571..4e31590 100644
--- a/dlls/winemac.drv/cocoa_window.m
+++ b/dlls/winemac.drv/cocoa_window.m
@@ -2130,8 +2130,8 @@ - (void) makeFocused:(BOOL)activate
         [self makeKeyWindow];
         causing_becomeKeyWindow = nil;
 
-        [queue discardEventsMatchingMask:event_mask_for_type(WINDOW_GOT_FOCUS) |
-                                         event_mask_for_type(WINDOW_LOST_FOCUS)
+        /* CrossOver Hack #18896: don't discard WINDOW_GOT_FOCUS events */
+        [queue discardEventsMatchingMask:event_mask_for_type(WINDOW_LOST_FOCUS)
                                forWindow:self];
     }
 
@@ -2907,7 +2907,7 @@ - (void)windowDidBecomeKey:(NSNotification *)notification
         if (event)
             [self flagsChanged:event];
 
-        if (causing_becomeKeyWindow == self) return;
+        /* CrossOver Hack #18896: don't return here based on causing_becomeKeyWindow */
 
         [controller windowGotFocus:self];
     }
diff --git a/dlls/winemac.drv/window.c b/dlls/winemac.drv/window.c
index 115820e..7223389 100644
--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -1899,12 +1899,7 @@ void macdrv_window_got_focus(HWND hwnd, const macdrv_event *event)
 
     if (can_window_become_foreground(hwnd) && !(style & WS_MINIMIZE))
     {
-        /* simulate a mouse click on the menu to find out
-         * whether the window wants to be activated */
-        LRESULT ma = send_message(hwnd, WM_MOUSEACTIVATE,
-                                  (WPARAM)NtUserGetAncestor(hwnd, GA_ROOT),
-                                  MAKELONG(HTMENU, WM_LBUTTONDOWN));
-        if (ma != MA_NOACTIVATEANDEAT && ma != MA_NOACTIVATE)
+        /* CrossOver Hack #18896: don't send WM_MOUSEACTIVATE, it breaks Unity games */
         {
             TRACE("setting foreground window to %p\n", hwnd);
             NtUserSetForegroundWindow(hwnd);
