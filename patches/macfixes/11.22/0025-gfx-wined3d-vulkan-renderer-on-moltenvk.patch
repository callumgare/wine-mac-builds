SPDX-License-Identifier: LGPL-2.1-or-later
Summary: Use wined3d's Vulkan renderer for Direct3D 10 and 11 on MoltenVK
Category: graphics
Kind: feature
Origin: crossover
From: CrossOver 26.3.0 CW HACK 18311 (dlls/wined3d/adapter_vk.c, directx.c, swapchain.c,
 wined3d_vk.h), without the hunks 10.0_8 lacks: GTA IV/V (CW 19355/19356), multithread_safe,
 MoltenVK multiple-viewport disable, render-area trim (CX 20098), zero-size swapchain (CX 23854)
Source: https://media.codeweavers.com/pub/crossover/source/crossover-sources-26.3.0.tar.gz
 (similar: dblark 0006-wined3d-moltenvk-hacks.patch at a6e452f, https://github.com/dblark/macos-wine-build)
CW-Hack: 18311
Upstream: no
Why: with renderer=auto, d3d10/11 apps get wined3d's Vulkan renderer when the Vulkan
 driver is MoltenVK (else OpenGL as before); Vulkan swapchains on MoltenVK get 3 images
 (CW bug 18838).
Evidence: Sikarugir 10.0_8: wined3d.dll strings "Using the Vulkan renderer for d3d10/11
 applications.", "Not running on MoltenVK, defaulting to the OpenGL backend.",
 "Application using < d3d10 API, defaulting to the OpenGL backend."; its device-extension
 table has 14 entries ending VK_EXT_host_query_reset, VK_KHR_driver_properties (CrossOver's
 two additions, the first a duplicate of an existing entry); the Vulkan swapchain code
 compares driverID with 14 (MoltenVK); multiple_viewports is set without a driverID check
 and there is no "No attachments, trimming render area" string
Port: same hunks as CX 26.3.0's CW HACK 18311 (identical code to 25.1.1), placed as CX 26
 places them in the Wine 11 code: the driver-properties chain goes after the new
 sampler-filter-minmax properties, and the two extension-table entries stay after
 VK_KHR_swapchain. The same CX hunks as before are still left out (10.0_8 lacks them).
Applies to: wine 11.22

diff --git a/dlls/wined3d/adapter_vk.c b/dlls/wined3d/adapter_vk.c
index b761f4c..ca87893 100644
--- a/dlls/wined3d/adapter_vk.c
+++ b/dlls/wined3d/adapter_vk.c
@@ -2426,6 +2426,8 @@ static bool wined3d_adapter_vk_init_device_extensions(struct wined3d_adapter_vk
         {VK_KHR_SAMPLER_YCBCR_CONVERSION_EXTENSION_NAME,    VK_API_VERSION_1_1},
         {VK_KHR_SHADER_DRAW_PARAMETERS_EXTENSION_NAME,      VK_API_VERSION_1_1},
         {VK_KHR_SWAPCHAIN_EXTENSION_NAME,                   ~0u,                true},
+        {VK_EXT_HOST_QUERY_RESET_EXTENSION_NAME,            VK_API_VERSION_1_2},
+        {VK_KHR_DRIVER_PROPERTIES_EXTENSION_NAME,           VK_API_VERSION_1_2},
         /* KHR_synchronization2 is required for KHR_video_queue. */
         {VK_KHR_SYNCHRONIZATION_2_EXTENSION_NAME,           ~0u},
         {VK_KHR_VIDEO_DECODE_H264_EXTENSION_NAME,           ~0u},
@@ -2579,12 +2581,32 @@ static BOOL wined3d_adapter_vk_init(struct wined3d_adapter_vk *adapter_vk,
     else
         minmax = NULL;
 
+    memset(&adapter_vk->driver_properties, 0, sizeof(adapter_vk->driver_properties));
+    adapter_vk->driver_properties.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES;
+    id_properties.pNext = &adapter_vk->driver_properties;
+
     if (vk_info->vk_ops.vkGetPhysicalDeviceProperties2)
         VK_CALL(vkGetPhysicalDeviceProperties2(adapter_vk->physical_device, &properties2));
     else
         VK_CALL(vkGetPhysicalDeviceProperties(adapter_vk->physical_device, &properties2.properties));
     adapter_vk->device_limits = properties2.properties.limits;
 
+    /* CW HACK 18311: Use the Vulkan renderer on macOS for d3d10/11. */
+    if (wined3d_settings.renderer == WINED3D_RENDERER_AUTO)
+    {
+        bool d3d10 = !(wined3d_creation_flags & WINED3D_PIXEL_CENTER_INTEGER);
+        bool moltenvk = adapter_vk->driver_properties.driverID == VK_DRIVER_ID_MOLTENVK;
+
+        if (!moltenvk || !d3d10)
+        {
+            if (!moltenvk)
+                TRACE("Not running on MoltenVK, defaulting to the OpenGL backend.\n");
+            if (!d3d10)
+                TRACE("Application using < d3d10 API, defaulting to the OpenGL backend.\n");
+            goto fail_vulkan;
+        }
+    }
+
     VK_CALL(vkGetPhysicalDeviceMemoryProperties(adapter_vk->physical_device, &adapter_vk->memory_properties));
 
     if (id_properties.deviceLUIDValid)
diff --git a/dlls/wined3d/directx.c b/dlls/wined3d/directx.c
index b8bd2c6..166e909 100644
--- a/dlls/wined3d/directx.c
+++ b/dlls/wined3d/directx.c
@@ -3512,13 +3512,25 @@ done:
 
 static struct wined3d_adapter *wined3d_adapter_create(unsigned int ordinal, DWORD wined3d_creation_flags)
 {
+    struct wined3d_adapter *adapter = NULL;
+
     if (wined3d_creation_flags & WINED3D_NO3D)
         return wined3d_adapter_no3d_create(ordinal, wined3d_creation_flags);
 
     if (wined3d_settings.renderer == WINED3D_RENDERER_VULKAN)
         return wined3d_adapter_vk_create(ordinal, wined3d_creation_flags);
 
-    return wined3d_adapter_gl_create(ordinal, wined3d_creation_flags);
+    if (wined3d_settings.renderer == WINED3D_RENDERER_OPENGL)
+        return wined3d_adapter_gl_create(ordinal, wined3d_creation_flags);
+
+    /* CW HACK 18311: Use the Vulkan renderer on macOS. */
+    if ((adapter = wined3d_adapter_vk_create(ordinal, wined3d_creation_flags)))
+        ERR_(winediag)("Using the Vulkan renderer for d3d10/11 applications.\n");
+
+    if (!adapter)
+        adapter = wined3d_adapter_gl_create(ordinal, wined3d_creation_flags);
+
+    return adapter;
 }
 
 static void STDMETHODCALLTYPE wined3d_null_wined3d_object_destroyed(void *parent) {}
diff --git a/dlls/wined3d/swapchain.c b/dlls/wined3d/swapchain.c
index ce2aefc..a5493cf 100644
--- a/dlls/wined3d/swapchain.c
+++ b/dlls/wined3d/swapchain.c
@@ -966,7 +966,13 @@ static HRESULT wined3d_swapchain_vk_create_vulkan_swapchain(struct wined3d_swapc
         goto fail;
     }
 
-    image_count = desc->backbuffer_count;
+    /* For CW bug 18838. Create MoltenVK swapchains with 3 images, as
+     * recommended by the MoltenVK documentation. Performance of full-screen
+     * swapchains is atrocious with the only other supported image count of 2. */
+    if (adapter_vk->driver_properties.driverID == VK_DRIVER_ID_MOLTENVK)
+        image_count = 3;
+    else
+        image_count = desc->backbuffer_count;
     if (image_count < surface_caps.minImageCount)
         image_count = surface_caps.minImageCount;
     else if (surface_caps.maxImageCount && image_count > surface_caps.maxImageCount)
diff --git a/dlls/wined3d/wined3d_vk.h b/dlls/wined3d/wined3d_vk.h
index 36124f7..6779778 100644
--- a/dlls/wined3d/wined3d_vk.h
+++ b/dlls/wined3d/wined3d_vk.h
@@ -834,6 +834,7 @@ struct wined3d_adapter_vk
 
     VkPhysicalDeviceLimits device_limits;
     VkPhysicalDeviceMemoryProperties memory_properties;
+    VkPhysicalDeviceDriverProperties driver_properties;
 };
 
 static inline struct wined3d_adapter_vk *wined3d_adapter_vk(struct wined3d_adapter *adapter)
