+static void probe_present(struct opengl_drawable *base)
+{
+    struct macdrv_drawable *d = probe_drawable(base);
+    struct macdrv_client_surface *surface;
+    IOSurfaceRef next;
+
+    if (!d || !d->surface) return;
+    surface = impl_from_client_surface(d->base.client);
+    probe_pglFinish();
+    macdrv_host_view_frame_ready(surface->host_view, d->surface);
+    if ((next = macdrv_host_view_acquire_surface(surface->host_view, d->width, d->height)) && next != d->surface)
+    {
+        d->surface = next;
+        d->gen++;
+        if ((probe_draw == d || probe_read == d) && CGLGetCurrentContext()) probe_fbo_for(d);
+    }
+}
 
