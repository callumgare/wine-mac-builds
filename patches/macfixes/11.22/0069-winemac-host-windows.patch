+static void probe_activate(struct opengl_drawable *draw, struct opengl_drawable *read)
+{
+    GLint bound;
+
+    if (!host_gl) return;
+    probe_draw = probe_drawable(draw);
+    probe_read = probe_drawable(read);
+    probe_pglGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &bound);
+    if (!bound && probe_draw) probe_pglBindFramebuffer(GL_DRAW_FRAMEBUFFER, probe_fbo_for(probe_draw));
+    probe_pglGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &bound);
+    if (!bound && probe_read) probe_pglBindFramebuffer(GL_READ_FRAMEBUFFER, probe_fbo_for(probe_read));
+}
