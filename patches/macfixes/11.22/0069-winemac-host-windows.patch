diff --git a/dlls/winemac.drv/opengl.c b/dlls/winemac.drv/opengl.c
--- a/dlls/winemac.drv/opengl.c
+++ b/dlls/winemac.drv/opengl.c
@@ -27,6 +27,7 @@
 #include "macdrv.h"
 
 #include <dlfcn.h>
+#include <OpenGL/CGLIOSurface.h>
 
 WINE_DEFAULT_DEBUG_CHANNEL(wgl);
 
@@ -57,6 +58,278 @@
 static const struct opengl_funcs *funcs;
 static const struct opengl_driver_funcs macdrv_driver_funcs;
 static const struct opengl_drawable_funcs macdrv_surface_funcs;
+
+/**********************************************************************
+ * Host mode (cocoa_host.m): OpenGL into IOSurfaces the host is sent
+ *
+ * In host mode, a window's OpenGL default framebuffer is an FBO whose
+ * colour buffer is an IOSurface from the view's pool (each one the host
+ * hands back with surface_release), and nothing is drawn into the window's
+ * Cocoa view. Framebuffer 0 is remapped here, in the functions the driver
+ * hands out, so win32u, opengl32 and wined3d are unchanged. Each present
+ * finishes, sends the surface to the host and moves to a free one.
+ */
+#define PROBE_MAX_CONTEXTS 8
+
+struct probe_fbo
+{
+    CGLContextObj ctx;
+    GLuint fbo, tex, depth;
+    unsigned int gen;
+    int width, height;      /* of the depth buffer */
+};
+
+struct macdrv_drawable
+{
+    struct opengl_drawable base;
+    IOSurfaceRef surface;
+    int width, height;
+    unsigned int gen;
+    struct probe_fbo fbos[PROBE_MAX_CONTEXTS];
+};
+
+static BOOL host_gl;
+static __thread struct macdrv_drawable *probe_draw, *probe_read;
+
+static void (*probe_pglBindFramebuffer)(GLenum, GLuint);
+static void (*probe_pglBindFramebufferEXT)(GLenum, GLuint);
+static void (*probe_pglDrawBuffer)(GLenum);
+static void (*probe_pglDrawBuffers)(GLsizei, const GLenum *);
+static void (*probe_pglReadBuffer)(GLenum);
+static void (*probe_pglGetIntegerv)(GLenum, GLint *);
+static void (*probe_pglFinish)(void);
+static void (*probe_pglGenFramebuffers)(GLsizei, GLuint *);
+static void (*probe_pglGenTextures)(GLsizei, GLuint *);
+static void (*probe_pglGenRenderbuffers)(GLsizei, GLuint *);
+static void (*probe_pglBindTexture)(GLenum, GLuint);
+static void (*probe_pglBindRenderbuffer)(GLenum, GLuint);
+static void (*probe_pglRenderbufferStorage)(GLenum, GLenum, GLsizei, GLsizei);
+static void (*probe_pglFramebufferTexture2D)(GLenum, GLenum, GLenum, GLuint, GLint);
+static void (*probe_pglFramebufferRenderbuffer)(GLenum, GLenum, GLenum, GLuint);
+static GLenum (*probe_pglCheckFramebufferStatus)(GLenum);
+
+static void probe_init(void)
+{
+    static BOOL done;
+
+    if (done) return;
+    done = TRUE;
+    if (!host_mode) return;
+    host_gl = TRUE;
+#define LOAD(f) probe_p##f = dlsym(opengl_handle, #f)
+    LOAD(glBindFramebuffer); LOAD(glBindFramebufferEXT); LOAD(glDrawBuffer); LOAD(glDrawBuffers);
+    LOAD(glReadBuffer); LOAD(glGetIntegerv); LOAD(glFinish); LOAD(glGenFramebuffers);
+    LOAD(glGenTextures); LOAD(glGenRenderbuffers); LOAD(glBindTexture); LOAD(glBindRenderbuffer);
+    LOAD(glRenderbufferStorage); LOAD(glFramebufferTexture2D); LOAD(glFramebufferRenderbuffer);
+    LOAD(glCheckFramebufferStatus);
+#undef LOAD
+    TRACE("host mode: OpenGL draws into IOSurfaces\n");
+}
+
+static struct macdrv_drawable *probe_drawable(struct opengl_drawable *base)
+{
+    if (!host_gl || !base || !base->client || base->funcs != &macdrv_surface_funcs) return NULL;
+    return CONTAINING_RECORD(base, struct macdrv_drawable, base);
+}
+
+/* A free IOSurface from the view's pool, sized to the drawable's client area. */
+static void probe_update_surface(struct macdrv_drawable *d)
+{
+    struct macdrv_client_surface *surface = impl_from_client_surface(d->base.client);
+    RECT rect = surface->client.raw ? surface->client.monitor_rect : surface->client.virtual_rect;
+    int width = max(1, rect.right - rect.left), height = max(1, rect.bottom - rect.top);
+
+    if (d->surface && d->width == width && d->height == height) return;
+    d->surface = macdrv_host_view_acquire_surface(surface->host_view, width, height);
+    d->width = width;
+    d->height = height;
+    d->gen++;
+    TRACE("drawable %p: view %u, IOSurface %p, %dx%d\n", d, surface->host_view, d->surface, width, height);
+}
+
+/* The FBO standing in for framebuffer 0 of drawable d, in the current context. */
+static GLuint probe_fbo_for(struct macdrv_drawable *d)
+{
+    CGLContextObj ctx = CGLGetCurrentContext();
+    struct probe_fbo *e = NULL;
+    GLint prev_tex, prev_draw, prev_read, prev_rb;
+    GLenum status;
+    int i;
+
+    if (!ctx) return 0;
+    probe_update_surface(d);
+    if (!d->surface) return 0;
+    for (i = 0; i < PROBE_MAX_CONTEXTS; i++)
+        if (d->fbos[i].ctx == ctx) { e = &d->fbos[i]; break; }
+    if (!e)
+    {
+        for (i = 0; i < PROBE_MAX_CONTEXTS; i++)
+            if (!d->fbos[i].ctx) { e = &d->fbos[i]; break; }
+        if (!e) e = &d->fbos[0];
+        memset(e, 0, sizeof(*e));
+        e->ctx = ctx;
+    }
+    if (e->fbo && e->gen == d->gen) return e->fbo;
+
+    probe_pglGetIntegerv(GL_TEXTURE_BINDING_RECTANGLE_ARB, &prev_tex);
+    probe_pglGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &prev_draw);
+    probe_pglGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &prev_read);
+    probe_pglGetIntegerv(GL_RENDERBUFFER_BINDING, &prev_rb);
+
+    if (!e->fbo) probe_pglGenFramebuffers(1, &e->fbo);
+    if (!e->tex) probe_pglGenTextures(1, &e->tex);
+    if (!e->depth) probe_pglGenRenderbuffers(1, &e->depth);
+
+    probe_pglBindTexture(GL_TEXTURE_RECTANGLE_ARB, e->tex);
+    if (CGLTexImageIOSurface2D(ctx, GL_TEXTURE_RECTANGLE_ARB, GL_RGBA, d->width, d->height, GL_BGRA,
+                               GL_UNSIGNED_INT_8_8_8_8_REV, d->surface, 0) != kCGLNoError)
+        ERR("CGLTexImageIOSurface2D failed\n");
+    probe_pglBindTexture(GL_TEXTURE_RECTANGLE_ARB, prev_tex);
+
+    /* A new surface of the same size keeps the depth buffer. */
+    if (e->width != d->width || e->height != d->height)
+    {
+        probe_pglBindRenderbuffer(GL_RENDERBUFFER, e->depth);
+        probe_pglRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH24_STENCIL8, d->width, d->height);
+        probe_pglBindRenderbuffer(GL_RENDERBUFFER, prev_rb);
+        e->width = d->width;
+        e->height = d->height;
+    }
+
+    probe_pglBindFramebuffer(GL_FRAMEBUFFER, e->fbo);
+    probe_pglFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_RECTANGLE_ARB, e->tex, 0);
+    probe_pglFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, e->depth);
+    probe_pglFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_STENCIL_ATTACHMENT, GL_RENDERBUFFER, e->depth);
+    status = probe_pglCheckFramebufferStatus(GL_FRAMEBUFFER);
+    if (status != GL_FRAMEBUFFER_COMPLETE)
+        ERR("context %p drawable %p: FBO %u incomplete, status %#x\n", ctx, d, e->fbo, status);
+    probe_pglBindFramebuffer(GL_DRAW_FRAMEBUFFER, prev_draw);
+    probe_pglBindFramebuffer(GL_READ_FRAMEBUFFER, prev_read);
+
+    e->gen = d->gen;
+    return e->fbo;
+}
+
+static GLuint probe_default_fbo(BOOL read)
+{
+    struct macdrv_drawable *d = read ? probe_read : probe_draw;
+    return d ? probe_fbo_for(d) : 0;
+}
+
+static BOOL probe_bound_is_default(BOOL read)
+{
+    GLint bound;
+    GLuint fbo;
+
+    if (!host_gl || !(fbo = probe_default_fbo(read))) return FALSE;
+    probe_pglGetIntegerv(read ? GL_READ_FRAMEBUFFER_BINDING : GL_DRAW_FRAMEBUFFER_BINDING, &bound);
+    return bound == fbo;
+}
+
+static GLenum probe_map_buffer(GLenum buffer)
+{
+    switch (buffer)
+    {
+    case GL_FRONT: case GL_BACK: case GL_LEFT: case GL_FRONT_LEFT: case GL_BACK_LEFT: case GL_FRONT_AND_BACK:
+        return GL_COLOR_ATTACHMENT0;
+    }
+    return buffer;
+}
+
+static void probe_bind(void (*bind)(GLenum, GLuint), GLenum target, GLuint fbo)
+{
+    if (!fbo && host_gl && (probe_draw || probe_read))
+    {
+        GLuint draw = probe_default_fbo(FALSE), read = probe_default_fbo(TRUE);
+        if (target == GL_DRAW_FRAMEBUFFER) fbo = draw;
+        else if (target == GL_READ_FRAMEBUFFER) fbo = read;
+        else if (draw != read)
+        {
+            bind(GL_DRAW_FRAMEBUFFER, draw);
+            bind(GL_READ_FRAMEBUFFER, read);
+            return;
+        }
+        else fbo = draw;
+    }
+    bind(target, fbo);
+}
+
+static void probe_glBindFramebuffer(GLenum target, GLuint fbo)
+{
+    probe_bind(probe_pglBindFramebuffer, target, fbo);
+}
+
+static void probe_glBindFramebufferEXT(GLenum target, GLuint fbo)
+{
+    probe_bind(probe_pglBindFramebufferEXT, target, fbo);
+}
+
+static void probe_glDrawBuffer(GLenum buffer)
+{
+    if (probe_bound_is_default(FALSE)) buffer = probe_map_buffer(buffer);
+    probe_pglDrawBuffer(buffer);
+}
+
+static void probe_glDrawBuffers(GLsizei n, const GLenum *buffers)
+{
+    GLenum mapped;
+
+    if (n == 1 && probe_bound_is_default(FALSE))
+    {
+        mapped = probe_map_buffer(buffers[0]);
+        probe_pglDrawBuffers(1, &mapped);
+        return;
+    }
+    probe_pglDrawBuffers(n, buffers);
+}
+
+static void probe_glReadBuffer(GLenum buffer)
+{
+    if (probe_bound_is_default(TRUE)) buffer = probe_map_buffer(buffer);
+    probe_pglReadBuffer(buffer);
+}
+
+static void probe_glGetIntegerv(GLenum pname, GLint *data)
+{
+    probe_pglGetIntegerv(pname, data);
+    if (!host_gl) return;
+    if (pname == GL_DRAW_FRAMEBUFFER_BINDING && *data && (GLuint)*data == probe_default_fbo(FALSE)) *data = 0;
+    else if (pname == GL_READ_FRAMEBUFFER_BINDING && *data && (GLuint)*data == probe_default_fbo(TRUE)) *data = 0;
+}
