From: wine-staging patch winemac.drv-no-flicker-patch (Ken Thomases; CrossOver Hack 14364)
Source: https://github.com/wine-staging/wine-staging/blob/v11.21/patches/winemac.drv-no-flicker-patch/0001-winemac.drv-No-Flicker-patch.patch
Upstream: no
Why: adds the Mac Driver registry option ForceOpenGLBackingStore, which requests a
 backing store for every GL context and stops flicker in some GL games.
Evidence in 10.0_8: winemac.so contains L"ForceOpenGLBackingStore"
Applies to: wine 11.22
Port: taken verbatim from wine-staging v11.21's version of the same patch (staging
 commit 7426bb2f), which already carries the Wine 11 form: bool option, set in the new
 macdrv_context_create(). CX 26 does not carry this hack.

diff --git a/dlls/winemac.drv/macdrv.h b/dlls/winemac.drv/macdrv.h
index 2732e52..709e688 100644
--- a/dlls/winemac.drv/macdrv.h
+++ b/dlls/winemac.drv/macdrv.h
@@ -81,6 +81,7 @@
 extern bool allow_vsync;
 extern bool allow_set_gamma;
 extern bool allow_software_rendering;
+extern bool force_backing_store;
 
 extern UINT64 app_icon_callback;
 extern UINT64 app_quit_request_callback;
diff --git a/dlls/winemac.drv/macdrv_main.c b/dlls/winemac.drv/macdrv_main.c
index 66561c3..38e2c08 100644
--- a/dlls/winemac.drv/macdrv_main.c
+++ b/dlls/winemac.drv/macdrv_main.c
@@ -53,6 +53,7 @@ bool use_precise_scrolling = true;
 int gl_surface_mode = GL_SURFACE_IN_FRONT_OPAQUE;
 bool retina_enabled = false;
 bool enable_app_nap = false;
+ bool force_backing_store = FALSE;
 
 pthread_key_t macdrv_thread_data_key = 0;
 UINT64 app_icon_callback = 0;
@@ -364,6 +365,9 @@ static void setup_options(void)
     if (!get_config_key(hkey, appkey, "EnableAppNap", buffer, sizeof(buffer)))
         enable_app_nap = IS_OPTION_TRUE(buffer[0]);
 
+    if (!get_config_key(hkey, appkey, "ForceOpenGLBackingStore", buffer, sizeof(buffer)))
+        force_backing_store = IS_OPTION_TRUE(buffer[0]);
+
     /* Don't use appkey.  The DPI and monitor sizes should be consistent for all
        processes in the prefix. */
     if (!get_config_key(hkey, NULL, "RetinaMode", buffer, sizeof(buffer)))
diff --git a/dlls/winemac.drv/opengl.c b/dlls/winemac.drv/opengl.c
index 9292dcb..c84f0a4 100644
--- a/dlls/winemac.drv/opengl.c
+++ b/dlls/winemac.drv/opengl.c
@@ -1778,7 +1778,7 @@ static struct opengl_context *macdrv_context_create(const struct opengl_context_
         *attrib++ = pf->samples;
     }
 
-    if (pf->backing_store) *attrib++ = kCGLPFABackingStore;
+    if (force_backing_store || pf->backing_store) *attrib++ = kCGLPFABackingStore;
 
     if (attrs->profile & WGL_CONTEXT_CORE_PROFILE_BIT_ARB)
     {
