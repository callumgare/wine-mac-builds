+
+/***********************************************************************
+ *              host_display_for_screen
+ *
+ * Host mode: which of the host's displays stands for screen index j (frame
+ * in the same space): the first for the primary screen, otherwise the one
+ * it overlaps most. -1 if none: the host doesn't show that screen.
+ */
+static int host_display_for_screen(int j, CGRect frame, const struct wmh_display *displays, int count)
+{
+    double best_area = 0;
+    int i, best = -1;
+
+    if (j == 0) return 0;
+    for (i = 1; i < count; i++)
+    {
+        CGRect r = CGRectIntersection(frame, CGRectMake(displays[i].frame.x, displays[i].frame.y,
+                                                        displays[i].frame.width, displays[i].frame.height));
+        double area = CGRectIsNull(r) ? 0 : r.size.width * r.size.height;
+        if (area > best_area)
+        {
+            best_area = area;
+            best = i;
+        }
+    }
+    return best;
 }
 
