diff --git a/dlls/winemac.drv/cocoa_host.m b/dlls/winemac.drv/cocoa_host.m
--- a/dlls/winemac.drv/cocoa_host.m
+++ b/dlls/winemac.drv/cocoa_host.m
@@ -601,6 +601,44 @@
     rect_sent = TRUE;
     sent = msg;
     host_send(WMH_KIND_IME_RECT, &msg, sizeof(msg));
+}
+
+/* displays_get: the host's displays, in the protocol's space, the first
+ * primary and at the origin. Returns how many, or 0 when there's no answer
+ * to use, and the caller uses the real displays. A host that doesn't
+ * answer, or answers unsupported, isn't asked again by this process. */
+int host_get_displays(struct wmh_display *displays, int max)
+{
+    static BOOL unanswered;
+    struct wmh_reply_displays reply;
+    uint32_t status, count, i;
+
+    if (!host_mode || unanswered) return 0;
+    status = host_call(WMH_KIND_DISPLAYS_GET, NULL, 0, &reply, sizeof(reply));
+    if (status != WMH_STATUS_OK)
+    {
+        TRACE("host: displays_get status %u; using the real displays\n", status);
+        unanswered = TRUE;
+        return 0;
+    }
+    count = reply.count;
+    if (count > WMH_DISPLAYS_MAX) count = WMH_DISPLAYS_MAX;
+    if (count > max) count = max;
+    if (!count) return 0;
+    if (reply.displays[0].frame.x || reply.displays[0].frame.y)
+    {
+        WARN("host: the first display isn't at the origin (%g,%g); using the real displays\n",
+             reply.displays[0].frame.x, reply.displays[0].frame.y);
+        return 0;
+    }
+    for (i = 0; i < count; i++)
+    {
+        if (reply.displays[i].frame.width > 0 && reply.displays[i].frame.height > 0) continue;
+        WARN("host: display %u has no size; using the real displays\n", i);
+        return 0;
+    }
+    memcpy(displays, reply.displays, count * sizeof(*displays));
+    return count;
 }
 
