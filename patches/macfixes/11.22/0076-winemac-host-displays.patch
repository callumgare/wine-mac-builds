+/* Host mode: whether the primary display's current mode, which comes from
+   the host's display, has this size. Setting it changes nothing real. */
+static BOOL is_host_current_mode(const DEVMODEW *mode)
+{
+    struct macdrv_monitor *monitors;
+    int count;
+    BOOL ret = FALSE;
+
+    if (!host_mode) return FALSE;
+    if (macdrv_get_monitors(CGMainDisplayID(), &monitors, &count)) return FALSE;
+    if (count && monitors[0].from_host &&
+        mode->dmPelsWidth == CGRectGetWidth(monitors[0].rc_monitor) &&
+        mode->dmPelsHeight == CGRectGetHeight(monitors[0].rc_monitor))
+        ret = TRUE;
+    macdrv_free_monitors(monitors, count);
+    return ret;
 }
 
