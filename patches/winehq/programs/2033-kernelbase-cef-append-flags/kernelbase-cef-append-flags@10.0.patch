  * is matched (the end of its path, in any case), and only when the game's
@@ -602,6 +642,7 @@ BOOL WINAPI DECLSPEC_HOTPATCH CreateProcessInternalW( HANDLE token, const WCHAR
     RTL_USER_PROCESS_INFORMATION rtl_info;
     HANDLE parent = 0, debug = 0;
     ULONG nt_flags = 0;
+    const WCHAR *append;
     USHORT machine = 0;
     NTSTATUS status;
 
@@ -626,6 +667,21 @@ BOOL WINAPI DECLSPEC_HOTPATCH CreateProcessInternalW( HANDLE token, const WCHAR
         app_name = name;
     }
 
+    /* CROSSOVER HACK: see hack_append_command_line */
+    if ((append = hack_append_command_line( app_name, tidy_cmdline )))
+    {
+        WCHAR *new_cmdline = RtlAllocateHeap( GetProcessHeap(), 0,
+                                              sizeof(WCHAR) * (lstrlenW(tidy_cmdline) + lstrlenW(append) + 1) );
+        if (new_cmdline)
+        {
+            lstrcpyW( new_cmdline, tidy_cmdline );
+            lstrcatW( new_cmdline, append );
+            if (tidy_cmdline != cmd_line) RtlFreeHeap( GetProcessHeap(), 0, tidy_cmdline );
+            tidy_cmdline = new_cmdline;
+        }
+    }
+    /* end CROSSOVER HACK */
