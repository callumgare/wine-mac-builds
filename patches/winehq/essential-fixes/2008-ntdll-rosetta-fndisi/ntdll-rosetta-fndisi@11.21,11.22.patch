Summary: Rosetta 2: skip the obsolete x87 FNDISI instruction (WineHQ bug 56441)
Category: cpu
Kind: workaround
Origin: other
  Name: WineHQ bug 56441 attachment
  Authors: Brendan Shanks
  URL: https://bugs.winehq.org/show_bug.cgi?id=56441
  Note: "Patch to ignore FNDISI" (attachment 76358); also shipped by Gcenx
    (winehq-9.8 packages) and dblark/macos-wine-build
Origin: other
  Name: dblark/macos-wine-build
  Version: 71877c1
  URL: https://github.com/dblark/macos-wine-build
  Note: patches/0001-macos-hacks.patch (handle_fndisi, Wine 11.0-rc2 version)
  Changes: comment fixed (dblark's says "RDSSPD/RDSSPQ")
Upstream: no (bug 56441 closed NOTOURBUG: Apple fixed Rosetta in macOS 15)
Why: Rosetta raises #UD for the obsolete x87 FNDISI (DB E1), which real CPUs treat as a NOP; skip it. Checked after the CET handler and before XGETBV, as in 10.0_8. (Comment fixed: dblark's copy says "RDSSPD/RDSSPQ".)
Programs: DSDPlus 1.101 (32-bit): "Unhandled illegal instruction" at
 start on macOS 14 (WineHQ bug 56441)
Evidence: Sikarugir 10.0_8: ntdll.so: "handle_fndisi", "skipped FNDISI instruction"; segv_handler checks DB E1 between the CET and XGETBV checks
Port: to 11.21: handle_fndisi() is unchanged (dblark's Wine 11 copy has the same code); the segv_handler call goes through leave_handler() before returning, as in 0005.

diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index 02860fe..96b8535 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -1861,6 +1861,68 @@ static inline BOOL handle_cet_nop( ucontext_t *sigcontext, CONTEXT *context )
     return FALSE;
 }
 
+/***********************************************************************
+ *           handle_fndisi
+ *
+ * Check if the fault location is an x87 FNDISI instruction that should be treated as a NOP.
+ * Rosetta raises an invalid-opcode fault for it (WineHQ bug 56441).
+ */
+static inline BOOL handle_fndisi( ucontext_t *sigcontext, CONTEXT *context )
+{
+    BYTE instr[16];
+    unsigned int i, prefix_count = 0;
+    unsigned int len = virtual_uninterrupted_read_memory( (BYTE *)context->Rip, instr, sizeof(instr) );
+
+    for (i = 0; i < len; i++) switch (instr[i])
+    {
+    /* instruction prefixes */
+    case 0x2e:  /* %cs: */
+    case 0x36:  /* %ss: */
+    case 0x3e:  /* %ds: */
+    case 0x26:  /* %es: */
+    case 0x40:  /* rex */
+    case 0x41:  /* rex */
+    case 0x42:  /* rex */
+    case 0x43:  /* rex */
+    case 0x44:  /* rex */
+    case 0x45:  /* rex */
+    case 0x46:  /* rex */
+    case 0x47:  /* rex */
+    case 0x48:  /* rex */
+    case 0x49:  /* rex */
+    case 0x4a:  /* rex */
+    case 0x4b:  /* rex */
+    case 0x4c:  /* rex */
+    case 0x4d:  /* rex */
+    case 0x4e:  /* rex */
+    case 0x4f:  /* rex */
+    case 0x64:  /* %fs: */
+    case 0x65:  /* %gs: */
+    case 0x66:  /* opcode size */
+    case 0x67:  /* addr size */
+    case 0xf0:  /* lock */
+    case 0xf2:  /* repne */
+    case 0xf3:  /* repe */
+        if (++prefix_count >= 15) return FALSE;
+        continue;
+
+    case 0xdb:
+        if (i == len - 1) return 0;
+        switch (instr[i + 1])
+        {
+        case 0xe1:
+            /* FNDISI: (prefixes) DB E1 */
+            RIP_sig(sigcontext) += prefix_count + 2;
+            TRACE_(seh)( "skipped FNDISI instruction\n" );
+            return TRUE;
+        }
+        break;
+    default:
+        return FALSE;
+    }
+    return FALSE;
+}
+
 /***********************************************************************
  *           emulate_xgetbv
  *
@@ -2388,6 +2450,12 @@ static void segv_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
             leave_handler( data, sigcontext );
             return;
         }
+        /* WineHQ bug 56441 */
+        if (handle_fndisi( sigcontext, &context.c ))
+        {
+            leave_handler( data, sigcontext );
+            return;
+        }
         /* CW HACK 23427 */
         if (emulate_xgetbv( sigcontext, &context.c ))
         {
