Summary: Map executable file sections without PROT_EXEC, then add it (old 32-bit installers)
Category: cpu
Kind: workaround
Origin: crossover (ported here)
  Version: 25.1.1
  CW-Hacks: 22011
  URL: https://media.codeweavers.com/pub/crossover/source/crossover-sources-25.1.1.tar.gz
  Files: dlls/ntdll/unix/virtual.c
  Changes: when the mprotect fails, wine_mmap retries the original mmap
    (MAP_FIXED over the first mapping), so the failure reaches the caller's
    fallbacks; CrossOver returned the mapping without PROT_EXEC
  Note: wine_mmap, with CrossOver Hack #22011's utsname include (only the
    include is marked with the hack number). Sikarugir 10.0_8 ships it:
    ntdll.so has "failed to mprotect region: %d" and never logs the
    PROT_EXEC error in Second Chance's launches.
Upstream: partly (WineHQ 11.x maps file views without PROT_EXEC and sets the
 protection with mprotect afterwards, so only 10.0 needs this)
Why: In 10.0, a file view that asks for PROT_EXEC (any readable view when
 DEP is off, as for old 32-bit installers, and PE headers) is mapped with
 PROT_EXEC in the mmap call itself, and macOS can refuse that: every such
 section view failed ("failed to set PROT_EXEC on file map, noexec
 filesystem?" then "virtual_map_section mapping ... failed"), and
 InstallShield setups exited. Map without PROT_EXEC, then mprotect, as
 CrossOver did and Wine 11 does. Found by Second Chance's tests (Nancy
 Drew installers).
Programs: Nancy Drew installers (InstallShield): exit after "failed to set
 PROT_EXEC on file map"; Big Fish games (White Wolf): stop at the same error
 on plain 10.0
Messages: "failed to mprotect region: %d" (WARN, shown only with
 WINEDEBUG=warn+virtual)
Uncertain: which files macOS refuses PROT_EXEC for. Measured on macOS
 26.7.2 under Rosetta (native x86_64 probe): ordinary files map with
 PROT_EXEC directly, shared or private; for a quarantined file the first
 exec mmap waited on a Gatekeeper prompt. Why the paging-file and
 SEC_IMAGE views in tests/regress/map-exec-file-view fail on plain 10.0
 isn't established, nor whether mapping first avoids the Gatekeeper
 prompt.
Status: 10.0: 2026-11-26: falls back to the original mmap if the mprotect fails
 10.0: 2026-11-26: quick builds 20261126T013940 and T024442 (macOS 26.7.2,
 M1 Max): smoke and the regression suite passed

diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -62,6 +62,7 @@
 #if defined(__APPLE__)
 # include <mach/mach_init.h>
 # include <mach/mach_vm.h>
+# include <sys/utsname.h> /* CrossOver Hack #22011 */
 #endif
 
 #include "ntstatus.h"
@@ -1748,6 +1749,45 @@ static void mprotect_range( void *base, size_t size, B
         count = 0;
     }
     if (count) mprotect_exec( addr, count << page_shift, prot );
+}
+
+#ifdef __APPLE__
+static BOOL is_catalina_or_later(void)
+{
+    static int result = -1;
+    struct utsname name;
+    unsigned major, minor;
+
+    if (result == -1)
+    {
+        result = (uname(&name) == 0 &&
+                  sscanf(name.release, "%u.%u", &major, &minor) == 2 &&
+                  major >= 19 /* macOS 10.15 Catalina */);
+    }
+    return (result == 1) ? TRUE : FALSE;
+}
+#endif
+
+static void *wine_mmap(void *addr, size_t len, int prot, int flags, int fd, off_t offset)
+{
+#if defined(__APPLE__) && defined(__x86_64__)
+    // In Catalina-and-later, mapping files with execute permissions can make
+    // Gatekeeper prompt the user, or just fail outright.
+    if (!(flags & MAP_ANON) && fd >= 0 && prot & PROT_EXEC && is_catalina_or_later())
+    {
+        void *ret = mmap(addr, len, prot & ~PROT_EXEC, flags, fd, offset);
+
+        if (ret != MAP_FAILED && mprotect(ret, len, prot))
+        {
+            /* wine-mac-builds: fall back to the original call, so that a
+             * failure reaches the caller instead of a view without exec. */
+            WARN("failed to mprotect region: %d\n", errno);
+            return mmap(ret, len, prot, flags | MAP_FIXED, fd, offset);
+        }
+        return ret;
+    }
+#endif
+    return mmap(addr, len, prot, flags, fd, offset);
 }
 
 
@@ -2120,7 +2160,7 @@ static NTSTATUS map_file_into_view( struct file_view *
     /* only try mmap if media is not removable (or if we require write access) */
     if (!removable || (flags & MAP_SHARED))
     {
-        if (mmap( (char *)view->base + start, size, prot, flags, fd, offset ) != MAP_FAILED)
+        if (wine_mmap( (char *)view->base + start, size, prot, flags, fd, offset ) != MAP_FAILED)
             goto done;
 
         switch (errno)
@@ -2448,7 +2488,7 @@ static NTSTATUS map_pe_header( void *ptr, size_t size,
 
     if (!*removable)
     {
-        if (mmap( ptr, size, PROT_READ|PROT_WRITE|PROT_EXEC, MAP_FIXED|MAP_PRIVATE, fd, 0 ) != MAP_FAILED)
+        if (wine_mmap( ptr, size, PROT_READ|PROT_WRITE|PROT_EXEC, MAP_FIXED|MAP_PRIVATE, fd, 0 ) != MAP_FAILED)
             return STATUS_SUCCESS;
 
         switch (errno)
@@ -3952,7 +3992,7 @@ void virtual_map_user_shared_data(void)
         exit(1);
     }
     if ((res = server_get_unix_fd( section, 0, &fd, &needs_close, NULL, NULL )) ||
-        (user_shared_data != mmap( user_shared_data, page_size, PROT_READ, MAP_SHARED|MAP_FIXED, fd, 0 )))
+        (user_shared_data != wine_mmap( user_shared_data, page_size, PROT_READ, MAP_SHARED|MAP_FIXED, fd, 0 )))
     {
         ERR( "failed to remap the process USD: %d\n", res );
         exit(1);
