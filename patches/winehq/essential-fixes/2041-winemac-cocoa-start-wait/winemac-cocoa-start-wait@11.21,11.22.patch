Summary: Wait longer for the Cocoa app to start on a busy Mac
Category: system
Kind: fix
Origin: wine-mac-builds
  Note: written for wine-mac-builds (not in Sikarugir), after Second Chance's
    in-process helper that lengthens the same wait.
Upstream: no (candidate; draft in .local/bug-reports/). The bug is in WineHQ
 10.0 to master (2026-11-25) and in CrossOver 26.3.0.
Why: macdrv_start_cocoa_app waits 5 s for the main thread to turn into a
 Cocoa app. On a Mac with every core busy, under Rosetta, that can be
 missed: the process then has no display driver ("Failed to start Cocoa app
 main loop"). Worse, the startup info was on the waiting thread's stack and
 the run-loop source was only released, never invalidated, so when the main
 thread got to it later it read a dead frame and crashed. Now the info is on
 the heap, counted (the source holds a reference), the source is
 invalidated on timeout, and the wait is 60 s by default, set by
 CocoaStartTimeout (seconds, 1-3600) under HKCU\Software\Wine\Mac Driver
 (or the per-app key). Processes with no graphics session are still refused
 earlier, in macdrv_init, so SSH runs fail as fast as before.
Programs: none known
Port: to 11.21: same code; only the declarations' neighbours changed (11.x's macdrv_cocoa.h and macdrv_main.c use bool).
Status: built in macfixes-10.0-build2 and macfixes-11.21-build1; behaviour not yet tested on its own (2026-11-15).

diff --git a/dlls/winemac.drv/cocoa_main.m b/dlls/winemac.drv/cocoa_main.m
index e80aa93..1c14e85 100644
--- a/dlls/winemac.drv/cocoa_main.m
+++ b/dlls/winemac.drv/cocoa_main.m
@@ -44,8 +44,31 @@
     unsigned long long  tickcount;
     uint64_t            uptime_ns;
     BOOL                success;
+    int                 refs;
 };
 
+/* The startup info is shared by macdrv_start_cocoa_app and the run loop
+   source that runs run_cocoa_app on the main thread.  It's on the heap and
+   counted, because after a timeout the main thread may still run the source
+   later; with the info on the waiting thread's stack it then read a dead
+   frame and crashed. */
+static const void* startup_info_retain(const void* info)
+{
+    struct cocoa_app_startup_info* startup_info = (struct cocoa_app_startup_info*)info;
+    __atomic_add_fetch(&startup_info->refs, 1, __ATOMIC_SEQ_CST);
+    return info;
+}
+
+static void startup_info_release(const void* info)
+{
+    struct cocoa_app_startup_info* startup_info = (struct cocoa_app_startup_info*)info;
+    if (!__atomic_sub_fetch(&startup_info->refs, 1, __ATOMIC_SEQ_CST))
+    {
+        [startup_info->lock release];
+        free(startup_info);
+    }
+}
+
 
 /***********************************************************************
  *              run_cocoa_app
@@ -116,7 +139,7 @@ int macdrv_start_cocoa_app(unsigned long long tickcount)
 {
     int ret = -1;
     CFRunLoopSourceRef source;
-    struct cocoa_app_startup_info startup_info;
+    struct cocoa_app_startup_info* startup_info;
     uint64_t uptime_mach = mach_absolute_time();
     mach_timebase_info_data_t mach_timebase;
     NSDate* timeLimit;
@@ -128,35 +151,45 @@ int macdrv_start_cocoa_app(unsigned long long tickcount)
                              toTarget:[NSThread class]
                            withObject:nil];
 
-    startup_info.lock = [[NSConditionLock alloc] initWithCondition:COCOA_APP_NOT_RUNNING];
-    startup_info.tickcount = tickcount;
-    startup_info.success = FALSE;
+    if (!(startup_info = calloc(1, sizeof(*startup_info))))
+        return -1;
+    startup_info->refs = 1;
+    startup_info->lock = [[NSConditionLock alloc] initWithCondition:COCOA_APP_NOT_RUNNING];
+    startup_info->tickcount = tickcount;
+    startup_info->success = FALSE;
 
     mach_timebase_info(&mach_timebase);
-    startup_info.uptime_ns = uptime_mach * mach_timebase.numer / mach_timebase.denom;
+    startup_info->uptime_ns = uptime_mach * mach_timebase.numer / mach_timebase.denom;
 
-    timeLimit = [NSDate dateWithTimeIntervalSinceNow:5];
+    timeLimit = [NSDate dateWithTimeIntervalSinceNow:cocoa_start_timeout];
 
-    source_context.info = &startup_info;
+    source_context.info = startup_info;
+    source_context.retain = startup_info_retain;
+    source_context.release = startup_info_release;
     source_context.perform = run_cocoa_app;
     source = CFRunLoopSourceCreate(NULL, 0, &source_context);
 
-    if (source && startup_info.lock && timeLimit)
+    if (source && startup_info->lock && timeLimit)
     {
         CFRunLoopAddSource(CFRunLoopGetMain(), source, kCFRunLoopCommonModes);
         CFRunLoopSourceSignal(source);
         CFRunLoopWakeUp(CFRunLoopGetMain());
 
-        if ([startup_info.lock lockWhenCondition:COCOA_APP_RUNNING beforeDate:timeLimit])
+        if ([startup_info->lock lockWhenCondition:COCOA_APP_RUNNING beforeDate:timeLimit])
+        {
+            [startup_info->lock unlock];
+            ret = !startup_info->success;
+        }
+        else
         {
-            [startup_info.lock unlock];
-            ret = !startup_info.success;
+            /* Timed out: make sure the main thread never runs it now. */
+            CFRunLoopSourceInvalidate(source);
         }
     }
 
     if (source)
         CFRelease(source);
-    [startup_info.lock release];
+    startup_info_release(startup_info);
     return ret;
 }
 }
