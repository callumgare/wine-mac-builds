+/***********************************************************************
+ *           sikarugir_append_command_line
+ *
+ * Sikarugir: append the value CommandLineAppend (REG_SZ or REG_EXPAND_SZ)
+ * from HKCU\Software\Wine\AppDefaults\<exe name> to the command line of a
+ * new process. Returns a newly allocated command line, or NULL if there is
+ * nothing to append.
+ */
+static WCHAR *sikarugir_append_command_line( const WCHAR *app_name, const WCHAR *cmd_line )
+{
+    WCHAR key_name[300], append[1024], expanded[1024], *ret;
+    const WCHAR *p, *exe = app_name;
+    DWORD type, size = sizeof(append);
+    LSTATUS res;
+    HKEY key;
+    int len;
+
+    for (p = app_name; *p; p++) if (*p == '\\' || *p == '/') exe = p + 1;
+    if (!*exe || lstrlenW( exe ) >= MAX_PATH) return NULL;
+
+    swprintf( key_name, ARRAY_SIZE(key_name), L"Software\\Wine\\AppDefaults\\%s", exe );
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, key_name, 0, KEY_QUERY_VALUE, &key )) return NULL;
+    res = RegQueryValueExW( key, L"CommandLineAppend", NULL, &type, (BYTE *)append, &size );
+    RegCloseKey( key );
+    if (res || (type != REG_SZ && type != REG_EXPAND_SZ) || size < sizeof(WCHAR)) return NULL;
+    append[ARRAY_SIZE(append) - 1] = 0;
+    if (type == REG_EXPAND_SZ)
+    {
+        size = ExpandEnvironmentStringsW( append, expanded, ARRAY_SIZE(expanded) );
+        if (!size || size > ARRAY_SIZE(expanded)) return NULL;
+        lstrcpyW( append, expanded );
+    }
+    if (!append[0]) return NULL;
+
+    len = lstrlenW( cmd_line ) + 1 + lstrlenW( append ) + 1;
+    if (!(ret = RtlAllocateHeap( GetProcessHeap(), 0, len * sizeof(WCHAR) ))) return NULL;
+    swprintf( ret, len, L"%s %s", cmd_line, append );
+    FIXME( "Sikarugir: appended %s to the command line of %s\n", debugstr_w(append), debugstr_w(exe) );
+    return ret;
+}
+
