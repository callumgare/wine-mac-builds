     {
-        path = strdup(path);
-        for (p = strtok( path, ":" ); p; p = strtok( NULL, ":" )) dll_paths[count++] = strdup( p );
-        free( path );
+        if (!renderer_paths[i] || !renderer_paths[i][strspn( renderer_paths[i], ":" )]) continue;
+        if (!use_renderer_dll_path( i )) continue;
