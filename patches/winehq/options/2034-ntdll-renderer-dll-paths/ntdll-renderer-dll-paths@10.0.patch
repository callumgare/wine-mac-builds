+        "EpicGamesLauncher.exe",
+        "EpicWebHelper.exe",
+        "EOSOverlayRenderer-Win32-Shipping.exe",
+        "EOSOverlayRenderer-Win64-Shipping.exe",
+        "GalaxyClient.exe",
+        "GalaxyClient Helper.exe",
+        "GOG Galaxy Notifications Renderer.exe",
+        "Rockstar Games\\Launcher\\Launcher.exe",
+        "Rockstar Games\\Social Club\\SocialClubHelper.exe",
+        "steamwebhelper.exe",
+        "gameoverlayui.exe",
+        "gameoverlayui64.exe",
+        "UbisoftConnect.exe",
+        "UplayWebCore.exe",
+        "UpcElevationService.exe",
+    };
+    unsigned int i;
+
+    if (main_argc < 2) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(launchers); i++)
+        if (strstr( main_argv[1], launchers[i] )) return TRUE;
+    return FALSE;
+}
+
+/* Sikarugir: per-renderer DLL directories, searched before the builtin ones */
+static const struct
+{
+    const char *var;
+    BOOL skip_for_launchers;
+} renderer_dll_paths[] =
+{
+    { "WINEDLLPATH_D3DMETAL", TRUE },
+    { "WINEDLLPATH_CNCD",     FALSE },
+    { "WINEDLLPATH_D9VK",     TRUE },
+    { "WINEDLLPATH_DXVK",     TRUE },
+    { "WINEDLLPATH_DXMT",     FALSE },
+};
+
+static BOOL use_renderer_dll_path( unsigned int idx )
+{
+    if (renderer_dll_paths[idx].skip_for_launchers && is_launcher_process()) return FALSE;
+    return TRUE;
+}
+
+static unsigned int count_path_list( const char *path )
+{
+    unsigned int count = 1;
+
+    for (; *path; path++) if (*path == ':') count++;
+    return count;
+}
+
+static unsigned int add_dll_path_list( unsigned int count, const char *list )
+{
+    char *p, *path = strdup( list );
+
+    for (p = strtok( path, ":" ); p; p = strtok( NULL, ":" )) dll_paths[count++] = strdup( p );
+    free( path );
+    return count;
+}
