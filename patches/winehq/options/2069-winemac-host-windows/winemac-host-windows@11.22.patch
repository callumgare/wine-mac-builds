+/*
+ * MACDRV host mode: windows shown by another, native application
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ *
+ * Copyright 2026 Callum Gare
+ */
+
+#import <AppKit/AppKit.h>
+#include "macdrv_cocoa.h"
+#include "wmh_protocol.h"
+
+@class WineEventQueue;
+
+/* In host mode, a Win32 window's Cocoa side is one of these, cast to
+ * WineWindow*. It has no NSWindow: the host shows it. */
+@interface WineHostWindow : NSObject
+{
+@public
+    uint32_t        wid;
+    void           *hwnd;
+    WineEventQueue *queue;
+    CGRect          frame;
+    NSMutableArray *surfaces;       /* WineHostSurface, all the same size */
+    uint32_t        sent_features, sent_state;  /* the last sent, to skip repeats */
+    BOOL            state_sent, parent_sent;
+    uint32_t        sent_parent;
+    BOOL            min_max_sent;
+    struct wmh_window_min_max sent_min_max;
+}
+@property (readonly, nonatomic) WineEventQueue* queue;
+@end
+
+extern WineWindow *host_create_window(const struct macdrv_window_features *wf, CGRect frame,
+                                      void *hwnd, WineEventQueue *queue);
+extern void host_destroy_window(WineWindow *window);
+extern void host_set_window_features(WineWindow *window, const struct macdrv_window_features *wf);
+extern void host_set_window_state(WineWindow *window, const struct macdrv_window_state *state);
+extern void host_set_window_title(WineWindow *window, const UniChar *title, size_t length);
+extern void host_order_window(WineWindow *window, WineWindow *prev, WineWindow *next, bool activate);
+extern void host_hide_window(WineWindow *window);
+extern void host_set_window_frame(WineWindow *window, const CGRect *frame);
+extern void host_get_window_frame(WineWindow *window, CGRect *frame);
+extern void host_set_parent_window(WineWindow *window, WineWindow *parent);
+extern void host_window_set_io_surface(WineWindow *window, IOSurfaceRef surface, CGRect rect, CGRect dirty);
+extern void host_give_window_focus(WineWindow *window, bool activate);
+extern void host_set_window_min_max(WineWindow *window, CGSize min_size, CGSize max_size);
+extern void host_window_rejected_focus(WineWindow *window);
+extern void host_query_done(macdrv_query *query);
+extern bool host_send_keydown_to_input_source(int keyc, unsigned int flags, int repeat, void *update);
+extern void host_clear_ime_text(void);
+extern void host_set_cursor(CFStringRef name, CFArrayRef frames);
+extern int host_get_cursor_position(CGPoint *pos);
+extern int host_set_cursor_position(CGPoint pos);
+extern int host_clip_cursor(CGRect rect);
diff --git a/dlls/winemac.drv/cocoa_host.m b/dlls/winemac.drv/cocoa_host.m
new file mode 100644
index 0000000..aba2082
--- /dev/null
+++ b/dlls/winemac.drv/cocoa_host.m
@@ -0,0 +1,1438 @@
+/*
+ * MACDRV host mode: windows shown by another, native application
+ *
+ * With HostWindows on and WINEMAC_HOST_SERVICE naming a host, the driver
+ * gives its windows to that host over Mach messages instead of making
+ * NSWindows: it sends each window's pictures as IOSurfaces, and the host
+ * sends input back. The protocol is docs/app-embedded-protocol.md in
+ * wine-mac-builds; the wire format is wmh_protocol.h.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ *
+ * Copyright 2026 Callum Gare
+ */
+
+#import "config.h"
+#import "macdrv.h"
+
+#include <mach/mach.h>
+#include <servers/bootstrap.h>
+#include <pthread.h>
+#include <sys/time.h>
+#import <IOSurface/IOSurfaceRef.h>
+
+#import "cocoa_app.h"
+#import "cocoa_event.h"
+#import "cocoa_host.h"
+#include "wmh_protocol.h"
+
+#pragma GCC diagnostic ignored "-Wdeclaration-after-statement"
+
+WINE_DEFAULT_DEBUG_CHANNEL(macdrv);
+
+bool host_mode = false;
+
+static mach_port_t host_port = MACH_PORT_NULL;     /* send right to the host's service */
+static mach_port_t driver_port = MACH_PORT_NULL;   /* our receive right */
+static uint32_t host_features;
+
+static pthread_mutex_t host_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t surface_released = PTHREAD_COND_INITIALIZER;
+static NSMutableDictionary *windows_by_id;         /* NSNumber -> WineHostWindow */
+static NSMutableDictionary *views_by_id;           /* NSNumber -> WineHostView */
+static uint32_t next_view_id = 1;
+static uint32_t next_window_id = 1, next_surface_id = 1;
+static CGPoint pointer;                             /* where the host last said the pointer is */
+static CFTypeRef sent_cursor;                       /* the name or frames last sent, retained */
+
+#define SEND_TIMEOUT_MS 1000
+#define CALL_TIMEOUT_MS 2000
+
+static struct wmh_rect wmh_rect_from(CGRect r);
+
+/* Calls waiting for the host's reply (host_call). */
+struct pending_call
+{
+    uint32_t             serial;
+    void                *reply;
+    size_t               reply_size;
+    uint32_t             status;
+    BOOL                 done;
+    struct pending_call *next;
+};
+static pthread_mutex_t call_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t call_cond = PTHREAD_COND_INITIALIZER;
+static struct pending_call *pending_calls;
+static uint32_t next_call_serial = 1;
+
+/* The plain driver's keyboard-change handler; force skips its input context check. */
+@interface WineApplicationController (HostKeyboard)
+- (void) keyboardSelectionDidChange:(BOOL)force;
+@end
+#define MAX_SURFACES_PER_WINDOW 3
+
+
+/* An IOSurface registered with the host. */
+@interface WineHostSurface : NSObject
+{
+@public
+    uint32_t     sid;
+    IOSurfaceRef surface;
+    BOOL         with_host;     /* sent in a frame, not released yet */
+}
+@end
+
+@implementation WineHostSurface
+    - (void) dealloc
+    {
+        if (surface) CFRelease(surface);
+        [super dealloc];
+    }
+@end
+
+
+/* An OpenGL region of a window (a client surface). */
+@interface WineHostView : NSObject
+{
+@public
+    uint32_t        vid;
+    NSMutableArray *surfaces;       /* WineHostSurface */
+    uint32_t        sent_window;    /* the last view_frame and view_hidden sent */
+    CGRect          sent_frame;
+    int             sent_hidden;    /* -1: none yet */
+}
+@end
+
+@implementation WineHostView
+    - (void) dealloc
+    {
+        [surfaces release];
+        [super dealloc];
+    }
+@end
+
+
+@implementation WineHostWindow
+    @synthesize queue;
+
+    - (void) dealloc
+    {
+        [surfaces release];
+        [queue release];
+        [super dealloc];
+    }
+@end
+
+
+/***********************************************************************
+ *              sending
+ */
+struct plain_message
+{
+    mach_msg_header_t head;
+    struct wmh_header wmh;
+    char payload[];
+};
+
+struct port_message
+{
+    mach_msg_header_t head;
+    mach_msg_body_t body;
+    mach_msg_port_descriptor_t port;
+    struct wmh_header wmh;
+    char payload[];
+};
+
+static BOOL host_send_serial(uint32_t kind, uint32_t serial, const void *payload, size_t size)
+{
+    char buffer[sizeof(struct plain_message) + 1024];
+    struct plain_message *msg = (struct plain_message *)buffer;
+    kern_return_t kr;
+
+    if (host_port == MACH_PORT_NULL) return FALSE;
+    if (size > 1024) return FALSE;
+    memset(msg, 0, sizeof(*msg));
+    msg->head.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_COPY_SEND, 0);
+    msg->head.msgh_size = (sizeof(*msg) + size + 3) & ~3;
+    msg->head.msgh_remote_port = host_port;
+    msg->head.msgh_id = WMH_MSG_ID;
+    msg->wmh.kind = kind;
+    msg->wmh.serial = serial;
+    if (size) memcpy(msg->payload, payload, size);
+    memset(msg->payload + size, 0, msg->head.msgh_size - sizeof(*msg) - size);
+
+    kr = mach_msg(&msg->head, MACH_SEND_MSG | MACH_SEND_TIMEOUT, msg->head.msgh_size, 0,
+                  MACH_PORT_NULL, SEND_TIMEOUT_MS, MACH_PORT_NULL);
+    if (kr != KERN_SUCCESS)
+    {
+        WARN("host: sending kind %u failed: %s (%x)\n", kind, mach_error_string(kr), kr);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL host_send(uint32_t kind, const void *payload, size_t size)
+{
+    return host_send_serial(kind, 0, payload, size);
+}
+
+/* Send a call and wait for its reply. Returns WMH_STATUS_*; on OK, reply
+ * holds the reply struct (zero-filled past what the host sent). A host that
+ * doesn't answer in time gets WMH_STATUS_FAILED, and the caller uses its
+ * fallback. */
+static uint32_t host_call(uint32_t kind, const void *payload, size_t size, void *reply, size_t reply_size)
+{
+    struct pending_call call = { 0 }, **p;
+    struct timespec deadline;
+    struct timeval now;
+
+    memset(reply, 0, reply_size);
+    call.reply = reply;
+    call.reply_size = reply_size;
+    call.status = WMH_STATUS_FAILED;
+
+    pthread_mutex_lock(&call_lock);
+    call.serial = next_call_serial++;
+    if (!next_call_serial) next_call_serial = 1;
+    call.next = pending_calls;
+    pending_calls = &call;
+    pthread_mutex_unlock(&call_lock);
+
+    if (host_send_serial(kind, call.serial, payload, size))
+    {
+        gettimeofday(&now, NULL);
+        deadline.tv_sec = now.tv_sec + CALL_TIMEOUT_MS / 1000;
+        deadline.tv_nsec = now.tv_usec * 1000 + (CALL_TIMEOUT_MS % 1000) * 1000000;
+        if (deadline.tv_nsec >= 1000000000) { deadline.tv_sec++; deadline.tv_nsec -= 1000000000; }
+        pthread_mutex_lock(&call_lock);
+        while (!call.done)
+            if (pthread_cond_timedwait(&call_cond, &call_lock, &deadline)) break;
+        if (!call.done) WARN("host: call kind %u (serial %u) timed out\n", kind, call.serial);
+    }
+    else pthread_mutex_lock(&call_lock);
+
+    for (p = &pending_calls; *p; p = &(*p)->next)
+        if (*p == &call) { *p = call.next; break; }
+    pthread_mutex_unlock(&call_lock);
+    return call.done ? call.status : WMH_STATUS_FAILED;
+}
+
+/* On the receive thread: hand a reply to the call waiting for it. */
+static void reply_received(uint32_t serial, const struct wmh_reply *reply, size_t size)
+{
+    struct pending_call *call;
+
+    pthread_mutex_lock(&call_lock);
+    for (call = pending_calls; call; call = call->next)
+    {
+        if (call->serial != serial || call->done) continue;
+        call->status = reply->status;
+        if (reply->status == WMH_STATUS_OK)
+        {
+            size_t n = size - sizeof(*reply);
+            memcpy(call->reply, reply + 1, n < call->reply_size ? n : call->reply_size);
+        }
+        call->done = TRUE;
+        pthread_cond_broadcast(&call_cond);
+        break;
+    }
+    pthread_mutex_unlock(&call_lock);
+    if (!call) TRACE("host: reply for no call (serial %u)\n", serial);
+}
+
+/* disposition: MACH_MSG_TYPE_MAKE_SEND for our own receive right,
+   MACH_MSG_TYPE_MOVE_SEND for a send right we hand over. */
+static BOOL host_send_port(uint32_t kind, mach_port_t port, mach_msg_type_name_t disposition,
+                              const void *payload, size_t size)
+{
+    char buffer[sizeof(struct port_message) + 512];
+    struct port_message *msg = (struct port_message *)buffer;
+    kern_return_t kr;
+
+    if (host_port == MACH_PORT_NULL || size > 512) return FALSE;
+    memset(msg, 0, sizeof(*msg));
+    msg->head.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_COPY_SEND, 0) | MACH_MSGH_BITS_COMPLEX;
+    msg->head.msgh_size = (sizeof(*msg) + size + 3) & ~3;
+    msg->head.msgh_remote_port = host_port;
+    msg->head.msgh_id = WMH_MSG_ID;
+    msg->body.msgh_descriptor_count = 1;
+    msg->port.name = port;
+    msg->port.disposition = disposition;
+    msg->port.type = MACH_MSG_PORT_DESCRIPTOR;
+    msg->wmh.kind = kind;
+    memcpy(msg->payload, payload, size);
+
+    kr = mach_msg(&msg->head, MACH_SEND_MSG | MACH_SEND_TIMEOUT, msg->head.msgh_size, 0,
+                  MACH_PORT_NULL, SEND_TIMEOUT_MS, MACH_PORT_NULL);
+    if (kr != KERN_SUCCESS)
+    {
+        WARN("host: sending kind %u failed: %s (%x)\n", kind, mach_error_string(kr), kr);
+        /* A moved right wasn't consumed; drop it. */
+        if (disposition == MACH_MSG_TYPE_MOVE_SEND) mach_port_deallocate(mach_task_self(), port);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+
+/***********************************************************************
+ *              receiving
+ */
+struct received_message
+{
+    mach_msg_header_t head;
+    char data[4096];
+};
+
+/* The inline data of a received message, after any descriptors. */
+static const struct wmh_header *message_body(const struct received_message *msg, size_t *size)
+{
+    const char *p = (const char *)&msg->head + sizeof(mach_msg_header_t);
+    const char *end = (const char *)&msg->head + msg->head.msgh_size;
+
+    if (msg->head.msgh_bits & MACH_MSGH_BITS_COMPLEX)
+    {
+        const mach_msg_body_t *body = (const mach_msg_body_t *)p;
+        p += sizeof(*body) + body->msgh_descriptor_count * sizeof(mach_msg_port_descriptor_t);
+    }
+    if (p + sizeof(struct wmh_header) > end) return NULL;
+    *size = end - p - sizeof(struct wmh_header);
+    return (const struct wmh_header *)p;
+}
+
+static WineHostWindow *window_for_id(uint32_t wid)
+{
+    WineHostWindow *window;
+
+    pthread_mutex_lock(&host_lock);
+    window = [[windows_by_id objectForKey:@(wid)] retain];
+    pthread_mutex_unlock(&host_lock);
+    return [window autorelease];
+}
+
+/* Written by the receive thread, read by others: under host_lock. */
+static void set_pointer(CGPoint pos)
+{
+    pthread_mutex_lock(&host_lock);
+    pointer = pos;
+    pthread_mutex_unlock(&host_lock);
+}
+
+static unsigned long event_time_ms(double seconds)
+{
+    if (seconds > 0) return (unsigned long)(seconds * 1000.0);
+    return (unsigned long)([[NSProcessInfo processInfo] systemUptime] * 1000.0);
+}
+
+static void post_event(const struct wmh_event *ev, uint32_t serial)
+{
+    static const int types[] = {
+        [WMH_EV_KEY_PRESS] = KEY_PRESS + 1, [WMH_EV_KEY_RELEASE] = KEY_RELEASE + 1,
+        [WMH_EV_MOUSE_BUTTON] = MOUSE_BUTTON + 1, [WMH_EV_MOUSE_MOVED_ABSOLUTE] = MOUSE_MOVED_ABSOLUTE + 1,
+        [WMH_EV_MOUSE_MOVED_RELATIVE] = MOUSE_MOVED_RELATIVE + 1, [WMH_EV_MOUSE_SCROLL] = MOUSE_SCROLL + 1,
+        [WMH_EV_WINDOW_GOT_FOCUS] = WINDOW_GOT_FOCUS + 1, [WMH_EV_WINDOW_LOST_FOCUS] = WINDOW_LOST_FOCUS + 1,
+        [WMH_EV_APP_DEACTIVATED] = APP_DEACTIVATED + 1, [WMH_EV_WINDOW_BROUGHT_FORWARD] = WINDOW_BROUGHT_FORWARD + 1,
+        [WMH_EV_RELEASE_CAPTURE] = RELEASE_CAPTURE + 1, [WMH_EV_WINDOW_CLOSE_REQUESTED] = WINDOW_CLOSE_REQUESTED + 1,
+        [WMH_EV_WINDOW_FRAME_CHANGED] = WINDOW_FRAME_CHANGED + 1, [WMH_EV_WINDOW_RESIZE_ENDED] = WINDOW_RESIZE_ENDED + 1,
+        [WMH_EV_WINDOW_DID_UNMINIMIZE] = WINDOW_DID_UNMINIMIZE + 1,
+        [WMH_EV_WINDOW_RESTORE_REQUESTED] = WINDOW_RESTORE_REQUESTED + 1,
+        [WMH_EV_REASSERT_WINDOW_POSITION] = REASSERT_WINDOW_POSITION + 1,
+        [WMH_EV_APP_QUIT_REQUESTED] = APP_QUIT_REQUESTED + 1, [WMH_EV_DISPLAYS_CHANGED] = DISPLAYS_CHANGED + 1,
+    };
+    WineHostWindow *window = nil;
+    macdrv_event *event;
+    unsigned long time_ms = event_time_ms(ev->time);
+    int type;
+
+    /* Queries are posted without waiting: the answer goes back as messages. */
+    if (ev->type == WMH_EV_QUERY_MIN_MAX_INFO || ev->type == WMH_EV_QUERY_RESIZE_START)
+    {
+        macdrv_query *query;
+
+        if (!(window = window_for_id(ev->window))) return;
+        query = macdrv_create_query();
+        query->type = ev->type == WMH_EV_QUERY_MIN_MAX_INFO ? QUERY_MIN_MAX_INFO : QUERY_RESIZE_START;
+        query->window = (WineWindow *)[window retain];
+        event = macdrv_create_event(QUERY_EVENT, (WineWindow *)window);
+        event->query_event.query = macdrv_retain_query(query);
+        [window->queue postEvent:event];
+        macdrv_release_event(event);
+        macdrv_release_query(query);
+        return;
+    }
+
+    /* The plain driver's windowWillResize:toSize: query: the program's
+     * WM_SIZING may change the frame; host_query_done sends it back. */
+    if (ev->type == WMH_EV_QUERY_RESIZE_SIZE)
+    {
+        CGRect frame = CGRectMake(ev->frame.x, ev->frame.y, ev->frame.width, ev->frame.height);
+        macdrv_query *query;
+
+        if (!serial) return;
+        if (ev->flags < WMH_WMSZ_LEFT || ev->flags > WMH_WMSZ_BOTTOMRIGHT || !(window = window_for_id(ev->window)))
+        {
+            struct wmh_resize_size_reply reply = { serial, 0, ev->frame };
+
+            TRACE("host: refusing resize size for window %u edge %u\n", ev->window, ev->flags);
+            host_send(WMH_KIND_RESIZE_SIZE_REPLY, &reply, sizeof(reply));
+            return;
+        }
+        query = macdrv_create_query();
+        query->type = QUERY_RESIZE_SIZE;
+        query->window = (WineWindow *)[window retain];
+        query->host_serial = serial;
+        query->resize_size.rect = frame;
+        query->resize_size.edge = ev->flags;
+        event = macdrv_create_event(QUERY_EVENT, (WineWindow *)window);
+        event->query_event.query = macdrv_retain_query(query);
+        [window->queue postEvent:event];
+        macdrv_release_event(event);
+        macdrv_release_query(query);
+        return;
+    }
+
+    /* The input source changed: the driver reads the new one itself, as the
+     * plain driver does when macOS tells it (which it doesn't in host mode:
+     * the process has no text input context). */
+    if (ev->type == WMH_EV_KEYBOARD_CHANGED)
+    {
+        dispatch_async(dispatch_get_main_queue(), ^{
+            [[WineApplicationController sharedController] keyboardSelectionDidChange:YES];
+        });
+        return;
+    }
+
+    /* The user asked to minimize or zoom: the program decides, and its answer
+     * comes back as window_state and frames. The plain driver calls these on
+     * the main thread, from NSWindow's miniaturize: and
+     * windowShouldZoom:toFrame:. They call win32u, which this thread can't. */
+    if (ev->type == WMH_EV_WINDOW_MINIMIZE_REQUESTED || ev->type == WMH_EV_WINDOW_MAXIMIZE_REQUESTED)
+    {
+        void *hwnd;
+        BOOL minimize = ev->type == WMH_EV_WINDOW_MINIMIZE_REQUESTED;
+
+        if (!(window = window_for_id(ev->window))) return;
+        hwnd = window->hwnd;
+        dispatch_async(dispatch_get_main_queue(), ^{
+            if (minimize) macdrv_window_minimize_requested(hwnd);
+            else macdrv_window_maximize_requested(hwnd);
+        });
+        return;
+    }
+
+    /* The table holds macdrv's type + 1, so an unset slot is 0. */
+    if (ev->type >= sizeof(types) / sizeof(types[0]) || !types[ev->type])
+    {
+        TRACE("host: ignoring event type %u\n", ev->type);
+        return;
+    }
+    type = types[ev->type] - 1;
+
+    if (ev->window && !(window = window_for_id(ev->window)))
+    {
+        TRACE("host: event %u for unknown window %u\n", ev->type, ev->window);
+        return;
+    }
+
+
+    event = macdrv_create_event(type, (WineWindow *)window);
+    switch (type)
+    {
+    case KEY_PRESS:
+    case KEY_RELEASE:
+        event->key.keycode = ev->keycode;
+        event->key.modifiers = ev->modifiers;
+        event->key.time_ms = time_ms;
+        break;
+    case MOUSE_BUTTON:
+        set_pointer(CGPointMake(ev->x, ev->y));
+        event->mouse_button.button = ev->button;
+        event->mouse_button.pressed = ev->pressed != 0;
+        event->mouse_button.x = floor(ev->x);
+        event->mouse_button.y = floor(ev->y);
+        event->mouse_button.time_ms = time_ms;
+        break;
+    case MOUSE_MOVED_ABSOLUTE:
+    case MOUSE_MOVED_RELATIVE:
+        if (type == MOUSE_MOVED_ABSOLUTE) set_pointer(CGPointMake(ev->x, ev->y));
+        event->mouse_moved.x = floor(ev->x);
+        event->mouse_moved.y = floor(ev->y);
+        event->mouse_moved.drag = ev->pressed != 0;
+        event->mouse_moved.time_ms = time_ms;
+        break;
+    case MOUSE_SCROLL:
+        event->mouse_scroll.x_scroll = ev->scroll_x;
+        event->mouse_scroll.y_scroll = ev->scroll_y;
+        event->mouse_scroll.x = floor(ev->x);
+        event->mouse_scroll.y = floor(ev->y);
+        event->mouse_scroll.time_ms = time_ms;
+        break;
+    case WINDOW_GOT_FOCUS:
+        event->window_got_focus.serial = 0;
+        event->window_got_focus.tried_windows = NULL;
+        break;
+    case WINDOW_FRAME_CHANGED:
+        event->window_frame_changed.frame = CGRectMake(ev->frame.x, ev->frame.y, ev->frame.width, ev->frame.height);
+        event->window_frame_changed.fullscreen = (ev->flags & WMH_FRAME_FULLSCREEN) != 0;
+        event->window_frame_changed.in_resize = (ev->flags & WMH_FRAME_IN_RESIZE) != 0;
+        event->window_frame_changed.skip_size_move_loop = (ev->flags & WMH_FRAME_SKIP_SIZE_MOVE_LOOP) != 0;
+        if (window)
+        {
+            pthread_mutex_lock(&host_lock);
+            window->frame = event->window_frame_changed.frame;
+            pthread_mutex_unlock(&host_lock);
+        }
+        break;
+    case WINDOW_RESTORE_REQUESTED:
+        event->window_restore_requested.keep_frame = (ev->flags & 1) != 0;
+        event->window_restore_requested.frame = CGRectMake(ev->frame.x, ev->frame.y, ev->frame.width, ev->frame.height);
+        break;
+    case APP_QUIT_REQUESTED:
+        event->deliver = 1;
+        event->app_quit_requested.reason = ev->reason;
+        break;
+    case DISPLAYS_CHANGED:
+        event->displays_changed.activating = false;
+        break;
+    }
+
+    if (window)
+        [window->queue postEvent:event];
+    else
+        macdrv_host_post_app_event(event);
+    macdrv_release_event(event);
+}
+
+static void surface_was_released(uint32_t sid)
+{
+    pthread_mutex_lock(&host_lock);
+    NSMutableArray *pools = [NSMutableArray array];
+
+    for (WineHostWindow *window in [windows_by_id objectEnumerator]) [pools addObject:window->surfaces];
+    for (WineHostView *view in [views_by_id objectEnumerator]) [pools addObject:view->surfaces];
+    for (NSMutableArray *pool in pools)
+    {
+        for (WineHostSurface *s in pool)
+        {
+            if (s->sid == sid)
+            {
+                s->with_host = NO;
+                pthread_cond_broadcast(&surface_released);
+                pthread_mutex_unlock(&host_lock);
+                return;
+            }
+        }
+    }
+    pthread_mutex_unlock(&host_lock);
+}
+
+static void host_lost(void)
+{
+    macdrv_event *event;
+
+    ERR("host: the host has gone away; asking the program to quit\n");
+    event = macdrv_create_event(APP_QUIT_REQUESTED, nil);
+    event->deliver = 1;
+    event->app_quit_requested.reason = QUIT_REASON_LOGOUT;
+    macdrv_host_post_app_event(event);
+    macdrv_release_event(event);
+}
+
+/* A drag step from the host becomes the query the plain driver's
+ * NSDraggingDestination methods make, posted to the window's queue in
+ * order with its events; host_query_done answers it. */
+static void post_drag(const struct wmh_drag *drag, uint32_t serial)
+{
+    static const int types[] = {
+        [WMH_DRAG_ENTER] = QUERY_DRAG_DROP_ENTER, [WMH_DRAG_UPDATE] = QUERY_DRAG_DROP_DRAG,
+        [WMH_DRAG_LEAVE] = QUERY_DRAG_DROP_LEAVE, [WMH_DRAG_DROP] = QUERY_DRAG_DROP_DROP,
+    };
+    struct wmh_drag_done done = { serial, 0, 0, 0 };
+    WineHostWindow *window;
+    macdrv_query *query;
+    macdrv_event *event;
+
+    if (!serial || drag->type < WMH_DRAG_ENTER || drag->type > WMH_DRAG_DROP || !(window = window_for_id(drag->window)))
+    {
+        TRACE("host: refusing drag type %u for window %u\n", drag->type, drag->window);
+        host_send(WMH_KIND_DRAG_DONE, &done, sizeof(done));
+        return;
+    }
+
+    query = macdrv_create_query();
+    query->type = types[drag->type];
+    query->window = (WineWindow *)[window retain];
+    query->host_serial = serial;
+    query->drag_drop.x = floor(drag->x);
+    query->drag_drop.y = floor(drag->y);
+    query->drag_drop.ops = drag->ops;
+    if (drag->type == WMH_DRAG_ENTER)
+    {
+        char name[WMH_PASTEBOARD_NAME_MAX + 1];
+        NSString *str;
+
+        memcpy(name, drag->pasteboard, WMH_PASTEBOARD_NAME_MAX);
+        name[WMH_PASTEBOARD_NAME_MAX] = 0;
+        if (name[0] && (str = [NSString stringWithUTF8String:name]))
+            query->drag_drop.pasteboard = (CFTypeRef)[[NSPasteboard pasteboardWithName:str] retain];
+        if (!query->drag_drop.pasteboard)
+        {
+            macdrv_release_query(query);
+            host_send(WMH_KIND_DRAG_DONE, &done, sizeof(done));
+            return;
+        }
+    }
+
+    event = macdrv_create_event(QUERY_EVENT, (WineWindow *)window);
+    event->query_event.query = macdrv_retain_query(query);
+    [window->queue postEvent:event];
+    macdrv_release_event(event);
+    macdrv_release_query(query);
+}
+
+/***********************************************************************
+ *              input methods
+ *
+ * The host's text input context does the input method's work; see
+ * wmh_protocol.h. These stand in for macdrv_send_keydown_to_input_source,
+ * macdrv_clear_ime_text and SetIMECompositionRect.
+ */
+bool host_send_keydown_to_input_source(int keyc, unsigned int flags, int repeat, void *update)
+{
+    struct wmh_ime_key key = { keyc, flags, repeat ? 1 : 0, 0 };
+    struct wmh_reply_ime_key *reply = malloc(sizeof(*reply));
+    WineHostWindow *window;
+    bool handled = false;
+    uint32_t i, count;
+
+    if (!reply) return false;
+    if (host_call(WMH_KIND_IME_KEY, &key, sizeof(key), reply, sizeof(*reply)) == WMH_STATUS_OK &&
+        (window = window_for_id(reply->window)))
+    {
+        count = reply->count < WMH_IME_TEXTS_MAX ? reply->count : WMH_IME_TEXTS_MAX;
+        for (i = 0; i < count; i++)
+        {
+            const struct wmh_ime_text *t = &reply->texts[i];
+            CFStringRef str = CFStringCreateWithCharacters(NULL, (const UniChar *)t->text,
+                                                           t->length < WMH_IME_TEXT_MAX ? t->length : WMH_IME_TEXT_MAX);
+            if (!str) continue;
+            macdrv_ime_set_text(window->hwnd, str, t->complete != 0, t->cursor_begin, t->cursor_end, update);
+            CFRelease(str);
+        }
+        handled = reply->handled != 0;
+    }
+    free(reply);
+    return handled;
+}
+
+void host_clear_ime_text(void)
+{
+    host_send(WMH_KIND_IME_CLEAR, NULL, 0);
+}
+
+void macdrv_host_set_ime_rect(CGRect rect)
+{
+    struct wmh_ime_rect msg = { wmh_rect_from(rect) };
+    static struct wmh_ime_rect sent;
+    static BOOL rect_sent;
+
+    if (!host_mode) return;
+    if (rect_sent && !memcmp(&msg, &sent, sizeof(msg))) return;
+    rect_sent = TRUE;
+    sent = msg;
+    host_send(WMH_KIND_IME_RECT, &msg, sizeof(msg));
+}
+
+/* The answer to a question the host asked (a drag step or a resize size).
+ * query_resize_size changes the rect only when the program handled
+ * WM_SIZING, so it is the proposed frame otherwise. */
+void host_query_done(macdrv_query *query)
+{
+    if (query->type == QUERY_RESIZE_SIZE)
+    {
+        struct wmh_resize_size_reply reply = { query->host_serial, 0, wmh_rect_from(query->resize_size.rect) };
+
+        host_send(WMH_KIND_RESIZE_SIZE_REPLY, &reply, sizeof(reply));
+    }
+    else
+    {
+        struct wmh_drag_done done = { query->host_serial, query->status ? 1 : 0, 0, 0 };
+
+        if (query->type == QUERY_DRAG_DROP_DRAG && query->status) done.ops = query->drag_drop.ops;
+        host_send(WMH_KIND_DRAG_DONE, &done, sizeof(done));
+    }
+}
+
+static void *receive_thread(void *arg)
+{
+    struct received_message *msg = malloc(sizeof(*msg) + MAX_TRAILER_SIZE);
+
+    if (!msg)
+    {
+        ERR("host: out of memory for the receive buffer\n");
+        host_lost();
+        return NULL;
+    }
+    for (;;)
+    {
+        @autoreleasepool
+        {
+            const struct wmh_header *wmh;
+            size_t size;
+            kern_return_t kr;
+
+            kr = mach_msg(&msg->head, MACH_RCV_MSG | MACH_RCV_LARGE, 0, sizeof(*msg),
+                          driver_port, MACH_MSG_TIMEOUT_NONE, MACH_PORT_NULL);
+            if (kr == MACH_RCV_TOO_LARGE)
+            {
+                /* MACH_RCV_LARGE left it queued; take it and drop it. */
+                mach_msg(&msg->head, MACH_RCV_MSG, 0, sizeof(*msg), driver_port, 0, MACH_PORT_NULL);
+                continue;
+            }
+            if (kr != KERN_SUCCESS)
+            {
+                ERR("host: receive failed: %s (%x)\n", mach_error_string(kr), kr);
+                host_lost();
+                break;
+            }
+
+            if (msg->head.msgh_id == MACH_NOTIFY_DEAD_NAME)
+            {
+                host_lost();
+                break;
+            }
+            if (msg->head.msgh_id != WMH_MSG_ID || !(wmh = message_body(msg, &size)))
+            {
+                mach_msg_destroy(&msg->head);
+                continue;
+            }
+
+            switch (wmh->kind)
+            {
+            case WMH_KIND_EVENT:
+                if (size >= sizeof(struct wmh_event)) post_event((const struct wmh_event *)(wmh + 1), wmh->serial);
+                break;
+            case WMH_KIND_REPLY:
+                if (size >= sizeof(struct wmh_reply))
+                    reply_received(wmh->serial, (const struct wmh_reply *)(wmh + 1), size);
+                break;
+            case WMH_KIND_DRAG:
+                if (size >= sizeof(struct wmh_drag)) post_drag((const struct wmh_drag *)(wmh + 1), wmh->serial);
+                break;
+            case WMH_KIND_SURFACE_RELEASE:
+                if (size >= sizeof(struct wmh_surface_ref))
+                    surface_was_released(((const struct wmh_surface_ref *)(wmh + 1))->surface);
+                break;
+            default:
+                TRACE("host: ignoring kind %u\n", wmh->kind);
+                break;
+            }
+            mach_msg_destroy(&msg->head);
+        }
+    }
+    free(msg);
+    return NULL;
+}
+
+
+/***********************************************************************
+ *              macdrv_host_connect
+ *
+ * Look the host up and do the handshake. Returns 0 if the process is now
+ * in host mode; otherwise the plain driver is used, and why is logged.
+ */
+int macdrv_host_connect(const char *service, const char *exe_name)
+{
+    struct { mach_msg_header_t head; char data[1024]; } reply;
+    struct wmh_hello hello;
+    const struct wmh_header *wmh;
+    const struct wmh_hello_reply *hr;
+    mach_port_t previous;
+    pthread_attr_t attr;
+    pthread_t thread;
+    kern_return_t kr;
+    size_t size;
+
+    kr = bootstrap_look_up(bootstrap_port, service, &host_port);
+    if (kr != KERN_SUCCESS)
+    {
+        ERR("host: no host named \"%s\" (%s); using the plain driver\n", service, mach_error_string(kr));
+        host_port = MACH_PORT_NULL;
+        return -1;
+    }
+
+    kr = mach_port_allocate(mach_task_self(), MACH_PORT_RIGHT_RECEIVE, &driver_port);
+    if (kr != KERN_SUCCESS)
+    {
+        ERR("host: can't allocate a port: %s; using the plain driver\n", mach_error_string(kr));
+        goto fail;
+    }
+
+    memset(&hello, 0, sizeof(hello));
+    hello.protocol_version = WMH_PROTOCOL_VERSION;
+    hello.features = WMH_FEATURE_GDI_SURFACES | WMH_FEATURE_INPUT | WMH_FEATURE_GL_VIEWS | WMH_FEATURE_CURSOR;
+    hello.pid = getpid();
+    strlcpy(hello.exe_name, exe_name ? exe_name : "", sizeof(hello.exe_name));
+    if (!host_send_port(WMH_KIND_HELLO, driver_port, MACH_MSG_TYPE_MAKE_SEND, &hello, sizeof(hello)))
+    {
+        ERR("host: can't send hello to \"%s\"; using the plain driver\n", service);
+        goto fail;
+    }
+
+    /* Hosts on a fully loaded Mac can be slow; see the protocol doc. */
+    kr = mach_msg(&reply.head, MACH_RCV_MSG | MACH_RCV_TIMEOUT, 0, sizeof(reply),
+                  driver_port, 10000, MACH_PORT_NULL);
+    if (kr != KERN_SUCCESS)
+    {
+        ERR("host: no hello_reply from \"%s\" (%s); using the plain driver\n", service, mach_error_string(kr));
+        goto fail;
+    }
+    wmh = message_body((const struct received_message *)&reply, &size);
+    if (reply.head.msgh_id != WMH_MSG_ID || !wmh || wmh->kind != WMH_KIND_HELLO_REPLY ||
+        size < sizeof(struct wmh_hello_reply))
+    {
+        ERR("host: unexpected answer to hello from \"%s\"; using the plain driver\n", service);
+        mach_msg_destroy(&reply.head);
+        goto fail;
+    }
+    hr = (const struct wmh_hello_reply *)(wmh + 1);
+    if (hr->protocol_version != WMH_PROTOCOL_VERSION)
+    {
+        ERR("host: \"%s\" answered protocol version %u (we speak %u)%s; using the plain driver\n",
+            service, hr->protocol_version, WMH_PROTOCOL_VERSION,
+            hr->protocol_version ? "" : ", refusing this process");
+        mach_msg_destroy(&reply.head);
+        goto fail;
+    }
+    host_features = hr->features;
+    if (!(host_features & WMH_FEATURE_GDI_SURFACES))
+    {
+        ERR("host: \"%s\" doesn't take window surfaces; using the plain driver\n", service);
+        mach_msg_destroy(&reply.head);
+        goto fail;
+    }
+
+    /* Everything after hello goes to the host's port for this connection. */
+    if (!(reply.head.msgh_bits & MACH_MSGH_BITS_COMPLEX) ||
+        ((const mach_msg_body_t *)reply.data)->msgh_descriptor_count < 1 ||
+        ((const mach_msg_port_descriptor_t *)(reply.data + sizeof(mach_msg_body_t)))->name == MACH_PORT_NULL)
+    {
+        ERR("host: \"%s\" sent no port for this connection; using the plain driver\n", service);
+        mach_msg_destroy(&reply.head);
+        goto fail;
+    }
+    mach_port_deallocate(mach_task_self(), host_port);
+    host_port = ((const mach_msg_port_descriptor_t *)(reply.data + sizeof(mach_msg_body_t)))->name;
+
+    /* Hear about the host going away. */
+    mach_port_request_notification(mach_task_self(), host_port, MACH_NOTIFY_DEAD_NAME, 0,
+                                   driver_port, MACH_MSG_TYPE_MAKE_SEND_ONCE, &previous);
+
+    windows_by_id = [[NSMutableDictionary alloc] init];
+    views_by_id = [[NSMutableDictionary alloc] init];
+    pthread_attr_init(&attr);
+    pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+    if (pthread_create(&thread, &attr, receive_thread, NULL))
+    {
+        pthread_attr_destroy(&attr);
+        ERR("host: can't start the receive thread; using the plain driver\n");
+        goto fail;
+    }
+    pthread_attr_destroy(&attr);
+
+    TRACE("host: connected to \"%s\", features %#x\n", service, host_features);
+    host_mode = true;
+    return 0;
+
+fail:
+    if (driver_port != MACH_PORT_NULL) mach_port_mod_refs(mach_task_self(), driver_port, MACH_PORT_RIGHT_RECEIVE, -1);
+    if (host_port != MACH_PORT_NULL) mach_port_deallocate(mach_task_self(), host_port);
+    driver_port = host_port = MACH_PORT_NULL;
+    return -1;
+}
+
+
+/***********************************************************************
+ *              windows
+ */
+static uint32_t window_id(WineWindow *window)
+{
+    return window ? ((WineHostWindow *)window)->wid : 0;
+}
+
+static uint32_t features_bits(const struct macdrv_window_features *wf)
+{
+    return (wf->title_bar ? WMH_WF_TITLE_BAR : 0) | (wf->close_button ? WMH_WF_CLOSE_BUTTON : 0) |
+           (wf->minimize_button ? WMH_WF_MINIMIZE_BUTTON : 0) | (wf->resizable ? WMH_WF_RESIZABLE : 0) |
+           (wf->maximize_button ? WMH_WF_MAXIMIZE_BUTTON : 0) | (wf->utility ? WMH_WF_UTILITY : 0) |
+           (wf->shadow ? WMH_WF_SHADOW : 0) | (wf->prevents_app_activation ? WMH_WF_PREVENTS_APP_ACTIVATION : 0);
+}
+
+static struct wmh_rect wmh_rect_from(CGRect r)
+{
+    struct wmh_rect w = { r.origin.x, r.origin.y, r.size.width, r.size.height };
+    return w;
+}
+
+WineWindow *host_create_window(const struct macdrv_window_features *wf, CGRect frame,
+                               void *hwnd, WineEventQueue *queue)
+{
+    WineHostWindow *window = [[WineHostWindow alloc] init];
+    struct wmh_window_create msg;
+
+    window->hwnd = hwnd;
+    window->queue = [queue retain];
+    window->frame = frame;
+    window->surfaces = [[NSMutableArray alloc] init];
+
+    pthread_mutex_lock(&host_lock);
+    window->wid = next_window_id++;
+    [windows_by_id setObject:window forKey:@(window->wid)];
+    pthread_mutex_unlock(&host_lock);
+
+    memset(&msg, 0, sizeof(msg));
+    msg.window = window->wid;
+    msg.features = window->sent_features = features_bits(wf);
+    msg.frame = wmh_rect_from(frame);
+    msg.hwnd = (uintptr_t)hwnd;
+    host_send(WMH_KIND_WINDOW_CREATE, &msg, sizeof(msg));
+    TRACE("host: window %u for hwnd %p\n", window->wid, hwnd);
+    return (WineWindow *)window;
+}
+
+static void remove_pool(NSMutableArray *pool)
+{
+    /* host_lock held */
+    for (WineHostSurface *s in pool)
+    {
+        struct wmh_surface_ref msg = { s->sid, 0 };
+        host_send(WMH_KIND_SURFACE_REMOVE, &msg, sizeof(msg));
+    }
+    [pool removeAllObjects];
+}
+
+static void remove_surfaces(WineHostWindow *window)
+{
+    remove_pool(window->surfaces);
+}
+
+void host_destroy_window(WineWindow *w)
+{
+    WineHostWindow *window = (WineHostWindow *)w;
+    struct wmh_window_ref msg = { window->wid, 0 };
+
+    pthread_mutex_lock(&host_lock);
+    remove_surfaces(window);
+    [windows_by_id removeObjectForKey:@(window->wid)];
+    pthread_cond_broadcast(&surface_released);
+    pthread_mutex_unlock(&host_lock);
+
+    host_send(WMH_KIND_WINDOW_DESTROY, &msg, sizeof(msg));
+    [window->queue discardEventsMatchingMask:-1 forWindow:(NSWindow *)window];
+    [window release];
+}
+
+void host_set_window_features(WineWindow *w, const struct macdrv_window_features *wf)
+{
+    WineHostWindow *window = (WineHostWindow *)w;
+    struct wmh_window_flags msg = { window->wid, features_bits(wf) };
+
+    if (msg.flags == window->sent_features) return;
+    window->sent_features = msg.flags;
+    host_send(WMH_KIND_WINDOW_FEATURES, &msg, sizeof(msg));
+}
+
+void host_set_window_state(WineWindow *window, const struct macdrv_window_state *state)
+{
+    struct wmh_window_flags msg = { window_id(window), 0 };
+
+    msg.flags = (state->disabled ? WMH_WS_DISABLED : 0) | (state->no_foreground ? WMH_WS_NO_FOREGROUND : 0) |
+                (state->floating ? WMH_WS_FLOATING : 0) |
+                (state->excluded_by_expose ? WMH_WS_EXCLUDED_BY_EXPOSE : 0) |
+                (state->excluded_by_cycle ? WMH_WS_EXCLUDED_BY_CYCLE : 0) |
+                (state->minimized ? WMH_WS_MINIMIZED : 0) |
+                (state->minimized_valid ? WMH_WS_MINIMIZED_VALID : 0) |
+                (state->maximized ? WMH_WS_MAXIMIZED : 0);
+    if (((WineHostWindow *)window)->state_sent && msg.flags == ((WineHostWindow *)window)->sent_state) return;
+    ((WineHostWindow *)window)->state_sent = YES;
+    ((WineHostWindow *)window)->sent_state = msg.flags;
+    host_send(WMH_KIND_WINDOW_STATE, &msg, sizeof(msg));
+}
+
+void host_set_window_title(WineWindow *window, const UniChar *title, size_t length)
+{
+    struct wmh_window_title msg;
+    CFStringRef str;
+
+    memset(&msg, 0, sizeof(msg));
+    msg.window = window_id(window);
+    if (title && length && (str = CFStringCreateWithCharacters(NULL, title, length)))
+    {
+        CFIndex used = 0;
+        /* Whole characters only, leaving room for the NUL. */
+        CFStringGetBytes(str, CFRangeMake(0, CFStringGetLength(str)), kCFStringEncodingUTF8, 0, false,
+                         (UInt8 *)msg.title, sizeof(msg.title) - 1, &used);
+        msg.title[used] = 0;
+        CFRelease(str);
+    }
+    host_send(WMH_KIND_WINDOW_TITLE, &msg, sizeof(msg));
+}
+
+void host_order_window(WineWindow *window, WineWindow *prev, WineWindow *next, bool activate)
+{
+    struct wmh_window_order msg = { window_id(window), 0, WMH_ORDER_ABOVE, activate };
+
+    if (prev)
+    {
+        msg.relative = window_id(prev);
+        msg.position = WMH_ORDER_BELOW;
+    }
+    else if (next)
+        msg.relative = window_id(next);
+    host_send(WMH_KIND_WINDOW_ORDER, &msg, sizeof(msg));
+}
+
+void host_hide_window(WineWindow *window)
+{
+    struct wmh_window_ref msg = { window_id(window), 0 };
+    host_send(WMH_KIND_WINDOW_HIDE, &msg, sizeof(msg));
+}
+
+void host_set_window_frame(WineWindow *w, const CGRect *frame)
+{
+    WineHostWindow *window = (WineHostWindow *)w;
+    struct wmh_window_frame msg = { window->wid, 0, wmh_rect_from(*frame) };
+
+    BOOL same;
+
+    /* The same as we last set, or the host last reported: it knows. */
+    pthread_mutex_lock(&host_lock);
+    same = CGRectEqualToRect(window->frame, *frame);
+    window->frame = *frame;
+    pthread_mutex_unlock(&host_lock);
+    if (!same) host_send(WMH_KIND_WINDOW_FRAME, &msg, sizeof(msg));
+}
+
+/* The frame we last set, or the host last reported (WINDOW_FRAME_CHANGED). */
+void host_get_window_frame(WineWindow *w, CGRect *frame)
+{
+    WineHostWindow *window = (WineHostWindow *)w;
+
+    pthread_mutex_lock(&host_lock);
+    *frame = window->frame;
+    pthread_mutex_unlock(&host_lock);
+}
+
+void host_set_parent_window(WineWindow *w, WineWindow *parent)
+{
+    WineHostWindow *window = (WineHostWindow *)w;
+    struct wmh_window_parent msg = { window->wid, window_id(parent) };
+
+    if (window->parent_sent && window->sent_parent == msg.parent) return;
+    window->parent_sent = YES;
+    window->sent_parent = msg.parent;
+    host_send(WMH_KIND_WINDOW_PARENT, &msg, sizeof(msg));
+}
+
+void host_set_window_min_max(WineWindow *w, CGSize min_size, CGSize max_size)
+{
+    WineHostWindow *window = (WineHostWindow *)w;
+    struct wmh_window_min_max msg;
+
+    memset(&msg, 0, sizeof(msg));
+    msg.window = window->wid;
+    msg.min_width = min_size.width;
+    msg.min_height = min_size.height;
+    /* No limit comes as CGFLOAT_MAX, possibly clamped to the desktop. */
+    msg.max_width = max_size.width >= 1e9 ? 0 : max_size.width;
+    msg.max_height = max_size.height >= 1e9 ? 0 : max_size.height;
+    if (window->min_max_sent && !memcmp(&msg, &window->sent_min_max, sizeof(msg))) return;
+    window->min_max_sent = YES;
+    window->sent_min_max = msg;
+    host_send(WMH_KIND_WINDOW_MIN_MAX, &msg, sizeof(msg));
+}
+
+void host_give_window_focus(WineWindow *window, bool activate)
+{
+    struct wmh_window_ref msg = { window_id(window), activate ? WMH_FOCUS_ACTIVATE : 0 };
+    host_send(WMH_KIND_WINDOW_FOCUS, &msg, sizeof(msg));
+}
+
+void host_window_rejected_focus(WineWindow *window)
+{
+    struct wmh_window_ref msg = { window_id(window), 0 };
+    host_send(WMH_KIND_FOCUS_REJECTED, &msg, sizeof(msg));
+}
+
+
+/***********************************************************************
+ *              surfaces
+ */
+
+/* A surface of this size from the pool that the host isn't holding,
+   creating and registering one if there's room; surfaces of another size
+   are removed first. host_lock held. */
+static IOSurfaceRef acquire_from_pool(NSMutableArray *pool, unsigned int width, unsigned int height,
+                                      const char *what, uint32_t id)
+{
+    WineHostSurface *found = nil, *created = nil;
+    struct timespec deadline;
+    IOSurfaceRef ret = NULL;
+
+    if (pool.count)
+    {
+        WineHostSurface *s = pool[0];
+        if (IOSurfaceGetWidth(s->surface) != width || IOSurfaceGetHeight(s->surface) != height)
+            remove_pool(pool);
+    }
+
+    clock_gettime(CLOCK_REALTIME, &deadline);
+    deadline.tv_nsec += 50 * 1000000;
+    if (deadline.tv_nsec >= 1000000000) { deadline.tv_sec++; deadline.tv_nsec -= 1000000000; }
+
+    for (;;)
+    {
+        for (WineHostSurface *s in pool)
+            if (!s->with_host) { found = s; break; }
+        if (found || pool.count < MAX_SURFACES_PER_WINDOW) break;
+        if (pthread_cond_timedwait(&surface_released, &host_lock, &deadline)) break;
+    }
+
+    if (!found && pool.count < MAX_SURFACES_PER_WINDOW)
+    {
+        const void *keys[] = { kIOSurfaceWidth, kIOSurfaceHeight, kIOSurfaceBytesPerElement, kIOSurfacePixelFormat };
+        uint32_t values_raw[] = { width, height, 4, 'BGRA' };
+        const void *values[4];
+        CFDictionaryRef props;
+        IOSurfaceRef surface;
+        int i;
+
+        for (i = 0; i < 4; i++) values[i] = CFNumberCreate(NULL, kCFNumberSInt32Type, &values_raw[i]);
+        props = CFDictionaryCreate(NULL, keys, values, 4, &kCFTypeDictionaryKeyCallBacks,
+                                   &kCFTypeDictionaryValueCallBacks);
+        surface = IOSurfaceCreate(props);
+        CFRelease(props);
+        for (i = 0; i < 4; i++) CFRelease(values[i]);
+
+        if (surface)
+        {
+            struct wmh_surface_add msg;
+            mach_port_t port = IOSurfaceCreateMachPort(surface);
+
+            created = [[[WineHostSurface alloc] init] autorelease];
+            created->sid = next_surface_id++;
+            created->surface = surface;
+            msg.surface = created->sid;
+            msg.width = width;
+            msg.height = height;
+            msg.pixel_format = WMH_PIXEL_BGRA8;
+            if (host_send_port(WMH_KIND_SURFACE_ADD, port, MACH_MSG_TYPE_MOVE_SEND, &msg, sizeof(msg)))
+            {
+                [pool addObject:created];
+                found = created;
+            }
+        }
+    }
+
+    if (!found && pool.count)
+    {
+        /* The host holds every surface past the wait: draw into the oldest
+           anyway (it may tear) rather than stall the program. */
+        WARN("host: %s %u: no free surface\n", what, id);
+        found = pool[0];
+    }
+    if (found) ret = found->surface;
+    return ret;
+}
+
+/***********************************************************************
+ *              macdrv_host_acquire_surface
+ *
+ * An IOSurface of this size the driver owns (the host isn't holding it),
+ * for surface.c to draw a window's whole picture into. Surfaces of another
+ * size are removed. Returns a +0 reference, valid until it's sent or the
+ * window goes away.
+ */
+IOSurfaceRef macdrv_host_acquire_surface(WineWindow *w, unsigned int width, unsigned int height)
+{
+    WineHostWindow *window = (WineHostWindow *)w;
+    IOSurfaceRef ret;
+
+    pthread_mutex_lock(&host_lock);
+    ret = acquire_from_pool(window->surfaces, width, height, "window", window->wid);
+    pthread_mutex_unlock(&host_lock);
+    return ret;
+}
+
+void host_window_set_io_surface(WineWindow *w, IOSurfaceRef surface, CGRect rect, CGRect dirty)
+{
+    WineHostWindow *window = (WineHostWindow *)w;
+    struct wmh_window_frame_ready msg;
+
+    memset(&msg, 0, sizeof(msg));
+    pthread_mutex_lock(&host_lock);
+    for (WineHostSurface *s in window->surfaces)
+    {
+        if (s->surface == surface)
+        {
+            s->with_host = YES;
+            msg.surface = s->sid;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&host_lock);
+    if (!msg.surface) return;  /* not one of ours: the plain driver's front/back buffers */
+
+    msg.window = window->wid;
+    msg.width = IOSurfaceGetWidth(surface);
+    msg.height = IOSurfaceGetHeight(surface);
+    msg.rect = wmh_rect_from(rect);
+    msg.dirty = wmh_rect_from(dirty);
+    host_send(WMH_KIND_WINDOW_FRAME_READY, &msg, sizeof(msg));
+}
+
+
+/***********************************************************************
+ *              views
+ */
+static WineHostView *view_for_id(uint32_t vid)
+{
+    /* host_lock held */
+    return [views_by_id objectForKey:@(vid)];
+}
+
+unsigned int macdrv_host_view_create(void)
+{
+    WineHostView *view = [[[WineHostView alloc] init] autorelease];
+    struct wmh_view_ref msg;
+
+    view->surfaces = [[NSMutableArray alloc] init];
+    view->sent_hidden = -1;
+    pthread_mutex_lock(&host_lock);
+    view->vid = next_view_id++;
+    [views_by_id setObject:view forKey:@(view->vid)];
+    pthread_mutex_unlock(&host_lock);
+
+    msg.view = view->vid;
+    msg.reserved = 0;
+    host_send(WMH_KIND_VIEW_CREATE, &msg, sizeof(msg));
+    return view->vid;
+}
+
+void macdrv_host_view_destroy(unsigned int vid)
+{
+    struct wmh_view_ref msg = { vid, 0 };
+    WineHostView *view;
+
+    if (!vid) return;
+    pthread_mutex_lock(&host_lock);
+    if ((view = view_for_id(vid)))
+    {
+        remove_pool(view->surfaces);
+        [views_by_id removeObjectForKey:@(vid)];
+        pthread_cond_broadcast(&surface_released);
+    }
+    pthread_mutex_unlock(&host_lock);
+    host_send(WMH_KIND_VIEW_DESTROY, &msg, sizeof(msg));
+}
+
+/* frame: in the window's content area, in the protocol's space (the units
+   macdrv_set_view_frame gets). */
+void macdrv_host_view_set_frame(unsigned int vid, WineWindow *window, CGRect frame)
+{
+    struct wmh_view_frame msg;
+
+    WineHostView *view;
+    BOOL same = FALSE;
+
+    if (!vid) return;
+    msg.view = vid;
+    msg.window = window_id(window);
+    msg.frame = wmh_rect_from(frame);
+    pthread_mutex_lock(&host_lock);
+    if ((view = view_for_id(vid)))
+    {
+        same = view->sent_window == msg.window && CGRectEqualToRect(view->sent_frame, frame);
+        view->sent_window = msg.window;
+        view->sent_frame = frame;
+    }
+    pthread_mutex_unlock(&host_lock);
+    if (!same) host_send(WMH_KIND_VIEW_FRAME, &msg, sizeof(msg));
+}
+
+void macdrv_host_view_set_hidden(unsigned int vid, bool hidden)
+{
+    struct wmh_view_hidden msg = { vid, hidden };
+    WineHostView *view;
+    BOOL same = FALSE;
+
+    if (!vid) return;
+    pthread_mutex_lock(&host_lock);
+    if ((view = view_for_id(vid)))
+    {
+        same = view->sent_hidden == (int)hidden;
+        view->sent_hidden = hidden;
+    }
+    pthread_mutex_unlock(&host_lock);
+    if (!same) host_send(WMH_KIND_VIEW_HIDDEN, &msg, sizeof(msg));
+}
+
+IOSurfaceRef macdrv_host_view_acquire_surface(unsigned int vid, unsigned int width, unsigned int height)
+{
+    WineHostView *view;
+    IOSurfaceRef ret = NULL;
+
+    pthread_mutex_lock(&host_lock);
+    if ((view = view_for_id(vid)))
+        ret = acquire_from_pool(view->surfaces, width, height, "view", vid);
+    pthread_mutex_unlock(&host_lock);
+    return ret;
+}
+
+/* The surface, finished, now belongs to the host. */
+void macdrv_host_view_frame_ready(unsigned int vid, IOSurfaceRef surface)
+{
+    struct wmh_view_frame_ready msg;
+    WineHostView *view;
+
+    memset(&msg, 0, sizeof(msg));
+    pthread_mutex_lock(&host_lock);
+    if ((view = view_for_id(vid)))
+    {
+        for (WineHostSurface *s in view->surfaces)
+        {
+            if (s->surface == surface)
+            {
+                s->with_host = YES;
+                msg.surface = s->sid;
+                break;
+            }
+        }
+    }
+    pthread_mutex_unlock(&host_lock);
+    if (!msg.surface) return;
+
+    msg.view = vid;
+    msg.width = IOSurfaceGetWidth(surface);
+    msg.height = IOSurfaceGetHeight(surface);
+    msg.flags = WMH_SURFACE_BOTTOM_UP;
+    host_send(WMH_KIND_VIEW_FRAME_READY, &msg, sizeof(msg));
+}
+
+
+/***********************************************************************
+ *              cursor
+ */
+static IOSurfaceRef surface_from_image(CGImageRef image)
+{
+    size_t width = CGImageGetWidth(image), height = CGImageGetHeight(image);
+    const void *keys[] = { kIOSurfaceWidth, kIOSurfaceHeight, kIOSurfaceBytesPerElement, kIOSurfacePixelFormat };
+    uint32_t values_raw[] = { width, height, 4, 'BGRA' };
+    const void *values[4];
+    CFDictionaryRef props;
+    IOSurfaceRef surface;
+    CGColorSpaceRef space;
+    CGContextRef ctx;
+    int i;
+
+    for (i = 0; i < 4; i++) values[i] = CFNumberCreate(NULL, kCFNumberSInt32Type, &values_raw[i]);
+    props = CFDictionaryCreate(NULL, keys, values, 4, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    surface = IOSurfaceCreate(props);
+    CFRelease(props);
+    for (i = 0; i < 4; i++) CFRelease(values[i]);
+    if (!surface) return NULL;
+
+    IOSurfaceLock(surface, 0, NULL);
+    space = CGColorSpaceCreateDeviceRGB();
+    ctx = CGBitmapContextCreate(IOSurfaceGetBaseAddress(surface), width, height, 8, IOSurfaceGetBytesPerRow(surface),
+                                space, kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Little);
+    if (ctx)
+    {
+        CGContextClearRect(ctx, CGRectMake(0, 0, width, height));
+        CGContextDrawImage(ctx, CGRectMake(0, 0, width, height), image);
+        CGContextRelease(ctx);
+    }
+    CGColorSpaceRelease(space);
+    IOSurfaceUnlock(surface, 0, NULL);
+    return surface;
+}
+
+/* name: an NSCursor class method, or frames: Wine's cursor frames (the
+   first is sent); neither: hide the cursor. */
+void host_set_cursor(CFStringRef name, CFArrayRef frames)
+{
+    struct wmh_cursor_set msg;
+    CFTypeRef which = name ? (CFTypeRef)name : (CFTypeRef)frames;
+
+    /* Programs set the same cursor over and over. */
+    if (which && sent_cursor && CFEqual(which, sent_cursor)) return;
+    if (!which && sent_cursor == kCFNull) return;
+    if (sent_cursor) CFRelease(sent_cursor);
+    sent_cursor = CFRetain(which ? which : kCFNull);
+
+    memset(&msg, 0, sizeof(msg));
+    if (name)
+    {
+        msg.type = WMH_CURSOR_SYSTEM;
+        CFStringGetCString(name, msg.name, sizeof(msg.name), kCFStringEncodingUTF8);
+        host_send(WMH_KIND_CURSOR_SET, &msg, sizeof(msg));
+    }
+    else if (frames && CFArrayGetCount(frames))
+    {
+        CFDictionaryRef frame = CFArrayGetValueAtIndex(frames, 0);
+        CGImageRef image = (CGImageRef)CFDictionaryGetValue(frame, CFSTR("image"));
+        CFDictionaryRef hot = CFDictionaryGetValue(frame, CFSTR("hotSpot"));
+        CGPoint hot_spot = CGPointZero;
+        IOSurfaceRef surface;
+
+        if (!image || !(surface = surface_from_image(image))) return;
+        if (hot) CGPointMakeWithDictionaryRepresentation(hot, &hot_spot);
+        msg.type = WMH_CURSOR_IMAGE;
+        msg.width = IOSurfaceGetWidth(surface);
+        msg.height = IOSurfaceGetHeight(surface);
+        msg.hot_x = hot_spot.x;
+        msg.hot_y = hot_spot.y;
+        host_send_port(WMH_KIND_CURSOR_SET, IOSurfaceCreateMachPort(surface), MACH_MSG_TYPE_MOVE_SEND, &msg, sizeof(msg));
+        CFRelease(surface);
+    }
+    else
+    {
+        msg.type = WMH_CURSOR_HIDDEN;
+        host_send(WMH_KIND_CURSOR_SET, &msg, sizeof(msg));
+    }
+}
+
+int host_get_cursor_position(CGPoint *pos)
+{
+    pthread_mutex_lock(&host_lock);
+    *pos = pointer;
+    pthread_mutex_unlock(&host_lock);
+    return 1;
+}
+
+int host_set_cursor_position(CGPoint pos)
+{
+    struct wmh_cursor_warp msg = { pos.x, pos.y };
+
+    set_pointer(pos);
+    return host_send(WMH_KIND_CURSOR_WARP, &msg, sizeof(msg));
+}
+
+int host_clip_cursor(CGRect rect)
+{
+    static struct wmh_cursor_clip sent = { 0 };
+    static BOOL clip_sent;
+    struct wmh_cursor_clip msg;
+
+    memset(&msg, 0, sizeof(msg));
+    /* An infinite rect (CGRectInfinite) releases the clip, as for the plain driver. */
+    if (!CGRectIsInfinite(rect) && !CGRectIsNull(rect))
+    {
+        msg.clipped = 1;
+        msg.rect = wmh_rect_from(rect);
+    }
+    if (clip_sent && !memcmp(&msg, &sent, sizeof(msg))) return 1;
+    clip_sent = TRUE;
+    sent = msg;
+    return host_send(WMH_KIND_CURSOR_CLIP, &msg, sizeof(msg));
+}
