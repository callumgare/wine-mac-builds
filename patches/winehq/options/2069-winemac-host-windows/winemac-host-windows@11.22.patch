@@ -58,6 +60,290 @@ static const struct opengl_funcs *funcs;
 static const struct opengl_driver_funcs macdrv_driver_funcs;
 static const struct opengl_drawable_funcs macdrv_surface_funcs;
 
+/**********************************************************************
+ * Host mode (cocoa_host.m): OpenGL into IOSurfaces the host is sent
+ *
+ * In host mode, a window's OpenGL default framebuffer is an FBO whose
+ * colour buffer is an IOSurface from the view's pool (each one the host
+ * hands back with surface_release), and nothing is drawn into the window's
+ * Cocoa view. Framebuffer 0 is remapped here, in the functions the driver
+ * hands out, so win32u, opengl32 and wined3d are unchanged. Each present
+ * finishes, sends the surface to the host and moves to a free one.
+ */
+#define HOST_GL_MAX_CONTEXTS 8
+
+struct host_gl_fbo
+{
+    unsigned int ctx_id;    /* the context's host_gl_id: a pointer can be reused */
+    GLuint fbo, tex, depth;
+    unsigned int gen;
+    int width, height;      /* of the depth buffer */
+};
+
+struct macdrv_drawable
+{
+    struct opengl_drawable base;
+    IOSurfaceRef surface;
+    int width, height;
+    unsigned int gen;
+    struct host_gl_fbo fbos[HOST_GL_MAX_CONTEXTS];
+};
+
+static BOOL host_gl;
+static __thread struct macdrv_drawable *host_gl_draw, *host_gl_read;
+static __thread unsigned int host_gl_ctx;   /* host_gl_id of the context current here */
+
+static void (*host_pglBindFramebuffer)(GLenum, GLuint);
+static void (*host_pglBindFramebufferEXT)(GLenum, GLuint);
+static void (*host_pglDrawBuffer)(GLenum);
+static void (*host_pglDrawBuffers)(GLsizei, const GLenum *);
+static void (*host_pglReadBuffer)(GLenum);
+static void (*host_pglGetIntegerv)(GLenum, GLint *);
+static void (*host_pglFinish)(void);
+static void (*host_pglGenFramebuffers)(GLsizei, GLuint *);
+static void (*host_pglGenTextures)(GLsizei, GLuint *);
+static void (*host_pglGenRenderbuffers)(GLsizei, GLuint *);
+static void (*host_pglBindTexture)(GLenum, GLuint);
+static void (*host_pglBindRenderbuffer)(GLenum, GLuint);
+static void (*host_pglRenderbufferStorage)(GLenum, GLenum, GLsizei, GLsizei);
+static void (*host_pglFramebufferTexture2D)(GLenum, GLenum, GLenum, GLuint, GLint);
+static void (*host_pglFramebufferRenderbuffer)(GLenum, GLenum, GLenum, GLuint);
+static GLenum (*host_pglCheckFramebufferStatus)(GLenum);
+static void (*host_pglDeleteFramebuffers)(GLsizei, const GLuint *);
+static void (*host_pglDeleteTextures)(GLsizei, const GLuint *);
+static void (*host_pglDeleteRenderbuffers)(GLsizei, const GLuint *);
+
+static void host_gl_init(void)
+{
+    static BOOL done;
+
+    if (done) return;
+    done = TRUE;
+    if (!host_mode) return;
+    host_gl = TRUE;
+#define LOAD(f) host_p##f = dlsym(opengl_handle, #f)
+    LOAD(glBindFramebuffer); LOAD(glBindFramebufferEXT); LOAD(glDrawBuffer); LOAD(glDrawBuffers);
+    LOAD(glReadBuffer); LOAD(glGetIntegerv); LOAD(glFinish); LOAD(glGenFramebuffers);
+    LOAD(glGenTextures); LOAD(glGenRenderbuffers); LOAD(glBindTexture); LOAD(glBindRenderbuffer);
+    LOAD(glRenderbufferStorage); LOAD(glFramebufferTexture2D); LOAD(glFramebufferRenderbuffer);
+    LOAD(glCheckFramebufferStatus); LOAD(glDeleteFramebuffers); LOAD(glDeleteTextures);
+    LOAD(glDeleteRenderbuffers);
+#undef LOAD
+    TRACE("host mode: OpenGL draws into IOSurfaces\n");
+}
+
+static struct macdrv_drawable *host_gl_drawable(struct opengl_drawable *base)
+{
+    if (!host_gl || !base || !base->client || base->funcs != &macdrv_surface_funcs) return NULL;
+    return CONTAINING_RECORD(base, struct macdrv_drawable, base);
+}
+
+/* A free IOSurface from the view's pool, sized to the drawable's client area. */
+static void host_gl_update_surface(struct macdrv_drawable *d)
+{
+    struct macdrv_client_surface *surface = impl_from_client_surface(d->base.client);
+    RECT rect = surface->client.raw ? surface->client.monitor_rect : surface->client.virtual_rect;
+    int width = max(1, rect.right - rect.left), height = max(1, rect.bottom - rect.top);
+
+    if (d->surface && d->width == width && d->height == height) return;
+    d->surface = macdrv_host_view_acquire_surface(surface->host_view, width, height);
+    d->width = width;
+    d->height = height;
+    d->gen++;
+    TRACE("drawable %p: view %u, IOSurface %p, %dx%d\n", d, surface->host_view, d->surface, width, height);
+}
+
+/* The FBO standing in for framebuffer 0 of drawable d, in the current context. */
+static GLuint host_gl_fbo_for(struct macdrv_drawable *d)
+{
+    CGLContextObj ctx = CGLGetCurrentContext();
+    struct host_gl_fbo *e = NULL;
+    GLint prev_tex, prev_draw, prev_read, prev_rb;
+    GLenum status;
+    int i;
+
+    if (!ctx || !host_gl_ctx) return 0;
+    host_gl_update_surface(d);
+    if (!d->surface) return 0;
+    for (i = 0; i < HOST_GL_MAX_CONTEXTS; i++)
+        if (d->fbos[i].ctx_id == host_gl_ctx) { e = &d->fbos[i]; break; }
+    if (!e)
+    {
+        for (i = 0; i < HOST_GL_MAX_CONTEXTS; i++)
+            if (!d->fbos[i].ctx_id) { e = &d->fbos[i]; break; }
+        if (!e)
+        {
+            /* its GL objects belong to another context: left to that one */
+            WARN("drawable %p: more than %d contexts; forgetting context %u's FBO\n",
+                 d, HOST_GL_MAX_CONTEXTS, d->fbos[0].ctx_id);
+            e = &d->fbos[0];
+        }
+        memset(e, 0, sizeof(*e));
+        e->ctx_id = host_gl_ctx;
+    }
+    if (e->fbo && e->gen == d->gen) return e->fbo;
+
+    host_pglGetIntegerv(GL_TEXTURE_BINDING_RECTANGLE_ARB, &prev_tex);
+    host_pglGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &prev_draw);
+    host_pglGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &prev_read);
+    host_pglGetIntegerv(GL_RENDERBUFFER_BINDING, &prev_rb);
+
+    if (!e->fbo) host_pglGenFramebuffers(1, &e->fbo);
+    if (!e->tex) host_pglGenTextures(1, &e->tex);
+    if (!e->depth) host_pglGenRenderbuffers(1, &e->depth);
+
+    host_pglBindTexture(GL_TEXTURE_RECTANGLE_ARB, e->tex);
