+    return FALSE;
+}
+
+static BOOL mode_listed(const DEVMODEW *modes, int count, const DEVMODEW *mode)
+{
+    int i;
+    for (i = 0; i < count; i++)
+        if (modes[i].dmPelsWidth == mode->dmPelsWidth && modes[i].dmPelsHeight == mode->dmPelsHeight &&
+            modes[i].dmBitsPerPel == mode->dmBitsPerPel && modes[i].dmDisplayFrequency == mode->dmDisplayFrequency)
+            return TRUE;
+    return FALSE;
+}
