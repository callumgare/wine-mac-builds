 #include <Security/AuthSession.h>
 #include <IOKit/pwr_mgt/IOPMLib.h>
 
@@ -270,6 +271,8 @@ static inline DWORD get_config_key(HKEY defkey, HKEY appkey, const char *name,
  *
  * Set up the Mac driver options.
  */
+static WCHAR *plugins_option;
+
 static void setup_options(void)
 {
     static const WCHAR macdriverW[] = {'\\','M','a','c',' ','D','r','i','v','e','r',0};
@@ -386,6 +389,16 @@ static void setup_options(void)
 
     retina_on = retina_enabled;
 
+    /* Libraries to load before Cocoa starts (see load_plugins). */
+    {
+        WCHAR plugins[1000];
+        if (!get_config_key(hkey, appkey, "Plugins", plugins, sizeof(plugins)) && plugins[0])
+        {
+            len = (lstrlenW(plugins) + 1) * sizeof(WCHAR);
+            if ((plugins_option = malloc(len))) memcpy(plugins_option, plugins, len);
+        }
+    }
+
     if (appkey) NtClose(appkey);
     if (hkey) NtClose(hkey);
 }
@@ -427,6 +440,60 @@ static void load_strings(struct localized_string *str)
 }
 
 
+/***********************************************************************
+ *              load_plugin_list
+ *
+ * dlopen each path in a colon-separated list. A path that doesn't load
+ * is reported and skipped.
+ */
+static void load_plugin_list(const char *list, const char *from)
+{
+    char *copy, *path, *next;
+
+    if (!list || !*list || !(copy = strdup(list))) return;
+    for (path = copy; path; path = next)
+    {
+        if ((next = strchr(path, ':'))) *next++ = 0;
+        if (!*path) continue;
+        if (dlopen(path, RTLD_NOW | RTLD_GLOBAL))
+            TRACE("loaded plugin %s (from %s)\n", debugstr_a(path), from);
+        else
+            ERR("couldn't load plugin %s (from %s): %s\n", debugstr_a(path), from, dlerror());
+    }
+    free(copy);
+}
+
+
+/***********************************************************************
+ *              load_plugins
+ *
+ * Load the libraries named in WINEMAC_PLUGINS (inherited by child
+ * processes) and in the Mac Driver "Plugins" value (global or per app),
+ * each a colon-separated list of paths, before Cocoa starts. Lets an app
+ * that embeds Wine add code to the driver without changing winemac.so.
+ * Nothing is loaded unless one of them is set.
+ */
+static void load_plugins(void)
+{
+    load_plugin_list(getenv("WINEMAC_PLUGINS"), "WINEMAC_PLUGINS");
+
+    if (plugins_option)
+    {
+        CFStringRef str = CFStringCreateWithCharacters(NULL, (const UniChar *)plugins_option,
+                                                       lstrlenW(plugins_option));
+        char path[4096];
+
+        if (str && CFStringGetFileSystemRepresentation(str, path, sizeof(path)))
+            load_plugin_list(path, "the Plugins registry value");
+        else
+            ERR("couldn't read the Plugins registry value\n");
+        if (str) CFRelease(str);
+        free(plugins_option);
+        plugins_option = NULL;
+    }
+}
+
+
 /***********************************************************************
  *              macdrv_init
  */
@@ -450,6 +517,7 @@ static NTSTATUS macdrv_init(void *arg)
 
     init_win_context();
     setup_options();
+    load_plugins();
     load_strings(params->strings);
 
     if (macdrv_start_cocoa_app(NtGetTickCount()))
