Summary: Redirect reads of nvngx.dll to D3DMetal's copy, for DLSS
Category: graphics
Kind: feature
Feature: d3dmetal
Origin: reconstructed
  Version: Sikarugir 10.0_8
  Binary: WS12WineSikarugir10.0_8 kernelbase.dll
  Functions: redirect_nvngx_to_d3dmetal (inlined into CreateFileW; x86_64
    0x174014120-0x1740146a3)
  Changes: calls ntdll's wine_unix_to_nt_file_name export directly, where
    10.0_8 looks it up with GetProcAddress (the same function)
  Note: Sikarugir-only: no CrossOver, wine-staging or WineHQ equivalent
Upstream: no
Why: DLSS-capable games (NVIDIA's Streamline/NGX loader) open
 c:\windows\system32\nvngx.dll directly with CreateFileW(GENERIC_READ,
 FILE_SHARE_READ, OPEN_EXISTING) to read and check it before loading it. In a
 prefix that file is a placeholder (wine-inf-d3dmetal-placeholder-dlls). With
 CX_D3DMETALPATH set to D3DMetal's folder, exactly that open is redirected to
 $CX_D3DMETALPATH/wine/x86_64-windows/nvngx.dll when that file exists. Any
 other open, a missing file or an unset variable goes through unchanged, and
 LoadLibrary isn't affected. No copy for Wine 11.x, where D3DMetal 3.0 can't
 run.
Programs: none known
Enable: env CX_D3DMETALPATH=<d3dmetal> (the folder holding wine/ and external/; each process that has it)
Messages: "attempting to redirect nvngx.dll to D3DMetal file", "CX_D3DMETALPATH
 not set", "wine_unix_to_nt_file_name(%s) failed with %lx" (TRACE on the file
 channel, hidden unless WINEDEBUG has +file)
Uncertain: whether any DLSS game works this way on D3DMetal (no game tested).
 The path suffix is x86_64-windows in both of 10.0_8's x86_64 and i386
 kernelbase, so 32-bit processes are redirected to the 64-bit DLL; kept as
 is. Only the exact access, sharing and disposition values above trigger it,
 as in 10.0_8. GetFinalPathNameByHandle on the handle gives the Unix path,
 not system32's; whether NGX checks that isn't known.
Related: wine-inf-d3dmetal-placeholder-dlls; reads of the nvngx.dll
 placeholder it installs are redirected here
Status: 10.0: 2026-11-26: header only; the 11.21/11.22 copy is dropped (D3DMetal
 can't run there)

diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
index f0dedfe..c543e86 100644
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -772,6 +772,59 @@ static UINT get_nt_file_options( DWORD attributes )
     return options;
 }
 
+/*************************************************************************
+ *	redirect_nvngx_to_d3dmetal
+ *
+ * Sikarugir: DLSS games open c:\windows\system32\nvngx.dll; give them D3DMetal's
+ * copy, $CX_D3DMETALPATH/wine/x86_64-windows/nvngx.dll, when it exists.
+ * On success nt_name holds the NT path of that file.
+ */
+static BOOL redirect_nvngx_to_d3dmetal( const WCHAR *filename, DWORD access, DWORD sharing,
+                                        DWORD creation, UNICODE_STRING *nt_name )
+{
+    static const char suffix[] = "/wine/x86_64-windows/nvngx.dll";
+    FILE_BASIC_INFORMATION info;
+    OBJECT_ATTRIBUTES attr;
+    char *unix_name;
+    WCHAR *dos_name = NULL;
+    NTSTATUS status;
+    ULONG size;
+    DWORD len;
+    BOOL ret = FALSE;
+
+    if (access != GENERIC_READ || sharing != FILE_SHARE_READ || creation != OPEN_EXISTING) return FALSE;
+    if (wcsicmp( filename, L"c:\\windows\\system32\\nvngx.dll" )) return FALSE;
+
+    TRACE( "attempting to redirect nvngx.dll to D3DMetal file\n" );
+
+    if (!(len = GetEnvironmentVariableA( "CX_D3DMETALPATH", NULL, 0 )))
+    {
+        TRACE( "CX_D3DMETALPATH not set\n" );
+        return FALSE;
+    }
+    if (!(unix_name = HeapAlloc( GetProcessHeap(), 0, len + sizeof(suffix) ))) return FALSE;
+    GetEnvironmentVariableA( "CX_D3DMETALPATH", unix_name, len );
+    strcat( unix_name, suffix );
+
+    size = len + sizeof(suffix) + 8;
+    if (!(dos_name = HeapAlloc( GetProcessHeap(), 0, size * sizeof(WCHAR) ))) goto done;
+    if ((status = wine_unix_to_nt_file_name( unix_name, dos_name, &size )))
+    {
+        TRACE( "wine_unix_to_nt_file_name(%s) failed with %lx\n", debugstr_a(unix_name), status );
+        goto done;
+    }
+    if (!RtlDosPathNameToNtPathName_U( dos_name, nt_name, NULL, NULL )) goto done;
+
+    InitializeObjectAttributes( &attr, nt_name, OBJ_CASE_INSENSITIVE, 0, NULL );
+    if (NtQueryAttributesFile( &attr, &info )) RtlFreeUnicodeString( nt_name );
+    else ret = TRUE;
+
+done:
+    HeapFree( GetProcessHeap(), 0, dos_name );
+    HeapFree( GetProcessHeap(), 0, unix_name );
+    return ret;
+}
+
 /*************************************************************************
  *	CreateFileW   (kernelbase.@)
  */
@@ -830,7 +883,8 @@ HANDLE WINAPI DECLSPEC_HOTPATCH CreateFileW( LPCWSTR filename, DWORD access, DWO
         return INVALID_HANDLE_VALUE;
     }
 
-    if (!RtlDosPathNameToNtPathName_U( filename, &nameW, NULL, NULL ))
+    if (!redirect_nvngx_to_d3dmetal( filename, access, sharing, creation, &nameW ) &&
+        !RtlDosPathNameToNtPathName_U( filename, &nameW, NULL, NULL ))
     {
         SetLastError( ERROR_PATH_NOT_FOUND );
         return INVALID_HANDLE_VALUE;
