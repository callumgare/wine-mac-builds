index 7b0f0a6..06362b6 100644
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -789,6 +789,68 @@ static UINT get_nt_file_options( DWORD attributes, DWORD creation )
     return options;
 }
 
+/*************************************************************************
+ *	redirect_nvngx_to_d3dmetal
+ *
+ * Sikarugir: DLSS games open c:\windows\system32\nvngx.dll; give them D3DMetal's
+ * copy, $CX_D3DMETALPATH/wine/x86_64-windows/nvngx.dll, when it exists.
+ * On success nt_name holds the NT path of that file (as \??\unix\...).
+ */
+static BOOL redirect_nvngx_to_d3dmetal( const WCHAR *filename, DWORD access, DWORD sharing,
+                                        DWORD creation, UNICODE_STRING *nt_name )
+{
+    static const WCHAR prefix[] = L"\\??\\unix";
+    static const WCHAR suffix[] = L"\\wine\\x86_64-windows\\nvngx.dll";
+    FILE_BASIC_INFORMATION info;
+    OBJECT_ATTRIBUTES attr;
+    char *unix_name;
+    WCHAR *nt_str = NULL, *p;
+    DWORD len;
+    int wlen;
+    BOOL ret = FALSE;
+
+    if (access != GENERIC_READ || sharing != FILE_SHARE_READ || creation != OPEN_EXISTING) return FALSE;
+    if (wcsicmp( filename, L"c:\\windows\\system32\\nvngx.dll" )) return FALSE;
+
+    TRACE( "attempting to redirect nvngx.dll to D3DMetal file\n" );
+
+    if (!(len = GetEnvironmentVariableA( "CX_D3DMETALPATH", NULL, 0 )))
+    {
+        TRACE( "CX_D3DMETALPATH not set\n" );
+        return FALSE;
+    }
+    if (!(unix_name = HeapAlloc( GetProcessHeap(), 0, len ))) return FALSE;
+    GetEnvironmentVariableA( "CX_D3DMETALPATH", unix_name, len );
+    if (unix_name[0] != '/')
+    {
+        TRACE( "CX_D3DMETALPATH %s is not an absolute path\n", debugstr_a(unix_name) );
+        goto done;
+    }
+
+    /* Wine 11 no longer exports wine_unix_to_nt_file_name(); name the file
+     * through the \??\unix device instead, as kernel32's wine_get_dos_file_name() does. */
+    wlen = MultiByteToWideChar( CP_UNIXCP, 0, unix_name, -1, NULL, 0 );
+    if (!wlen) goto done;
+    if (!(nt_str = HeapAlloc( GetProcessHeap(), 0,
+                              (ARRAY_SIZE(prefix) - 1 + wlen + ARRAY_SIZE(suffix)) * sizeof(WCHAR) ))) goto done;
+    wcscpy( nt_str, prefix );
+    MultiByteToWideChar( CP_UNIXCP, 0, unix_name, -1, nt_str + ARRAY_SIZE(prefix) - 1, wlen );
+    for (p = nt_str; *p; p++) if (*p == '/') *p = '\\';
+    while (p > nt_str + ARRAY_SIZE(prefix) - 1 && p[-1] == '\\') *--p = 0;
+    wcscat( nt_str, suffix );
+
+    if (!RtlCreateUnicodeString( nt_name, nt_str )) goto done;
+
+    InitializeObjectAttributes( &attr, nt_name, OBJ_CASE_INSENSITIVE, 0, NULL );
+    if (NtQueryAttributesFile( &attr, &info )) RtlFreeUnicodeString( nt_name );
+    else ret = TRUE;
+
+done:
+    HeapFree( GetProcessHeap(), 0, nt_str );
+    HeapFree( GetProcessHeap(), 0, unix_name );
+    return ret;
+}
+
 /*************************************************************************
  *	CreateFileW   (kernelbase.@)
  */
@@ -847,7 +909,8 @@ HANDLE WINAPI DECLSPEC_HOTPATCH CreateFileW( LPCWSTR filename, DWORD access, DWO
         return INVALID_HANDLE_VALUE;
     }
 
-    if (!RtlDosPathNameToNtPathName_U( filename, &nameW, NULL, NULL ))
+    if (!redirect_nvngx_to_d3dmetal( filename, access, sharing, creation, &nameW ) &&
+        !RtlDosPathNameToNtPathName_U( filename, &nameW, NULL, NULL ))
     {
         SetLastError( ERROR_PATH_NOT_FOUND );
         return INVALID_HANDLE_VALUE;
