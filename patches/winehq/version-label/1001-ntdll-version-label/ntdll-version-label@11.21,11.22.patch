SPDX-License-Identifier: LGPL-2.1-or-later
Summary: Add the flavour's name to the version string: "wine-11.21 (macfixes)"
Category: system
Kind: feature
Origin: wine-staging (ported here)
  Version: 24ed50534756
  Patchset: Staging
  Files: patches/Staging/0002-winelib-Append-Staging-at-the-end-of-the-version-s.patch
  Authors: Sebastian Lackner
  URL: https://gitlab.winehq.org/wine/wine-staging/-/blob/24ed50534756/patches/Staging/0002-winelib-Append-Staging-at-the-end-of-the-version-s.patch
  Changes: the label comes from the make variable WINE_VERSION_LABEL
    instead of " (Staging)", and configure is patched too (staging
    regenerates it; we don't run autoreconf). Staging's 0001 (a
    once-per-session "testing version" warning) isn't taken.
Upstream: no
Why: Marks the build as patched, so a log or bug report shows which
 flavour it came from: `wine --version` and the version Wine reports read
 "wine-11.21 (macfixes)". build/compile.sh sets WINE_VERSION_LABEL to
 " (<flavour>)" for flavours that take the version-label set; the rule in
 configure.ac and configure (both patched, so no autoreconf is needed)
 appends it when dlls/ntdll/unix/version.c is generated. Unset, the
 version string is WineHQ's.
Programs: none known
Evidence: Sikarugir 10.0_8: the same mechanism, branded "wine-10.0 (Sikarugir)"
Port: the 11.x form of the same rule.
Status: 2026-11-25: label made a build variable and the warning dropped;
 checked by generating dlls/ntdll/unix/version.c from the patched
 configure's rule with and without WINE_VERSION_LABEL; not yet in a build.

diff --git a/configure b/configure
index e5f72d7..dee0e8d 100755
--- a/configure
+++ b/configure
@@ -23280,7 +23280,7 @@ fi
 
 as_fn_append wine_rules "
 dlls/ntdll/unix/version.c: dummy
-	@version=\`(GIT_DIR=${wine_srcdir}.git git describe HEAD 2>/dev/null || echo \"wine-\$(PACKAGE_VERSION)\") | sed -n -e '\$\$s/\(.*\)/const char wine_build[] = \"\\1\";/p'\` && (echo \$\$version | cmp -s - \$@) || echo \$\$version >\$@ || (rm -f \$@ && exit 1)
+	@version=\`(GIT_DIR=${wine_srcdir}.git git describe HEAD 2>/dev/null || echo \"wine-\$(PACKAGE_VERSION)\") | sed -n -e '\$\$s/\(.*\)/const char wine_build[] = \"\\1\$(WINE_VERSION_LABEL)\";/p'\` && (echo \$\$version | cmp -s - \$@) || echo \$\$version >\$@ || (rm -f \$@ && exit 1)
 programs/winetest/build.rc: dummy
 	@build=\"STRINGTABLE { 1 \\\"\`GIT_DIR=${wine_srcdir}.git git rev-parse HEAD 2>/dev/null\`\\\" }\" && (echo \$\$build | cmp -s - \$@) || echo \$\$build >\$@ || (rm -f \$@ && exit 1)
 dlls/wineandroid.drv/wine-debug.apk: dlls/wineandroid.drv/build.gradle ${wine_srcdir}dlls/wineandroid.drv/AndroidManifest.xml ${wine_srcdir}dlls/wineandroid.drv/WineActivity.java ${wine_srcdir}dlls/wineandroid.drv/wine.svg
diff --git a/configure.ac b/configure.ac
index afcdd85..bd605e0 100644
--- a/configure.ac
+++ b/configure.ac
@@ -3750,7 +3750,7 @@ dnl Rules for generated source files
 
 WINE_APPEND_RULE(
 [dlls/ntdll/unix/version.c: dummy
-	@version=\`(GIT_DIR=${wine_srcdir}.git git describe HEAD 2>/dev/null || echo \"wine-\$(PACKAGE_VERSION)\") | sed -n -e '\$\$s/\(.*\)/const char wine_build[[]] = \"\\1\";/p'\` && (echo \$\$version | cmp -s - \$[@]) || echo \$\$version >\$[@] || (rm -f \$[@] && exit 1)
+	@version=\`(GIT_DIR=${wine_srcdir}.git git describe HEAD 2>/dev/null || echo \"wine-\$(PACKAGE_VERSION)\") | sed -n -e '\$\$s/\(.*\)/const char wine_build[[]] = \"\\1\$(WINE_VERSION_LABEL)\";/p'\` && (echo \$\$version | cmp -s - \$[@]) || echo \$\$version >\$[@] || (rm -f \$[@] && exit 1)
 programs/winetest/build.rc: dummy
 	@build=\"STRINGTABLE { 1 \\\"\`GIT_DIR=${wine_srcdir}.git git rev-parse HEAD 2>/dev/null\`\\\" }\" && (echo \$\$build | cmp -s - \$[@]) || echo \$\$build >\$[@] || (rm -f \$[@] && exit 1)
 dlls/wineandroid.drv/wine-debug.apk: dlls/wineandroid.drv/build.gradle ${wine_srcdir}dlls/wineandroid.drv/AndroidManifest.xml ${wine_srcdir}dlls/wineandroid.drv/WineActivity.java ${wine_srcdir}dlls/wineandroid.drv/wine.svg
