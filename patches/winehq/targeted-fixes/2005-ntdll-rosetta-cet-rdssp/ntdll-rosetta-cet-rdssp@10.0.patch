Summary: Rosetta 2: step over the 0F 1E hint NOPs (CET RDSSP and others) it rejects
Category: cpu
Kind: workaround
Origin: crossover (ported here)
  Version: 25.1.1
  CW-Hacks: 20186
  URL: https://media.codeweavers.com/pub/crossover/source/crossover-sources-25.1.1.tar.gz
  Files: dlls/ntdll/unix/signal_x86_64.c
  Note: Sikarugir 10.0_8 ships it: ntdll.so: "handle_cet_nop", "skipped
    RDSSPD/RDSSPQ instruction"
  Changes: the instruction's length is decoded from its ModRM, SIB and
    displacement (CX steps 3 bytes, mid-instruction for the memory forms),
    and the scan stops at an 0F that isn't followed by 1E
Upstream: no
Why: Opcodes 0F 1E /r are NOPs on CPUs without CET: RDSSPD/RDSSPQ and
 ENDBR32/64 in their register forms, reserved hint NOPs in the others.
 Rosetta 2 raised an invalid-opcode fault for the CET ones on macOS 11
 (CrossOver: fixed in 12), and on macOS 26 still does for the forms
 without an F3 prefix, memory forms included. Step over the instruction
 in the SIGILL path instead of raising EXCEPTION_ILLEGAL_INSTRUCTION. The
 length comes from the ModRM byte: memory forms are 3 to 8 bytes after
 their prefixes (16-bit addressing with 0x67 in 32-bit code included).
 CrossOver's handler stepped 3 bytes for every form, and a memory form
 crashed (c0000005, 10.0 and 11.22 build0, i686 and x86_64).
Programs: none known; code that runs the reserved 0F 1E hint-NOP forms
Seen on: macOS 26.7.2 (M1 Max): 0f 1e c0, 0f 1e 44 00 00 and 66 0f 1e c0
 raise SIGILL (native probe); macOS 11 (CrossOver's comment): RDSSPD/RDSSPQ
Fine on: macOS 26.7.2 (M1 Max): RDSSPD/RDSSPQ and ENDBR32/64 run (native
 probe); macOS 12 (CrossOver's comment: RDSSP fixed in Monterey)
Messages: "skipped RDSSPD/RDSSPQ instruction" (trace:seh; shown only with
 WINEDEBUG=+seh), for every form it steps over
Uncertain: which programs run the non-CET 0F 1E forms (compilers use 0F
 1F for NOPs); which macOS versions between 12 and 26 fault on which
 forms; whether Rosetta raises an invalid opcode for the 16-bit-addressed
 forms (0x67 in 32-bit code), which the handler decodes but no test runs
Status: 10.0: 2026-11-26: instruction length decoded from ModRM, SIB and
 displacement; the scan stops at an 0F not followed by 1E; not yet
 in a build
 10.0: 2026-11-26: quick builds 20261126T013940 and T024442 (macOS 26.7.2,
 M1 Max): smoke and the regression suite passed

diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -1754,7 +1754,92 @@ NTSTATUS WINAPI NtCallbackReturn( void *ret_ptr, ULONG
     user_mode_callback_return( ret_ptr, ret_len, status, NtCurrentTeb() );
 }
 
+#ifdef __APPLE__
+/***********************************************************************
+ *           handle_cet_nop
+ *
+ * Check if the fault location is an Intel CET instruction that should be treated as a NOP.
+ * Rosetta on Big Sur throws an exception for this, but is fixed in Monterey.
+ * CW HACK 20186
+ */
+static inline BOOL handle_cet_nop( ucontext_t *sigcontext, CONTEXT *context )
+{
+    BYTE instr[16];
+    unsigned int i, prefix_count = 0, size, mod, rm;
+    unsigned int len = virtual_uninterrupted_read_memory( (BYTE *)context->Rip, instr, sizeof(instr) );
+    BOOL code32 = cs32_sel && CS_sig(sigcontext) == cs32_sel, addr16 = FALSE;
 
+    for (i = 0; i < len; i++) switch (instr[i])
+    {
+    /* instruction prefixes */
+    case 0x2e:  /* %cs: */
+    case 0x36:  /* %ss: */
+    case 0x3e:  /* %ds: */
+    case 0x26:  /* %es: */
+    case 0x40:  /* rex */
+    case 0x41:  /* rex */
+    case 0x42:  /* rex */
+    case 0x43:  /* rex */
+    case 0x44:  /* rex */
+    case 0x45:  /* rex */
+    case 0x46:  /* rex */
+    case 0x47:  /* rex */
+    case 0x48:  /* rex */
+    case 0x49:  /* rex */
+    case 0x4a:  /* rex */
+    case 0x4b:  /* rex */
+    case 0x4c:  /* rex */
+    case 0x4d:  /* rex */
+    case 0x4e:  /* rex */
+    case 0x4f:  /* rex */
+    case 0x64:  /* %fs: */
+    case 0x65:  /* %gs: */
+    case 0x66:  /* opcode size */
+    case 0x67:  /* addr size */
+        if (instr[i] == 0x67) addr16 = code32;  /* 16-bit addressing in 32-bit code */
+        /* fall through */
+    case 0xf0:  /* lock */
+    case 0xf2:  /* repne */
+    case 0xf3:  /* repe */
+        if (++prefix_count >= 15) return FALSE;
+        continue;
+
+    case 0x0f: /* extended instruction */
+        /* RDSSPD/RDSSPQ: (prefixes) 0F 1E modrm [sib] [displacement]. The
+         * memory forms are hint NOPs too; step over the whole instruction.
+         * (wine-mac-builds: CrossOver stepped 3 bytes, mid-instruction for
+         * those.) */
+        if (i + 2 >= len || instr[i + 1] != 0x1e) return FALSE;
+        mod = instr[i + 2] >> 6;
+        rm = instr[i + 2] & 7;
+        size = 3;
+        if (mod != 3 && addr16)
+        {
+            if (mod == 1) size += 1;
+            else if (mod == 2 || (mod == 0 && rm == 6)) size += 2;
+        }
+        else if (mod != 3)
+        {
+            if (rm == 4)  /* SIB byte */
+            {
+                if (i + 3 >= len) return FALSE;
+                size += 1;
+                if (mod == 0 && (instr[i + 3] & 7) == 5) size += 4;
+            }
+            if (mod == 1) size += 1;
+            else if (mod == 2 || (mod == 0 && rm == 5)) size += 4;
+        }
+        if (i + size > len) return FALSE;
+        RIP_sig(sigcontext) += prefix_count + size;
+        TRACE_(seh)( "skipped RDSSPD/RDSSPQ instruction\n" );
+        return TRUE;
+    default:
+        return FALSE;
+    }
+    return FALSE;
+}
+#endif
+
 /***********************************************************************
  *           is_privileged_instr
  *
@@ -2002,6 +2087,10 @@ static void segv_handler( int signal, siginfo_t *sigin
         rec.ExceptionCode = EXCEPTION_ARRAY_BOUNDS_EXCEEDED;
         break;
     case TRAP_x86_PRIVINFLT:   /* Invalid opcode exception */
+#ifdef __APPLE__
+        /* CW HACK 20186 */
+        if (handle_cet_nop( ucontext, &context.c )) return;
+#endif
         rec.ExceptionCode = EXCEPTION_ILLEGAL_INSTRUCTION;
         break;
     case TRAP_x86_STKFLT:  /* Stack fault */
