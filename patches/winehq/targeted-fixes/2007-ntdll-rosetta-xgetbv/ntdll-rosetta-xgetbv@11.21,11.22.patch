SPDX-License-Identifier: LGPL-2.1-or-later
Summary: Rosetta 2: emulate XGETBV, which it rejects
Category: cpu
Kind: workaround
Origin: crossover (ported here)
  Version: 26.3.0
  CW-Hacks: 23427
  URL: https://media.codeweavers.com/pub/crossover/source/crossover-sources-26.3.0.tar.gz
  Files: dlls/ntdll/unix/signal_x86_64.c
  Changes: emulate_xgetbv() and the macOS 15 check as CX's, but returning
    0x07 on macOS 15 and later and 0x03 before, instead of 0xe7 and 0x07;
    the call in segv_handler passes sigcontext and goes through
    leave_handler(), as WineHQ 11.x's segv_handler requires
Origin: other
  Name: dblark/macos-wine-build
  Version: 3d842d1
  URL: https://github.com/dblark/macos-wine-build/commit/3d842d14ad68ac1594939354fbc90ece25db96ae
  Note: the same code, in patches/0002-macos-hacks.patch
Upstream: no
Why: Rosetta raises #UD for XGETBV before macOS 26 (macOS 26's Rosetta runs it itself and returns 0x07); emulate it for XCR0: 0x07 (x87, SSE, AVX) on macOS 15 and later, 0x03 (x87, SSE) before, where Rosetta has no AVX. CrossOver returns 0xe7 and 0x07: 0xe7 claims AVX-512 state, which no Rosetta has, and 0x07 claims AVX state before macOS 15.
Programs: none known
Evidence: Sikarugir 10.0_8: ntdll.so: "emulate_xgetbv", "emulated an XGETBV instruction"; disassembly matches (0f 01 d0 check, ecx==0, cmov between 0xe7 and 0x07, rip += 3)
Expects before it: ntdll-rosetta-cet-rdssp, ntdll-rosetta-mxcsr; context only
Status: 11.21: 2026-11-26: XCR0 0x07 on macOS 15+, 0x03 before (was 0xe7, 0x07); not yet in a build
 11.22: 2026-11-26: XCR0 0x07 on macOS 15+, 0x03 before (was 0xe7, 0x07); not yet in a build

diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index eed47c9..02860fe 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -93,6 +93,9 @@ WINE_DECLARE_DEBUG_CHANNEL(seh);
 /* CW Hack 24256 */
 #include <sys/sysctl.h>
 static BOOL is_rosetta2;
+
+/* CW Hack 23427 */
+static BOOL sequoia_or_later = FALSE;
 #endif
 
 static USHORT cs32_sel;  /* selector for %cs in 32-bit mode */
@@ -1857,6 +1860,41 @@ static inline BOOL handle_cet_nop( ucontext_t *sigcontext, CONTEXT *context )
     }
     return FALSE;
 }
+
+/***********************************************************************
+ *           emulate_xgetbv
+ *
+ * Check if the fault location is an Intel XGETBV instruction for xcr0 and
+ * emulate it if so. Actual Intel hardware supports this instruction, so this
+ * will only take effect under Rosetta.
+ * CW HACK 23427
+ */
+static inline BOOL emulate_xgetbv( ucontext_t *sigcontext, CONTEXT *context )
+{
+    BYTE instr[3];
+    unsigned int len = virtual_uninterrupted_read_memory( (BYTE *)context->Rip, instr, sizeof(instr) );
+
+    /* Prefixed xgetbv is illegal, so no need to check. */
+    if (len < 3 || instr[0] != 0x0f || instr[1] != 0x01 || instr[2] != 0xd0 ||
+        (RCX_sig(sigcontext) & 0xffffffff) != 0 /* only handling xcr0 (ecx==0) */)
+    {
+        return FALSE;
+    }
+
+    RDX_sig(sigcontext) = 0;
+    if (sequoia_or_later)
+    {
+        /* Arguably we should only claim AVX support if ROSETTA_ADVERTISE_AVX is
+           set, but presumably apps will also check cpuid. No Rosetta has AVX-512. */
+        RAX_sig(sigcontext) = 0x07;  /* x87, sse, avx: what macOS 26's Rosetta returns */
+    }
+    else
+        RAX_sig(sigcontext) = 0x03;  /* x87, sse: no AVX in Rosetta before macOS 15 */
+
+    RIP_sig(sigcontext) += 3;
+    TRACE_(seh)( "emulated an XGETBV instruction\n" );
+    return TRUE;
+}
 #endif
 
 /***********************************************************************
@@ -2350,6 +2388,12 @@ static void segv_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
             leave_handler( data, sigcontext );
             return;
         }
+        /* CW HACK 23427 */
+        if (emulate_xgetbv( sigcontext, &context.c ))
+        {
+            leave_handler( data, sigcontext );
+            return;
+        }
 #endif
         rec.ExceptionCode = EXCEPTION_ILLEGAL_INSTRUCTION;
         break;
@@ -2933,6 +2977,10 @@ void signal_init_process( TEB *teb )
         else
             is_rosetta2 = ret;
     }
+
+    /* CW Hack 23427: __builtin_available presumably isn't signal-safe. */
+    if (__builtin_available( macOS 15.0, * ))
+        sequoia_or_later = TRUE;
 #endif
 
     sig_act.sa_mask = server_block_set;
