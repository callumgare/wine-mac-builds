Summary: Rosetta 2: keep the program's MXCSR across exceptions and raw syscalls (M3)
Category: cpu
Kind: workaround
Origin: crossover (ported here)
  Version: 26.3.0
  CW-Hacks: 24256, 24265
  URL: https://media.codeweavers.com/pub/crossover/source/crossover-sources-26.3.0.tar.gz
  Files: dlls/ntdll/unix/signal_x86_64.c
  Note: Sikarugir 10.0_8 ships it: ntdll.so exports ___restore_mxcsr_thunk;
    has "sysctl.proc_translated"
  Changes: 24256 (is_rosetta2, stmxcsr in save_context, the sysctl in
    signal_init_process) is CX's code at 11.21's places. 24265's thunk
    loads the value from the syscall frame (frame->xsave.MxCsr,
    0xd8(%rcx); %rcx is the frame when sigsys_handler resumes at
    __wine_syscall_dispatcher_prolog_end), and the dispatcher overwrites
    that field with the live MXCSR right after. CX's thunk reads the TEB
    from %gs:0x30 and keeps the value in amd64_thread_data()->mxcsr
    (0x33c): in Wine 11 that slot is upstream's Unix-side MXCSR (saved
    at thread start, loaded on every syscall entry), so CX's copy leaves
    Unix code running with the program's MXCSR, and after a signal
    handler on macOS %gs is the pthread TSD, not the TEB. No
    amd64_thread_data mxcsr field is added
Upstream: no
Why: On some Apple chips (M3 per CrossOver; M1 and M2 are fine) Rosetta 2
 puts a stale MXCSR in signal contexts and ignores changes to it, while
 the live register is right. Exception contexts then carry the wrong
 MXCSR, which NtContinue restores, and a raw syscall returns with it.
 Under Rosetta, read the live register in save_context() and in the
 syscall SIGSYS handler, and for raw syscalls restore it through a thunk
 on the way into the dispatcher.
Programs: none known; programs that set MXCSR (rounding, FTZ/DAZ,
 exception masks) and then take a handled exception or make a raw
 syscall, on an M3
Seen on: M3 (CrossOver's comments on CW HACK 24265)
Fine on: macOS 26.7.2 (M1 Max): signal contexts carry the live MXCSR and
 changes to them are honoured (native probe); M2 (tests/regress/README.md)
Uncertain: everything about the M3 behaviour comes from CrossOver's
 comments; not reproduced here (no M3) and not checked on macOS 26 on an
 M3, so neither copy's thunk has been seen to act
No test: needs an M3: on M1 and M2 Rosetta's signal contexts carry the
 right MXCSR, so a test passes either way
Status: 11.21: 2026-11-26: quick builds 20261126T005336 and T023339 (macOS 26.7.2,
 M1 Max): smoke and the regression suite passed
 11.22: 2026-11-26: quick builds 20261126T002454 and T025644 (macOS 26.7.2,
 M1 Max): smoke and the regression suite passed

diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index 774a142..eed47c9 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -89,6 +89,12 @@ WINE_DECLARE_DEBUG_CHANNEL(seh);
 
 #include "dwarf.h"
 
+#ifdef __APPLE__
+/* CW Hack 24256 */
+#include <sys/sysctl.h>
+static BOOL is_rosetta2;
+#endif
+
 static USHORT cs32_sel;  /* selector for %cs in 32-bit mode */
 static USHORT cs64_sel;  /* selector for %cs in 64-bit mode */
 static USHORT ds64_sel;  /* selector for %ds/%es/%ss in 64-bit mode */
@@ -854,6 +860,13 @@ static void save_context( struct thread_data *data, struct xcontext *xcontext,
 
         context->ContextFlags |= CONTEXT_FLOATING_POINT;
         memcpy( &context->FltSave, FPU_sig(sigcontext), sizeof(context->FltSave) );
+#ifdef __APPLE__
+        /* CW Hack 24256: mxcsr in signal contexts is incorrect in Rosetta.
+           In Rosetta only, the actual value of the register from within the
+           handler is correct (on Intel it has some default value). */
+        if (is_rosetta2)
+            __asm__ volatile( "stmxcsr %0" : "=m" (context->FltSave.MxCsr) );
+#endif
         context->MxCsr = context->FltSave.MxCsr;
         if (xstate_extended_features && (xs = XState_sig(FPU_sig(sigcontext))))
         {
@@ -2656,6 +2669,14 @@ static void usr1_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
 
 
 #if defined(__APPLE__) || defined(__linux__)
+#ifdef __APPLE__
+/* CW Hack 24265 */
+extern void __restore_mxcsr_thunk(void);
+__ASM_GLOBAL_FUNC( __restore_mxcsr_thunk,
+                   "ldmxcsr 0xd8(%rcx)\n\t"  /* frame->xsave.MxCsr */
+                   "jmp " __ASM_LOCAL_LABEL("__wine_syscall_dispatcher_prolog_end") );
+#endif
+
 /**********************************************************************
  *		sigsys_handler
  *
@@ -2693,6 +2714,30 @@ static void sigsys_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
         frame->restore_flags |= CONTEXT_CONTROL;
     }
     RIP_sig(sigcontext) = (ULONG64)__wine_syscall_dispatcher_prolog_end_ptr;
+
+#ifdef __APPLE__
+    /* CW Hack 24265 */
+    if (is_rosetta2 && FPU_sig(sigcontext))
+    {
+        XMM_SAVE_AREA32 fpu;
+        unsigned int direct_mxcsr;
+        __asm__ volatile( "stmxcsr %0" : "=m" (direct_mxcsr) );
+        memcpy( &fpu, FPU_sig(sigcontext), sizeof(fpu) );
+
+        if (direct_mxcsr != fpu.MxCsr)
+        {
+            fpu.MxCsr = direct_mxcsr;
+            memcpy( FPU_sig(sigcontext), &fpu, sizeof(fpu) );
+
+            /* On the M3, Rosetta will restore mxcsr to the initial, incorrect
+               value from the sigcontext, even if we change it. So we jump to a
+               thunk that restores the value from the syscall frame (%rcx), which
+               the dispatcher overwrites with the live value right after. */
+            frame->xsave.MxCsr = direct_mxcsr;
+            RIP_sig(sigcontext) = (ULONG64)__restore_mxcsr_thunk;
+        }
+    }
+#endif
 }
 #endif
 
@@ -2877,6 +2922,19 @@ void signal_init_process( TEB *teb )
     alloc_syscall_frame( (frame_size + 63) & ~63 );
     signal_alloc_thread( teb );
 
+#ifdef __APPLE__
+    /* CW Hack 24256: We need the value of sysctl.proc_translated in signal
+       handlers but sysctl[byname] is not signal-safe. */
+    {
+        int ret = 0;
+        size_t size = sizeof(ret);
+        if (sysctlbyname( "sysctl.proc_translated", &ret, &size, NULL, 0 ) == -1)
+            is_rosetta2 = 0;
+        else
+            is_rosetta2 = ret;
+    }
+#endif
+
     sig_act.sa_mask = server_block_set;
     sig_act.sa_flags = SA_SIGINFO | SA_RESTART | SA_ONSTACK;
 
