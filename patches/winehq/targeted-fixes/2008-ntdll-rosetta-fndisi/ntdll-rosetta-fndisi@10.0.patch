Summary: Rosetta 2: skip the obsolete x87 FNDISI instruction (WineHQ bug 56441)
Category: cpu
Kind: workaround
Origin: other
  Name: WineHQ bug 56441 attachment
  Authors: Brendan Shanks
  URL: https://bugs.winehq.org/show_bug.cgi?id=56441
  Note: "Patch to ignore FNDISI" (attachment 76358); also shipped by Gcenx
    (winehq-9.8 packages) and dblark/macos-wine-build
Origin: other
  Name: dblark/macos-wine-build
  Version: 3d842d1
  URL: https://github.com/dblark/macos-wine-build/commit/3d842d14ad68ac1594939354fbc90ece25db96ae
  Note: patches/0002-macos-hacks.patch (handle_fndisi)
  Changes: comment fixed (dblark's says "RDSSPD/RDSSPQ"); the scan stops at a DB
    that isn't followed by E1, where dblark's scanned on into the opcode
Upstream: no (bug 56441 closed NOTOURBUG: Apple fixed Rosetta in macOS 15)
Why: Rosetta raises #UD for the obsolete x87 FNDISI (DB E1), which real CPUs treat as a NOP; skip it. Checked after the CET handler and before XGETBV, as in 10.0_8. (Comment fixed: dblark's copy said "RDSSPD/RDSSPQ".)
Programs: DSDPlus 1.101 (32-bit): "Unhandled illegal instruction" at
 start on macOS 14 (WineHQ bug 56441)
Evidence: Sikarugir 10.0_8: ntdll.so: "handle_fndisi", "skipped FNDISI instruction"; segv_handler checks DB E1 between the CET and XGETBV checks
Expects before it: ntdll-rosetta-cet-rdssp, ntdll-rosetta-xgetbv; context only
Status: 10.0: 2026-11-26: the scan stops at a DB not followed by E1 (it scanned on into the instruction); not yet in a build

diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -1862,6 +1862,63 @@ static inline BOOL handle_cet_nop( ucontext_t *sigcont
 }
 
 /***********************************************************************
+ *           handle_fndisi
+ *
+ * Check if the fault location is an x87 FNDISI instruction that should be treated as a NOP.
+ * Rosetta raises an invalid-opcode fault for it (WineHQ bug 56441).
+ */
+static inline BOOL handle_fndisi( ucontext_t *sigcontext, CONTEXT *context )
+{
+    BYTE instr[16];
+    unsigned int i, prefix_count = 0;
+    unsigned int len = virtual_uninterrupted_read_memory( (BYTE *)context->Rip, instr, sizeof(instr) );
+
+    for (i = 0; i < len; i++) switch (instr[i])
+    {
+    /* instruction prefixes */
+    case 0x2e:  /* %cs: */
+    case 0x36:  /* %ss: */
+    case 0x3e:  /* %ds: */
+    case 0x26:  /* %es: */
+    case 0x40:  /* rex */
+    case 0x41:  /* rex */
+    case 0x42:  /* rex */
+    case 0x43:  /* rex */
+    case 0x44:  /* rex */
+    case 0x45:  /* rex */
+    case 0x46:  /* rex */
+    case 0x47:  /* rex */
+    case 0x48:  /* rex */
+    case 0x49:  /* rex */
+    case 0x4a:  /* rex */
+    case 0x4b:  /* rex */
+    case 0x4c:  /* rex */
+    case 0x4d:  /* rex */
+    case 0x4e:  /* rex */
+    case 0x4f:  /* rex */
+    case 0x64:  /* %fs: */
+    case 0x65:  /* %gs: */
+    case 0x66:  /* opcode size */
+    case 0x67:  /* addr size */
+    case 0xf0:  /* lock */
+    case 0xf2:  /* repne */
+    case 0xf3:  /* repe */
+        if (++prefix_count >= 15) return FALSE;
+        continue;
+
+    case 0xdb:
+        /* FNDISI: (prefixes) DB E1. Anything else is another instruction. */
+        if (i == len - 1 || instr[i + 1] != 0xe1) return FALSE;
+        RIP_sig(sigcontext) += prefix_count + 2;
+        TRACE_(seh)( "skipped FNDISI instruction\n" );
+        return TRUE;
+    default:
+        return FALSE;
+    }
+    return FALSE;
+}
+
+/***********************************************************************
  *           emulate_xgetbv
  *
  * Check if the fault location is an Intel XGETBV instruction for xcr0 and
@@ -2147,6 +2204,8 @@ static void segv_handler( int signal, siginfo_t *sigin
 #ifdef __APPLE__
         /* CW HACK 20186 */
         if (handle_cet_nop( ucontext, &context.c )) return;
+        /* WineHQ bug 56441 */
+        if (handle_fndisi( ucontext, &context.c )) return;
         /* CW HACK 23427 */
         if (emulate_xgetbv( ucontext, &context.c )) return;
 #endif
