diff --git a/dlls/winemac.drv/cocoa_opengl.m b/dlls/winemac.drv/cocoa_opengl.m
index 5488840..5bb2850 100644
--- a/dlls/winemac.drv/cocoa_opengl.m
+++ b/dlls/winemac.drv/cocoa_opengl.m
@@ -26,6 +26,16 @@
 #include "cocoa_app.h"
 #include "cocoa_event.h"
 
+#include <pthread.h>
+
+/* Held while a context's view, latent view and update flags change. The
+ * GL threads change them in macdrv_make_context_current() and
+ * macdrv_update_opengl_context(), and the main thread in the content view's
+ * viewWillDraw. Without it both could swap the same view at once and release
+ * it twice. A GL thread can hold it while it waits for the main thread, so
+ * the main thread only ever tries to take it. */
+static pthread_mutex_t context_mutex = PTHREAD_RECURSIVE_MUTEX_INITIALIZER;
+
 #pragma GCC diagnostic ignored "-Wdeclaration-after-statement"
 
 
@@ -218,7 +228,9 @@ void macdrv_dispose_opengl_context(WineOpenGLContext *context)
 {
 @autoreleasepool
 {
+    pthread_mutex_lock(&context_mutex);
     [context removeFromViews:YES];
+    pthread_mutex_unlock(&context_mutex);
     [context release];
 }
 }
@@ -230,6 +242,7 @@ void macdrv_make_context_current(WineOpenGLContext *context, WineContentView *vi
 {
 @autoreleasepool
 {
+    pthread_mutex_lock(&context_mutex);
     if (context && view)
     {
         if (view == (WineContentView *)[context view] || view == (WineContentView *)[context latentView])
@@ -278,6 +291,7 @@ void macdrv_make_context_current(WineOpenGLContext *context, WineContentView *vi
         if (context)
             [context removeFromViews:YES];
     }
+    pthread_mutex_unlock(&context_mutex);
 }
 }
 
@@ -288,6 +302,7 @@ void macdrv_update_opengl_context(WineOpenGLContext *context)
 {
 @autoreleasepool
 {
+    pthread_mutex_lock(&context_mutex);
     if (context.needsUpdate)
     {
         BOOL reattach = context.needsReattach;
@@ -321,7 +336,23 @@ void macdrv_update_opengl_context(WineOpenGLContext *context)
             [context resetSurfaceIfBackingSizeChanged];
         }
     }
+    pthread_mutex_unlock(&context_mutex);
+}
 }
+
+/***********************************************************************
+ *              macdrv_try_update_opengl_context
+ *
+ * For the main thread: updates the context unless a GL thread is changing
+ * it, and returns whether it did.
+ */
+int macdrv_try_update_opengl_context(WineOpenGLContext *context)
+{
+    if (pthread_mutex_trylock(&context_mutex)) return 0;
+    context.needsUpdate = TRUE;
+    macdrv_update_opengl_context(context);
+    pthread_mutex_unlock(&context_mutex);
+    return 1;
 }
 
 /***********************************************************************
diff --git a/dlls/winemac.drv/cocoa_window.m b/dlls/winemac.drv/cocoa_window.m
index 38b12b0..9042a24 100644
--- a/dlls/winemac.drv/cocoa_window.m
+++ b/dlls/winemac.drv/cocoa_window.m
@@ -466,13 +466,20 @@ - (void) viewWillDraw
     {
         [super viewWillDraw];
 
-        for (WineOpenGLContext* context in pendingGlContexts)
+        for (WineOpenGLContext* context in [[pendingGlContexts copy] autorelease])
         {
-            context.needsUpdate = TRUE;
-            macdrv_update_opengl_context(context);
+            /* A GL thread is changing it; leave it pending for the next draw. */
+            if (!macdrv_try_update_opengl_context(context))
+                continue;
+            [glContexts addObject:context];
+            [pendingGlContexts removeObjectIdenticalTo:context];
+        }
+        if ([pendingGlContexts count])
+        {
+            dispatch_async(dispatch_get_main_queue(), ^{
+                [self setNeedsDisplay:YES];
+            });
         }
-        [glContexts addObjectsFromArray:pendingGlContexts];
-        [pendingGlContexts removeAllObjects];
     }
 
     - (void) addGLContext:(WineOpenGLContext*)context
